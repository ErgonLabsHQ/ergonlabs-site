---
// Founders page, in the same studio style as the homepage: centred hero, a "How we work" card with an isometric
// flow drawing, then one section per founder (portrait, bio, highlights, expertise chips, links).
import Home from '../layouts/Home.astro';
import Nav from '../components/home/Nav.astro';
import Footer from '../components/home/Footer.astro';
import FlowScene from '../components/home/FlowScene.astro';
import { brand, founders } from '../nuvareth';
import '../styles/founders.css';
---

<Home title={`Founders — ${brand.name}`} description="Meet the founders of Ergon Labs, an AI engineering firm.">
  <Nav current="/founders" />

  <main>
    <section class="hero fd-hero">
      <div class="stars" aria-hidden="true" data-stars></div>
      <div class="wrap hero-copy">
        <h1>
          {['The', 'engineers', 'behind', ...brand.name.split(' ')].map((w, i, a) => (
            <span class="wd" style={`--w:${i + 1}`}>{i === a.length - 1 ? `${w}.` : w}</span>
          ))}
        </h1>
        <p class="lede rise" style="--w:7">
          {brand.name} was founded by two engineers who bring lead engineering experience across US and European
          companies and a record of published AI research. When you work with us, you work with them directly, from the
          first call to production.
        </p>
        <nav class="fd-jump rise" style="--w:8" aria-label="Founders">
          {founders.map((f) => (
            <a class="btn btn-dark" href={`#${f.id}`}>{f.name} <span class="arr" aria-hidden="true">↓</span></a>
          ))}
        </nav>
      </div>
    </section>

    <section class="sec alt">
      <div class="wrap">
        <div class="head">
          <h2 data-split>Engineering and AI research, one team.</h2>
          <p class="lede" data-r>Both founders work on your project together, from the first call to production.</p>
        </div>
        <div class="card fd-flow" data-r>
          <FlowScene />
        </div>
      </div>
    </section>

    {founders.map((f, i) => (
      <section class:list={['sec', { alt: i % 2 === 1 }]} id={f.id}>
        <div class:list={['wrap', 'fd', { flip: i % 2 === 1 }]}>
          <figure class="fd-photo" data-r>
            <div class="fd-frame">
              <img src={f.photo} alt={f.alt} width="800" height="800" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              <span class="hd h-tl" aria-hidden="true"></span>
              <span class="hd h-tr" aria-hidden="true"></span>
              <span class="hd h-bl" aria-hidden="true"></span>
              <span class="hd h-br" aria-hidden="true"></span>
            </div>
            <figcaption>
              <span>{f.name}</span>
              <span>{f.role.split(' · ')[1]}</span>
            </figcaption>
          </figure>
          <div class="fd-body">
            <p class="chip" data-r>{f.role}</p>
            <h2 data-split>{f.name}</h2>
            <p class="fd-lead" data-r>{f.lead}</p>
            <div class="fd-bio" data-r>
              {f.bio.map((p) => <p>{p}</p>)}
            </div>
            <ul class="fd-hl" data-r>
              {f.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <ul class="chips" aria-label="Areas of expertise" data-r>
              {f.stack.map((s) => <li>{s}</li>)}
            </ul>
            <p class="fd-links" data-r>
              {f.links.map((l) => (
                <a class="btn btn-dark btn-sm" href={l.href} target="_blank" rel="noopener">{l.label} <span class="ext" aria-hidden="true">↗</span></a>
              ))}
            </p>
          </div>
        </div>
      </section>
    ))}
  </main>

  <Footer />
</Home>
