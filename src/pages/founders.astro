---
// Founders page, in the same studio style as the homepage: split hero (as on the homepage), then one section per founder
// (portrait, bio, highlights, expertise chips, links).
import Home from '../layouts/Home.astro';
import Nav from '../components/home/Nav.astro';
import Footer from '../components/home/Footer.astro';
import Btn from '../components/home/Btn.astro';
import { brand, founders } from '../nuvareth';
import '../styles/founders.css';
---

<Home title={`Founders — ${brand.name}`} description="Meet the founders of Ergon Labs, an AI engineering firm.">
  <Nav current="/founders" />

  <main>
    <section class="hero fd-hero">
      <div class="wrap hero-copy">
        <div class="hero-main rise" style="--w:0">
          <h1>The founders behind {brand.name}.</h1>
        </div>
        <div class="hero-side rise" style="--w:1">
        <p class="lede">
          {brand.name} was founded by two engineers who bring lead engineering experience across US and European
          companies and a record of published AI research.
        </p>
        <nav class="fd-jump" aria-label="Founders">
          {founders.map((f) => (
            <Btn href={`#${f.id}`} label={f.name} variant="secondary" arrow="↓" />
          ))}
        </nav>
        </div>
      </div>
    </section>

    {founders.map((f, i) => (
      <section class:list={['sec', { alt: i % 2 === 0, last: i === founders.length - 1 }]} id={f.id}>
        <div class:list={['wrap', 'fd', { flip: i % 2 === 1 }]}>
          <figure class="fd-photo" data-r>
            <div class="fd-frame">
              <img src={f.photo} alt={f.alt} width="800" height="800" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              <span class="hd h-tl" aria-hidden="true"></span>
              <span class="hd h-tr" aria-hidden="true"></span>
              <span class="hd h-bl" aria-hidden="true"></span>
              <span class="hd h-br" aria-hidden="true"></span>
            </div>
            <figcaption>
              <span>{f.name}</span>
              <span>{f.role.split(' · ')[1]}</span>
            </figcaption>
          </figure>
          <div class="fd-body">
            <p class="chip" data-r>{f.role}</p>
            <h2 data-split>{f.name}</h2>
            <p class="fd-lead" data-r>{f.lead}</p>
            <div class="fd-bio" data-r>
              {f.bio.map((p) => <p>{p}</p>)}
            </div>
            <ul class="fd-hl" data-r>
              {f.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <ul class="chips" aria-label="Areas of expertise" data-r>
              {f.stack.map((s) => <li>{s}</li>)}
            </ul>
            <p class="fd-links" data-r>
              {f.links.map((l) => (
                <Btn href={l.href} label={l.label} variant="secondary" size="sm" arrow="↗" target="_blank" rel="noopener" />
              ))}
            </p>
          </div>
        </div>
      </section>
    ))}
  </main>

  <Footer />
</Home>
