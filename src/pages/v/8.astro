    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .v8 .contact input[type='text'],
  .v8 .contact input[type='email'],
  .v8 .contact textarea {
    width: 100%;
    font: 500 17px/1.4 'Instrument Sans', sans-serif;
    color: var(--k);
    background: #fbf6ea;
    border: 2px solid var(--k);
    border-radius: 0;
    padding: 12px 13px;
  }
  .v8 .contact textarea {
    resize: vertical;
  }
  .v8 .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .v8 .chips label {
    position: relative;
    cursor: pointer;
  }
  .v8 .chips input {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .v8 .contact .chips label > span {
    display: block;
    margin: 0;
    padding: 10px 12px;
    border: 2px solid var(--k);
    font: 700 12px/1 var(--mono);
    letter-spacing: 0.03em;
    text-transform: none;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .v8 .chips input:checked + span {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--paper);
  }
  .v8 .chips input:focus-visible + span {
    outline: 3px solid var(--coral);
    outline-offset: 2px;
  }
  .v8 .contact .btn {
    justify-self: start;
    font-size: 14px;
    padding: 16px 24px;
  }

  /* ---------- footer ---------- */
  .v8 .foot {
    padding: 50px 0 96px;
    overflow: hidden;
    border-top: 1.5px solid var(--rule);
  }
  .v8 .mega {
    font: 400 clamp(60px, 15.6vw, 280px) / 0.9 var(--disp);
    text-transform: uppercase;
    white-space: nowrap;
    text-align: center;
    margin-bottom: 40px;
    --o: 0.06;
  }
  .v8 .foot .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 40px;
    font: 400 12.5px/1.6 var(--mono);
    color: var(--dim);
  }
  .v8 .foot strong {
    color: var(--paper);
    margin-right: 12px;
  }
  .v8 .foot nav,
  .v8 .foot .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  .v8 .foot a:hover {
    color: var(--coral);
  }

  /* ---------- smaller screens ---------- */
  @media (max-width: 1100px) {
    .v8 .cards {
      grid-template-columns: 1fr 1fr;
    }
    .v8 .top nav {
      gap: 16px;
    }
  }
  @media (max-width: 899px) {
    .v8 {
      font-size: 16.5px;
    }
    .v8 .top nav {
      display: none;
    }
    .v8 .crops {
      inset: 70px 4px 4px;
    }
    .v8 .crops b {
      display: none;
    }
    .v8 .crops i {
      width: 14px;
      height: 14px;
      background-position:
        0 4px,
        4px 0;
    }
    .v8 .sheet {
      min-height: max(100svh, 760px);
    }
    .v8mo .v8 .sheet {
      min-height: 0;
    }
    .v8 .art {
      right: auto;
      left: 50%;
      top: 76px;
      width: min(82vw, 38vh);
      transform: translateX(-50%);
    }
    .v8 .copy {
      top: auto;
      bottom: 104px;
      left: 20px;
      right: 20px;
      width: auto;
      transform: none;
    }
    .v8 .h1 {
      font-size: clamp(38px, min(11.4vw, 6.4vh), 60px);
      margin: 12px 0 14px;
    }
    .v8 .h1 .c {
      transform: translate(calc(var(--o) * 9vw - 3px), calc(var(--o) * 4vh + 3px)) rotate(calc(var(--o) * 5deg));
    }
    .v8 .h1 .b {
      transform: translate(calc(var(--o) * -3vw + 3px), calc(var(--o) * -7vh - 2px)) rotate(calc(var(--o) * -4deg));
    }
    .v8 .sub {
      margin-bottom: 18px;
      font-size: 16px;
    }
    .v8 .copy .lab {
      font-size: 10.5px;
    }
    .v8 .actions {
      gap: 12px;
    }
    .v8 .actions .btn {
      padding: 13px 14px;
      font-size: 12px;
    }
    .v8 .readout {
      left: 20px;
      right: 20px;
      bottom: 66px;
      gap: 12px;
      font-size: 10px;
    }
    .v8 .readout span:last-child {
      display: none;
    }
    .v8 .stamp {
      left: -2%;
      bottom: 4%;
    }
    .v8 .bigword {
      font-size: 30vh;
      top: 30%;
    }
    .v8 .spread {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 18px;
      padding: 84px 20px 76px;
    }
    .v8 .bigword.two {
      font-size: 13vh;
      bottom: 8vh;
    }
    .v8 .head.with-art {
      grid-template-columns: 1fr;
    }
    .v8 .head.with-art .reg {
      justify-self: end;
      margin-top: -40px;
    }
    .v8 .pt,
    .v8 .pair,
    .v8 .wrap.two {
      grid-template-columns: 1fr;
    }
    .v8 .pt.flip .say {
      order: 0;
    }
    .v8 .rules .side {
      position: static;
    }
    .v8 .reg.catart {
      max-width: 300px;
    }
    .v8 .card ul {
      grid-template-columns: 1fr;
    }
    .v8 .demo {
      font-size: 13.5px;
      box-shadow: 6px 6px 0 var(--blue);
    }
    .v8 .demo.alt {
      box-shadow: 6px 6px 0 var(--coral);
    }
    .v8 .demo .body {
      padding: 14px;
    }
    .v8 .route {
      grid-template-columns: 9.2em 1fr 2.6em;
      font-size: 12.5px;
    }
    .v8 .evals .grid {
      gap: 4px;
    }
    .v8 .weeks .wk {
      grid-template-columns: 1fr 1fr;
    }
    .v8mo .v8 .pp {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      padding-top: 84px;
      padding-bottom: 64px;
    }
    .v8mo .v8 .pl h2 {
      font-size: clamp(30px, 8.6vw, 44px);
      max-width: none;
      margin-top: 12px;
    }
    .v8mo .v8 .names {
      display: flex;
      gap: 14px;
      margin-top: 12px;
      font-size: 25px;
    }
    .v8mo .v8 .names li.on {
      translate: 0 -3px;
    }
    .v8mo .v8 .ps {
      width: calc(100% - 14px);
      padding: 18px 18px 20px;
    }
    .v8mo .v8 .ps h3 {
      font-size: clamp(64px, min(21vw, 11vh), 96px);
      margin: 10px 0 8px;
    }
    .v8 .faq details p {
      padding-right: 10px;
    }
  }
  @media (max-width: 620px) {
    .v8 .cards {
      grid-template-columns: 1fr;
    }
    .v8 .cards .for {
      min-height: 0;
    }
    .v8 .logo {
      font-size: 20px;
    }
    .v8 .btn.small {
      padding: 10px 11px;
      font-size: 11px;
    }
    .v8 .meters {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v8 .crops i,
    .v8 .crops b,
    .v8 .crops b::after {
      animation: none;
    }
    .v8 .fly {
      display: none;
    }
    .v8 * {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const motion = root.classList.contains('v8mo');
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const ease = (v: number) => v * v * (3 - 2 * v);
  const $ = <T extends HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s);
  const $$ = <T extends HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];

  // =====================================================================================
  // Scroll story
  // =====================================================================================
  const hero = $('[data-hero]')!;
  const sheet = $('[data-sheet]')!;
  const heroArt = $('[data-heroart] .reg')!;
  const h1 = $('[data-h1]')!;
  const bigword = $('[data-bigword]')!;
  const bigword2 = $('[data-bigword2]')!;
  const dots = $('[data-dots]')!;
  const dots2 = $('[data-dots2]')!;
  const dots3 = $('[data-dots3]')!;
  const spread = $('[data-spread]')!;
  const spCopy = $('.sp-copy', spread)!;
  const spArt = $('.sp-art .reg', spread)!;
  const rc = $('[data-rc]')!;
  const rb = $('[data-rb]')!;
  const rs = $('[data-rs]')!;
  const band = $('[data-band]')!;
  const rows = $$('[data-row]', band);
  const proc = $('[data-proc]')!;
  const sheets = $$('.ps', proc);
  const names = $$('.names li', proc);
  const regs = $$('[data-reg]').filter((el) => el !== heroArt && el !== spArt);
  const shifts = $$('[data-shift]');
  const rest = [
    { r: -3, x: -16, y: -8 },
    { r: 2.4, x: 10, y: 6 },
    { r: -1.5, x: -6, y: 14 },
    { r: 3, x: 14, y: -4 },
  ];
  const signed = (v: number) => (v >= 0 ? '+' : '-') + Math.abs(v).toFixed(1);

  const frame = () => {
    const vh = window.innerHeight;
    const vw = window.innerWidth;

    // ---- opening: converge, lock, pull the sheet, show the next spread
    const total = hero.offsetHeight - vh;
    const p = total > 0 ? clamp(-hero.getBoundingClientRect().top / total) : 0;
    if (p < 1 || sheet.dataset.done !== '1') {
      const o = 1 - ease(clamp(p / 0.34));
      heroArt.style.setProperty('--o', o.toFixed(4));
      h1.style.setProperty('--o', o.toFixed(4));
      rc.textContent = signed(o * 38);
      rb.textContent = signed(o * -24);
      const locked = o < 0.004;
      sheet.classList.toggle('locked', locked);
      rs.textContent = locked ? 'In register. Sheet coming off the press.' : 'Out of register. Scroll to pull the plates together.';
      bigword.style.transform = `translateX(${8 - p * 150}vw)`;
      dots.style.scale = String(0.55 + p * 1.9);
      dots2.style.scale = String(1.5 - p * 1.6);

      const pull = ease(clamp((p - 0.5) / 0.22));
      sheet.style.transform = pull > 0 ? `translate(${-pull * 22}%, ${-pull * 118}%) rotate(${-pull * 9}deg)` : '';
      sheet.style.visibility = pull >= 1 ? 'hidden' : '';

      const s = clamp((p - 0.5) / 0.4);
      const se = ease(s);
      spCopy.style.transform = `translateY(${(1 - se) * 60}px)`;
      spArt.style.setProperty('--o', (0.6 * (1 - ease(clamp((p - 0.56) / 0.3)))).toFixed(4));
      bigword2.style.transform = `translateX(${40 - clamp((p - 0.45) / 0.55) * 150}vw)`;
      dots3.style.scale = String(0.5 + s * 1.1);
      sheet.dataset.done = p >= 1 ? '1' : '0';
    }

    // ---- travelling type
    const br = band.getBoundingClientRect();
    if (br.bottom > -200 && br.top < vh + 200) {
      const k = (vh - br.top) / (vh + br.height);
      rows.forEach((row) => {
        const dir = Number(row.dataset.row);
        row.style.transform = `translateX(${dir * (k - 0.5) * 60 - 12}vw)`;
      });
    }

    // ---- prints and headings come into register as they rise into view
    for (const el of regs) {
      const r = el.getBoundingClientRect();
      if (r.bottom < -100 || r.top > vh + 100) continue;
      const k = ease(clamp((vh - r.top) / (vh * 0.62)));
      el.style.setProperty('--o', ((1 - k) * Number(el.dataset.reg || 0.3)).toFixed(4));
    }
    for (const el of shifts) {
      const r = el.getBoundingClientRect();
      if (r.bottom < -100 || r.top > vh + 100) continue;
      const k = ease(clamp((vh - r.top) / (vh * 0.32)));
      el.style.setProperty('--o', (1 - k).toFixed(4));
    }

    // ---- process: each sheet is dropped on the stack and its title takes ink
    const pt = proc.offsetHeight - vh;
    const q = pt > 0 ? clamp(-proc.getBoundingClientRect().top / pt) : 0;
    const u = q * 3.75;
    const ks = sheets.map((_, i) => (i === 0 ? 1 : ease(clamp((u - (i - 0.8)) / 0.6))));
    let active = 0;
    const narrow = vw < 900;
    sheets.forEach((el, i) => {
      const k = ks[i];
      if (k > 0.6) active = i;
      let d = 0;
      for (let j = i + 1; j < ks.length; j++) d += ks[j];
      const m = rest[i];
      const sx = narrow ? 0.4 : 1;
      el.style.transform =
        `translate(calc(-50% + ${(1 - k) * 80}vw + ${(m.x - d * 12) * sx}px), calc(-50% + ${(1 - k) * 46}vh + ${(m.y - d * 10) * sx}px)) ` +
        `rotate(${m.r + (1 - k) * 22}deg) scale(${1 + (1 - k) * 0.25})`;
      el.style.visibility = k <= 0 ? 'hidden' : '';
      const f = i === 0 ? clamp(0.25 + u / 0.3) : clamp((u - (i - 0.5)) / 0.5);
      el.style.setProperty('--f', f.toFixed(3));
    });
    names.forEach((n, i) => n.classList.toggle('on', i === active));
  };

  if (motion) {
    let ticking = false;
    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        frame();
      });
    };
    frame();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    window.addEventListener('load', request);
  }

  // =====================================================================================
  // Services index
  // =====================================================================================
  const index = $('[data-index]')!;
  const items = $$(':scope > li', index);
  const openItem = (li: HTMLElement) => {
    items.forEach((it) => {
      const on = it === li;
      it.classList.toggle('open', on);
      $('button', it)!.setAttribute('aria-expanded', String(on));
    });
  };
  const wide = matchMedia('(min-width: 900px)');
  const fitIndex = () => {
    // on wide screens the open card sits beside the list, so the list must be at least as tall as the card
    const card = $('li.open .det', index);
    index.style.minHeight = wide.matches && card ? `${card.offsetHeight + 40}px` : '';
    if (!card) return;
    // keep the card level with the line it belongs to
    const li = card.parentElement!;
    const top = Math.max(26, Math.min(li.offsetTop - 30, index.offsetHeight - card.offsetHeight - 12));
    card.style.top = wide.matches ? `${top}px` : '';
  };
  items.forEach((li) => {
    const btn = $('button', li)!;
    btn.addEventListener('click', () => {
      if (!wide.matches && li.classList.contains('open')) {
        li.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        return;
      }
      openItem(li);
      fitIndex();
    });
    btn.addEventListener('pointerenter', (e) => {
      if (wide.matches && e.pointerType === 'mouse' && !li.classList.contains('open')) {
        openItem(li);
        fitIndex();
      }
    });
  });
  fitIndex();
  window.addEventListener('resize', fitIndex);

  // =====================================================================================
  // Demos: every element with data-t switches on at that many milliseconds
  // =====================================================================================
  const fmt = (v: number, el: HTMLElement) => {
    const dec = Number(el.dataset.dec || 0);
    let s = v.toFixed(dec);
    if (el.dataset.sep) s = Number(s).toLocaleString('en-GB');
    return s + (el.dataset.suffix || '');
  };
  const countUp = (el: HTMLElement) => {
    const end = Number(el.dataset.count);
    const t0 = performance.now();
    const step = (now: number) => {
      const k = clamp((now - t0) / 900);
      el.textContent = fmt(end * (1 - Math.pow(1 - k, 3)), el);
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  $$('[data-demo]').forEach((demo) => {
    const parts = $$('[data-t]', demo);
    const typed = $$('[data-type]', demo).map((el) => ({ el, text: el.textContent || '' }));
    let timers: number[] = [];
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      demo.classList.add('play');
      parts.forEach((el) => {
        el.classList.remove('on', 'on2');
        $$('[data-count]', el).forEach((c) => (c.textContent = fmt(0, c)));
        later(() => {
          el.classList.add('on');
          $$('[data-count]', el).forEach(countUp);
          typed
            .filter((t) => el.contains(t.el))
            .forEach((t) => {
              t.el.textContent = '';
              [...t.text].forEach((_, i) => later(() => (t.el.textContent = t.text.slice(0, i + 1)), i * 26));
            });
        }, Number(el.dataset.t));
        if (el.dataset.t2) later(() => el.classList.add('on2'), Number(el.dataset.t2));
      });
    };
    $('[data-replay]', demo)!.addEventListener('click', play);
    if (motion) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            play();
          }
        },
        { threshold: 0.3 },
      );
      io.observe(demo);
    }
  });

  // =====================================================================================
  // Small reveals: cards stamp in, rule lines take ink
  // =====================================================================================
  if (motion) {
    const cards = $('[data-cards]')!;
    cards.classList.add('wait');
    const once = (el: Element, fn: () => void, threshold = 0.2) => {
      const io = new IntersectionObserver(
        (es) => {
          if (es.some((e) => e.isIntersecting)) {
            io.disconnect();
            fn();
          }
        },
        { threshold },
      );
      io.observe(el);
    };
    once(cards, () => {
      cards.classList.remove('wait');
      cards.classList.add('in');
    }, 0.12);
    $$('[data-rules] li').forEach((li) => once(li, () => li.classList.add('in'), 0.4));
  }

  // =====================================================================================
  // Contact form: builds a mailto link, nothing is sent anywhere else
  // =====================================================================================
  const form = $<HTMLFormElement>('[data-form]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const picked = data.getAll('topic').join(', ');
    const body = [`Name: ${data.get('name')}`, `Email: ${data.get('email')}`, picked ? `About: ${picked}` : '', '', String(data.get('message') || '')]
      .filter((l, i) => l !== '' || i === 3)
      .join('\n');
    const subject = `Project enquiry${picked ? ': ' + picked : ''}`;
    window.location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  // =====================================================================================
  // Flyers: printed paper planes that steer down the margins and loose sheets that flutter.
  // Fast scrolling throws all of them.
  // =====================================================================================
  const sky = $<HTMLCanvasElement>('[data-fly]')!;
  if (motion) {
    const ctx = sky.getContext('2d')!;
    let sw = 0;
    let sh = 0;
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      sw = window.innerWidth;
      sh = window.innerHeight;
      sky.width = sw * dpr;
      sky.height = sh * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    size();
    window.addEventListener('resize', size);

    // each plane sprite is printed from its two plates, a little out of register
    const load = (src: string) =>
      new Promise<HTMLImageElement>((res, rej) => {
        const im = new Image();
        im.onload = () => res(im);
        im.onerror = rej;
        im.src = src;
      });
    const sprite = async (name: string) => {
      const [c, b] = await Promise.all([load(`/art/v8/${name}-c.webp`), load(`/art/v8/${name}-b.webp`)]);
      const cv = document.createElement('canvas');
      cv.width = c.width;
      cv.height = c.height;
      const x = cv.getContext('2d')!;
      x.drawImage(c, -3, 2);
      x.globalCompositeOperation = 'multiply';
      x.drawImage(b, 3, -2);
      return cv;
    };
    const sprites: HTMLCanvasElement[] = [];
    Promise.all([sprite('plane'), sprite('plane2')])
      .then((s) => sprites.push(...s))
      .catch(() => {});

    const small = () => sw < 900;
    const planes = [0, 1, 2].map((i) => ({
      x: i % 2 ? sw + 60 : -60,
      y: sh * (0.25 + 0.25 * i),
      heading: i % 2 ? Math.PI : 0,
      speed: 1.5 + i * 0.3,
      side: i % 2,
      phase: i * 2.3,
      size: 78 + i * 16,
      spr: i % 2,
    }));
    const inks = ['#f2ead8', '#ff5a4f', '#2f5cff', '#f2ead8', '#ff5a4f', '#2f5cff', '#f2ead8'];
    const leaves = inks.map((col, i) => ({
      col,
      side: i % 2,
      x: 0,
      y: Math.random() * 900,
      vy: 0.25 + Math.random() * 0.45,
      rot: Math.random() * 6,
      vr: (Math.random() - 0.5) * 0.02,
      ph: Math.random() * 6,
      w: 26 + Math.random() * 16,
      kick: 0,
    }));

    let lastY = window.scrollY;
    let shove = 0;
    const tick = (now: number) => {
      const t = now / 1000;
      const sv = window.scrollY - lastY;
      lastY = window.scrollY;
      shove += (clamp(sv, -120, 120) - shove) * 0.2;
      ctx.clearRect(0, 0, sw, sh);
      const narrow = small();
      const margin = Math.max(54, (sw - 1228) / 2);
      ctx.globalAlpha = narrow ? 0.4 : 1;

      // loose sheets
      leaves.forEach((l, i) => {
        if (narrow && i > 2) return;
        const home = l.side ? sw - margin * 0.5 : margin * 0.5;
        l.kick += (shove * (0.5 + (i % 3) * 0.35) - l.kick) * 0.12;
        l.y += l.vy - l.kick * 0.55;
        l.rot += l.vr + l.kick * 0.006 * (l.side ? 1 : -1);
        if (l.y > sh + 60) l.y = -50;
        if (l.y < -60) l.y = sh + 50;
        const sway = Math.sin(t * 0.8 + l.ph) * margin * 0.32 + Math.sin(t * 0.31 + l.ph * 2) * margin * 0.1;
        l.x = home + sway + l.kick * (l.side ? -1.4 : 1.4);
        const flip = Math.cos(t * 1.4 + l.ph + l.kick * 0.05);
        ctx.save();
        ctx.translate(l.x, l.y);
        ctx.rotate(l.rot + Math.sin(t * 0.9 + l.ph) * 0.35);
        ctx.scale(1, 0.25 + Math.abs(flip) * 0.75);
        const w = l.w;
        const h = w * 1.38;
        ctx.fillStyle = flip > 0 ? l.col : l.col === '#f2ead8' ? '#d9cfb8' : l.col;
        ctx.fillRect(-w / 2, -h / 2, w, h);
        if (flip > 0) {
          // a little printing on the face of the sheet
          ctx.fillStyle = l.col === '#2f5cff' ? '#f2ead8' : '#2f5cff';
          ctx.fillRect(-w / 2 + 4, -h / 2 + 5, w * 0.5, 3);
          ctx.fillStyle = l.col === '#ff5a4f' ? '#151311' : '#ff5a4f';
          ctx.beginPath();
          ctx.arc(w * 0.12, h * 0.12, w * 0.2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      });

      // planes
      planes.forEach((pl, i) => {
        if (narrow && i > 1) return;
        const spr = sprites[pl.spr];
        const homeX = pl.side ? sw - margin / 2 : margin / 2;
        const tx = homeX + Math.sin(t * 0.7 + pl.phase) * Math.min(60, margin * 0.3);
        const ty = sh * (0.5 + 0.42 * Math.sin(t * 0.33 + pl.phase * 2.1));
        let diff = Math.atan2(ty - pl.y, tx - pl.x) - pl.heading;
        while (diff > Math.PI) diff -= Math.PI * 2;
        while (diff < -Math.PI) diff += Math.PI * 2;
        pl.heading += clamp(diff, -0.035, 0.035) + shove * 0.004 * (pl.side ? 1 : -1);
        const v = pl.speed + Math.abs(shove) * 0.06;
        pl.x += Math.cos(pl.heading) * v;
        pl.y += Math.sin(pl.heading) * v - shove * 0.5;
        if (pl.y < -120) pl.y = sh + 100;
        if (pl.y > sh + 120) pl.y = -100;
        if (!spr) return;
        const s = narrow ? pl.size * 0.62 : pl.size;
        ctx.save();
        ctx.translate(pl.x, pl.y);
        ctx.rotate(pl.heading);
        ctx.scale(1, (Math.cos(pl.heading) < 0 ? -1 : 1) * (1 + Math.sin(t * 2 + pl.phase) * 0.1));
        ctx.drawImage(spr, -s / 2, -s / 2, s, s);
        ctx.restore();
      });
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
