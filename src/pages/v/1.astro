---
// Variation 1, "Assemble": near-black, one sans typeface, hairline grid, and a particle field
// that keeps rearranging itself from a loose cloud into ordered structures around the headline.
import Variant from '../../layouts/Variant.astro';
import VariantSections from '../../components/VariantSections.astro';
import VariantLog from '../../components/VariantLog.astro';
import { site } from '../../site';
const fonts = 'https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400;500&display=swap';
---

<Variant n={1} fonts={fonts}>
  <header class="top">
    <a class="logo" href="/v/1"><i></i>{site.name}</a>
    <nav>
      <a href="#services">Services</a>
      <a href="#work">How we work</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="pill" href="#contact">Start a project</a>
  </header>

  <main class="frame">
    <section class="hero">
      <canvas data-particles aria-hidden="true"></canvas>
      <div class="center">
        <p class="eyebrow">{site.tagline} · {site.location}</p>
        <h1>We build software that keeps working after launch.</h1>
        <p class="sub">
          A small studio of senior engineers and AI specialists, with more than ten years of production software behind
          us.
        </p>
        <div class="actions">
          <a class="pill" href="#contact">Start a project</a>
          <a class="pill ghost" href="#services">See what we do</a>
        </div>
      </div>
      <p class="state" aria-hidden="true"><span data-state-n hidden>01</span><span data-state>a loose idea</span></p>
    </section>

    <section class="work" id="work">
      <div class="copy">
        <p class="v-label">AI work</p>
        <h2>The demo is the easy part. We do the other 90%.</h2>
        <p>
          Getting a model to look clever in a meeting takes an afternoon. Getting it to be right on a Tuesday, when the
          input is a crooked scan and the API is slow, is ordinary engineering.
        </p>
      </div>
      <VariantLog />
    </section>

    <VariantSections />
  </main>
</Variant>

<style is:global>
  .v1 {
    --bg: #09090a;
    --fg: #f4f4f5;
    --muted: #8d8d96;
    --line: rgba(255, 255, 255, 0.09);
    background: var(--bg);
    color: var(--fg);
    font-family: 'Geist', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.5;
  }
  .v1 h1,
  .v1 h2,
  .v1 h3 {
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .v1 .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 max(20px, calc((100vw - 1240px) / 2 + 24px));
    background: rgba(9, 9, 10, 0.7);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .v1 .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .v1 .logo i {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, #8d8d96 70%);
  }
  .v1 .top nav {
    display: flex;
    gap: 28px;
    color: var(--muted);
    font-size: 15px;
  }
  .v1 .top nav a:hover {
    color: var(--fg);
  }
  .v1 .pill {
    display: inline-flex;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-weight: 500;
    font-size: 15px;
    border: 1px solid var(--fg);
    transition: opacity 0.2s, background 0.2s;
  }
  .v1 .pill:hover {
    opacity: 0.85;
  }
  .v1 .pill.ghost {
    background: transparent;
    color: var(--fg);
    border-color: rgba(255, 255, 255, 0.25);
  }
  /* the page sits in a column drawn with hairlines, with small crosses where lines meet */
  .v1 .frame {
    max-width: 1240px;
    margin: 0 auto;
    border-inline: 1px solid var(--line);
  }
  .v1 .frame > section {
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .v1 .frame > section::before,
  .v1 .frame > section::after {
    content: '+';
    position: absolute;
    bottom: -11px;
    font: 300 18px/20px 'Geist Mono', monospace;
    color: rgba(255, 255, 255, 0.4);
    z-index: 2;
  }
  .v1 .frame > section::before {
    left: -6px;
  }
  .v1 .frame > section::after {
    right: -6px;
  }
  .v1 .hero {
    height: 100svh;
    min-height: 620px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .v1 .hero canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .v1 .center {
    position: relative;
    text-align: center;
    padding: 40px 24px 0;
    max-width: 780px;
  }
  .v1 .eyebrow,
  .v1 .v-label {
    font: 400 12.5px/1 'Geist Mono', monospace;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .v1 h1 {
    font-size: clamp(40px, 6vw, 82px);
    margin: 22px 0 22px;
  }
  .v1 .sub {
    color: var(--muted);
    max-width: 46ch;
    margin: 0 auto 30px;
    font-size: clamp(16.5px, 1.4vw, 19px);
  }
  .v1 .actions {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .v1 .state {
    position: absolute;
    left: 24px;
    bottom: 22px;
    font: 400 12px/1 'Geist Mono', monospace;
    color: var(--muted);
  }
  .v1 .state span:first-child {
    color: var(--fg);
  }
  .v1 .work {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
    padding: clamp(60px, 8vw, 120px) clamp(20px, 4vw, 56px);
  }
  .v1 .work h2 {
    font-size: clamp(32px, 4vw, 56px);
    margin: 18px 0 20px;
  }
  .v1 .work .copy p:last-child {
    color: var(--muted);
    max-width: 44ch;
  }
  .v1 .v-log {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
    padding: 6px 20px 18px;
    font: 400 13.5px/1.5 'Geist Mono', monospace;
  }
  .v1 .v-log-head {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    margin-bottom: 8px;
    font-size: 12px;
  }
  .v1 .v-line {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 10px;
    padding: 5px 0;
  }
  .v1 .v-k {
    color: var(--muted);
  }
  .v1 .v-line em {
    font-style: normal;
    color: #9be7b0;
  }
  .v1 .v-line.warn {
    color: #ffd27a;
  }
  .v1 .v-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .v1 .v-facts div {
    padding: 34px clamp(18px, 2.4vw, 32px) 38px;
  }
  .v1 .v-facts div + div {
    border-left: 1px solid var(--line);
  }
  .v1 .v-facts b {
    display: block;
    font-weight: 500;
    font-size: clamp(30px, 3.4vw, 46px);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 12px;
  }
  .v1 .v-facts span {
    color: var(--muted);
    font-size: 15px;
  }
  .v1 .v-services header {
    padding: clamp(60px, 8vw, 110px) clamp(20px, 4vw, 56px) clamp(32px, 4vw, 56px);
  }
  .v1 .v-services h2 {
    font-size: clamp(32px, 4.4vw, 60px);
    margin-top: 18px;
    max-width: 18ch;
  }
  .v1 .v-services ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .v1 .v-services li {
    padding: 26px clamp(18px, 2.4vw, 32px) 34px;
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
    transition: background 0.25s;
  }
  .v1 .v-services li:nth-child(3n) {
    border-right: 0;
  }
  .v1 .v-services li:nth-last-child(-n + 3) {
    border-bottom: 0;
  }
  .v1 .v-services li:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  .v1 .v-num {
    font: 400 12px/1 'Geist Mono', monospace;
    color: var(--muted);
  }
  .v1 .v-services h3 {
    font-size: 23px;
    letter-spacing: -0.03em;
    margin: 26px 0 8px;
  }
  .v1 .v-services li p {
    color: var(--muted);
    font-size: 15.5px;
  }
  .v1 .v-cta {
    text-align: center;
    padding: clamp(80px, 11vw, 170px) 24px clamp(110px, 13vw, 190px);
  }
  .v1 .v-cta h2 {
    font-size: clamp(36px, 5.4vw, 76px);
    max-width: 14ch;
    margin: 0 auto 32px;
  }
  .v1 .v-btn {
    display: inline-flex;
    padding: 14px 26px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-weight: 500;
  }
  @media (max-width: 1270px) {
    /* the crosses sit just outside the column, so they go when the column fills the screen */
    .v1 .frame > section::before,
    .v1 .frame > section::after {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .v1 .top nav {
      display: none;
    }
    .v1 .work {
      grid-template-columns: 1fr;
    }
    .v1 .v-facts {
      grid-template-columns: 1fr 1fr;
    }
    .v1 .v-facts div:nth-child(3) {
      border-left: 0;
    }
    .v1 .v-facts div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .v1 .v-services ul {
      grid-template-columns: 1fr;
    }
    .v1 .v-services li,
    .v1 .v-services li:nth-last-child(-n + 3) {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>

<script>
  // Particles are pulled toward a set of target points. Every few seconds the targets change:
  // a loose cloud, then rings, then a grid. The middle is kept clear for the headline.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-particles]')!;
  const ctx = canvas.getContext('2d')!;
  const label = document.querySelector('[data-state]')!;
  const labelN = document.querySelector('[data-state-n]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let w = 0;
  let h = 0;
  let dpr = 1;
  const mouse = { x: -9999, y: -9999 };
  type P = { x: number; y: number; vx: number; vy: number; tx: number; ty: number; s: number };
  let ps: P[] = [];

  const clearCentre = (x: number, y: number): [number, number] => {
    const cx = w / 2;
    const cy = h / 2 + 10;
    const rx = Math.min(w * 0.36, 460);
    const ry = Math.min(h * 0.3, 250);
    const dx = (x - cx) / rx;
    const dy = (y - cy) / ry;
    const d = Math.hypot(dx, dy);
    if (d >= 1 || d === 0) return [x, y];
    return [cx + (dx / d) * rx, cy + (dy / d) * ry];
  };

  const shapes: [string, (i: number, n: number) => [number, number]][] = [
    [
      'a loose idea',
      () => {
        const a = Math.random() * Math.PI * 2;
        const r = 0.35 + Math.random() * 0.75;
        return [w / 2 + Math.cos(a) * r * w * 0.5, h / 2 + Math.sin(a) * r * h * 0.52];
      },
    ],
    [
      'a system design',
      (i, n) => {
        const ring = i % 3;
        const a = (i / n) * Math.PI * 2 * 3 + ring;
        const r = [0.62, 0.82, 1.02][ring];
        return [w / 2 + Math.cos(a) * r * Math.min(w * 0.46, 620), h / 2 + 10 + Math.sin(a) * r * Math.min(h * 0.44, 380)];
      },
    ],
    [
      'running in production',
      (i, n) => {
        const cols = Math.ceil(Math.sqrt((n * w) / h));
        const gap = w / cols;
        return [(i % cols) * gap + gap / 2, Math.floor(i / cols) * gap + gap / 2];
      },
    ],
  ];
  let shape = 0;

  const retarget = () => {
    const [name, fn] = shapes[shape];
    label.textContent = name;
    labelN.textContent = String(shape + 1).padStart(2, '0');
    ps.forEach((p, i) => {
      const [x, y] = fn(i, ps.length);
      [p.tx, p.ty] = shape === 2 ? [x, y] : clearCentre(x, y);
    });
  };

  const resize = () => {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = canvas.clientWidth;
    h = canvas.clientHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = w < 700 ? 520 : 1500;
    ps = Array.from({ length: n }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      vx: 0,
      vy: 0,
      tx: 0,
      ty: 0,
      s: 0.6 + Math.random() * 1.1,
    }));
    retarget();
  };

  const tick = (now: number) => {
    ctx.clearRect(0, 0, w, h);
    const t = now / 1000;
    const cx = w / 2;
    const cy = h / 2 + 10;
    for (const p of ps) {
      // gentle drift so a finished shape never sits completely still
      const wob = Math.sin(t * 0.7 + p.tx * 0.013) * 5;
      p.vx += (p.tx - p.x + wob) * 0.006;
      p.vy += (p.ty - p.y + Math.cos(t * 0.6 + p.ty * 0.011) * 5) * 0.006;
      const dx = p.x - mouse.x;
      const dy = p.y - mouse.y;
      const d2 = dx * dx + dy * dy;
      if (d2 < 16000) {
        const f = (1 - d2 / 16000) * 1.4;
        const d = Math.sqrt(d2) || 1;
        p.vx += (dx / d) * f;
        p.vy += (dy / d) * f;
      }
      p.vx *= 0.9;
      p.vy *= 0.9;
      p.x += p.vx;
      p.y += p.vy;
      // dimmer behind the text block, brighter toward the edges
      const fade = Math.min(1, Math.hypot((p.x - cx) / (w * 0.42), (p.y - cy) / (h * 0.42)));
      ctx.fillStyle = `rgba(255,255,255,${0.12 + fade * 0.6})`;
      ctx.fillRect(p.x, p.y, p.s, p.s);
    }
    if (!reduced) requestAnimationFrame(tick);
  };

  resize();
  window.addEventListener('resize', resize);
  canvas.parentElement!.addEventListener('pointermove', (e) => {
    const r = canvas.getBoundingClientRect();
    mouse.x = e.clientX - r.left;
    mouse.y = e.clientY - r.top;
  });
  canvas.parentElement!.addEventListener('pointerleave', () => {
    mouse.x = mouse.y = -9999;
  });
  if (reduced) {
    shape = 1;
    retarget();
    ps.forEach((p) => {
      p.x = p.tx;
      p.y = p.ty;
    });
    tick(0);
  } else {
    setInterval(() => {
      shape = (shape + 1) % shapes.length;
      retarget();
    }, 5200);
    requestAnimationFrame(tick);
  }
</script>
