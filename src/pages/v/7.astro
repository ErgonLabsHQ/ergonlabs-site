</style>

<script>
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const ease = (v: number) => {
    const c = clamp(v);
    return c * c * (3 - 2 * c);
  };
  const mix = (a: number, b: number, k: number) => a + (b - a) * k;
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
  const ART = '/art/v7';

  // a leaf or a flower that sits on a stem
  const sprig = (kind: 'leaf' | 'bloom-a' | 'bloom-b', w: number, angle: number) => {
    const el = document.createElement('span');
    el.className = kind === 'leaf' ? 'lf' : 'lf fl';
    el.style.setProperty('--w', `${w}px`);
    el.style.setProperty('--a', `${angle}deg`);
    el.style.setProperty('--d', `${-rnd(0, 3.5).toFixed(2)}s`);
    const img = document.createElement('img');
    img.src = `${ART}/${kind}.webp`;
    img.alt = '';
    img.decoding = 'async';
    if (kind !== 'leaf') el.dataset.flower = '';
    el.append(img);
    return el;
  };

  // =====================================================================================
  // The pinned opening. Scroll progress p runs 0..1 and every prop reads its pose from it:
  // packet and bare soil, the packet tips and the bed is marked out (Scope), seedlings come
  // up and get watered (Prove), a vine climbs the trellis (Build), the greenhouse arrives and
  // everything flowers (Run).
  // =====================================================================================
  const scene = $('[data-grow]');
  const pin = $('[data-pin]');
  const lead = $('[data-lead]');
  const steps = $('[data-steps]');
  const stepEls = $$('[data-step]');
  const rail = $$('[data-rail]');
  const cue = $('[data-cue]');
  const hill = $('[data-hill]');
  const house = $('[data-house]');
  const climb = $('[data-climb]');
  const foliage = $('[data-foliage]');
  const hvines = $$<SVGPathElement>('[data-hvine]');
  const pots = $('[data-pots]');
  const can = $('[data-can]');
  const packet = $('[data-packet]');
  const packetEnd = $('[data-packet-end]');
  const seeds = $$('[data-seeds] i');
  const twine = $<SVGPathElement>('[data-twine]');

  const hLen = hvines[0].getTotalLength();
  hvines.forEach((v) => {
    v.style.strokeDasharray = `${hLen}`;
    v.style.strokeDashoffset = `${hLen}`;
  });
  const tLen = twine.getTotalLength();

  // leaves and flowers along the trellis vine, placed in the SVG's own 200 x 620 box
  type Sprig = { el: HTMLElement; f: number };
  const hLeaves: Sprig[] = [];
  const hBlooms: Sprig[] = [];
  {
    const n = 19;
    for (let i = 0; i < n; i++) {
      const f = 0.05 + (i / n) * 0.93;
      const a = hvines[0].getPointAtLength(f * hLen);
      const b = hvines[0].getPointAtLength(Math.min(hLen, f * hLen + 4));
      const dir = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI + 90;
      const el = sprig('leaf', 1, dir + (i % 2 ? 62 : -62) + rnd(-12, 12));
      el.style.setProperty('--w', `calc(var(--u) * ${(5.2 + (i % 3) * 1.1).toFixed(1)})`);
      el.style.left = `${(a.x / 200) * 100}%`;
      el.style.top = `${(a.y / 620) * 100}%`;
      foliage.append(el);
      hLeaves.push({ el, f });
    }
    [0.2, 0.36, 0.5, 0.63, 0.78, 0.9, 1].forEach((f, i) => {
      const a = hvines[0].getPointAtLength(f * hLen);
      const el = sprig(i % 2 ? 'bloom-b' : 'bloom-a', 1, rnd(-20, 20));
      el.style.setProperty('--w', `calc(var(--u) * ${(7.5 + (i % 3) * 1.6).toFixed(1)})`);
      el.style.left = `${(a.x / 200) * 100 + (i % 2 ? 5 : -5)}%`;
      el.style.top = `${(a.y / 620) * 100}%`;
      foliage.append(el);
      hBlooms.push({ el, f: i / 7 });
    });
  }

  let packetTo = { x: 0, y: 0 };
  const measure = () => {
    packet.style.transform = '';
    const a = packet.getBoundingClientRect();
    const b = packetEnd.getBoundingClientRect();
    packetTo = { x: b.left - (a.left + a.width / 2), y: b.top - (a.top + a.height / 2) };
  };

  const windows = [
    [0.13, 0.345],
    [0.355, 0.545],
    [0.555, 0.775],
    [0.785, 2],
  ];
  let p = 0;
  const onGrow = () => {
    const total = scene.offsetHeight - window.innerHeight;
    p = total > 0 ? clamp(-scene.getBoundingClientRect().top / total) : 0;
    const vh = window.innerHeight / 100;
    const narrow = window.innerWidth < 860;

    const out = ease((p - 0.05) / 0.08);
    lead.style.opacity = String(1 - out);
    lead.style.transform = narrow ? `translateY(${-out * 30}px)` : `translateY(calc(-50% - ${out * 40}px))`;
    lead.style.pointerEvents = out > 0.5 ? 'none' : '';
    cue.style.opacity = p > 0.015 ? '0' : '1';

    // the valley rises into view behind the bed as the garden gets going
    hill.style.transform = `translateY(${(1 - ease((p - 0.1) / 0.45)) * 62 * vh}px)`;

    // Scope: the packet tips over the bed, seeds fall, the plot is marked out with twine
    const kp = ease((p - 0.09) / 0.12);
    const gone = ease((p - 0.33) / 0.05);
    packet.style.transform = `translate(${packetTo.x * kp}px, ${packetTo.y * kp}px) rotate(${mix(-7, -128, kp)}deg) scale(${mix(1, narrow ? 0.62 : 0.5, kp)})`;
    packet.style.opacity = String(1 - gone);
    seeds.forEach((s, i) => {
      const k = clamp((p - 0.185 - i * 0.012) / 0.07);
      s.style.transform = `translate(${(i - 2.5) * (narrow ? 15 : 34) + Math.sin(i * 2.3) * 8}px, ${mix(-9 * vh, 7 * vh, k * k)}px) rotate(${i * 50 + k * 200}deg)`;
      s.style.opacity = String(k > 0 && k < 1 ? Math.min(1, k * 6) * Math.min(1, (1 - k) * 5) : 0);
    });
    twine.style.strokeDasharray = `${tLen}`;
    twine.style.strokeDashoffset = `${tLen * (1 - ease((p - 0.2) / 0.11))}`;
    (twine.parentElement as unknown as HTMLElement).style.opacity = String(ease((p - 0.16) / 0.04));

    // Prove: seedlings come up through the soil and get watered
    const kq = ease((p - 0.35) / 0.1);
    pots.style.transform = `translateY(${(1 - kq) * 105}%)`;
    const cin = ease((p - 0.38) / 0.06);
    const cout = ease((p - 0.515) / 0.045);
    can.style.opacity = String(cin * (1 - cout));
    can.style.transform = `translate(${(1 - cin) * 26 * vh + cout * 20 * vh}px, ${(1 - cin) * -8 * vh}px) rotate(${-26 * cin * (1 - cout)}deg)`;
    can.classList.toggle('pour', cin > 0.9 && cout < 0.1 && !reduced);

    // Build: the trellis goes up and the vine climbs it
    const kt = ease((p - 0.54) / 0.06);
    climb.style.opacity = String(kt);
    climb.style.transform = `translateY(${(1 - kt) * 9 * vh}px)`;
    const kv = clamp((p - 0.585) / 0.21);
    hvines.forEach((v) => (v.style.strokeDashoffset = `${hLen * (1 - kv)}`));
    hLeaves.forEach((l) => l.el.classList.toggle('open', kv > l.f));

    // Run: the greenhouse, and everything in flower
    const kh = ease((p - 0.775) / 0.1);
    house.style.opacity = String(kh);
    house.style.transform = `translateY(${(1 - kh) * 7 * vh}px) scale(${mix(0.84, 1, kh)})`;
    const kb = clamp((p - 0.84) / 0.12);
    hBlooms.forEach((b) => b.el.classList.toggle('open', kb > b.f * 0.9 + 0.02));
    const inView = p < 1 || scene.getBoundingClientRect().bottom > 0;
    foliage.classList.toggle('live', inView);
    [...hLeaves, ...hBlooms].forEach((l) => l.el.classList.toggle('near', inView));

    // the four steps
    steps.style.opacity = String(ease((p - 0.115) / 0.03));
    let now = -1;
    stepEls.forEach((el, i) => {
      const [a, b] = windows[i];
      const k = ease((p - a) / 0.028) * (1 - ease((p - b + 0.028) / 0.028));
      el.style.opacity = String(k);
      el.style.transform = `translateY(${(p < (a + b) / 2 ? 1 - k : k - 1) * 26}px) rotate(${(1 - k) * (i % 2 ? 1.5 : -1.5)}deg)`;
      el.style.visibility = k < 0.01 ? 'hidden' : 'visible';
      if (p >= a - 0.01) now = i;
    });
    rail.forEach((r, i) => {
      r.classList.toggle('now', i === now);
      r.classList.toggle('done', i < now);
    });
  };

  pin.addEventListener('pointermove', (e) => {
    if (reduced || e.pointerType !== 'mouse') return;
    pin.style.setProperty('--mx', ((e.clientX / window.innerWidth) * 2 - 1).toFixed(3));
  });

  // =====================================================================================
  // The vine in the page margin. It is rebuilt whenever the page changes height, drawn as
  // far as the visitor has scrolled, and puts out a leaf every hundred pixels or so and a
  // flower where each section starts.
  // =====================================================================================
  const page = $('[data-page]');
  const vine = $('[data-vine]');
  const vsvg = $<SVGSVGElement>('svg', vine);
  const vpaths = $$<SVGPathElement>('path', vine);
  let vLeaves: { el: HTMLElement; y: number }[] = [];
  let vTable: { y: number; len: number }[] = [];
  let vLen = 0;

  const buildVine = () => {
    const H = page.offsetHeight;
    const margin = (page.clientWidth - 1180) / 2;
    const wide = margin > 110;
    const cx = wide ? margin - 84 : window.innerWidth < 860 ? 12 : 22;
    const amp = wide ? 24 : 5;
    const xAt = (y: number) => cx + Math.sin(y / 170) * amp + Math.sin(y / 61 + 1) * amp * 0.22;

    vLeaves.forEach((l) => l.el.remove());
    vLeaves = [];
    vTable = [];
    let d = '';
    let len = 0;
    let px = xAt(0);
    for (let y = 0; y <= H - 40; y += 16) {
      const x = xAt(y);
      d += `${y ? 'L' : 'M'}${x.toFixed(1)} ${y}`;
      if (y) len += Math.hypot(x - px, 16);
      px = x;
      vTable.push({ y, len });
    }
    vLen = len;
    vsvg.setAttribute('viewBox', `0 0 140 ${H}`);
    vsvg.setAttribute('preserveAspectRatio', 'xMinYMin slice');
    vsvg.style.height = `${H}px`;
    vpaths.forEach((pth) => {
      pth.setAttribute('d', d);
      pth.style.strokeDasharray = `${len}`;
    });

    let i = 0;
    let seed = 7;
    const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    for (let y = 70; y < H - 80; y += wide ? 92 + rand() * 70 : 120 + rand() * 80) {
      const slope = Math.atan2(xAt(y + 8) - xAt(y - 8), 16);
      const side = i++ % 2 ? 1 : -1;
      const el = sprig('leaf', wide ? 28 + rand() * 18 : 17 + rand() * 7, 180 - (slope * 180) / Math.PI + side * (58 + rand() * 24));
      el.style.left = `${xAt(y)}px`;
      el.style.top = `${y}px`;
      vine.append(el);
      vLeaves.push({ el, y });
    }
    const top = page.getBoundingClientRect().top;
    $$('[data-bloom]', page).forEach((sec, k) => {
      const y = sec.getBoundingClientRect().top - top + (wide ? 150 : 96);
      const el = sprig(k % 2 ? 'bloom-b' : 'bloom-a', wide ? 62 : 24, k % 2 ? 14 : -12);
      el.style.left = `${xAt(y) + (wide ? (k % 2 ? 16 : -14) : 0)}px`;
      el.style.top = `${y}px`;
      vine.append(el);
      vLeaves.push({ el, y: y + 20 });
    });
    onVine();
  };

  const onVine = () => {
    const top = page.getBoundingClientRect().top;
    const tip = -top + window.innerHeight * 0.74;
    const row = vTable[clamp(Math.round(tip / 16), 0, vTable.length - 1) | 0];
    const drawn = tip <= 0 || !row ? 0 : row.len;
    vpaths.forEach((pth) => (pth.style.strokeDashoffset = `${vLen - drawn}`));
    const a = -top - 150;
    const b = -top + window.innerHeight + 150;
    for (const l of vLeaves) {
      l.el.classList.toggle('open', l.y < tip);
      l.el.classList.toggle('near', l.y > a && l.y < b);
    }
  };

  // scroll-linked details further down: parallax on the pictures, rules that underline as
  // they come up, seed packets that settle into the row
  const pars = $$('[data-par]');
  const rules = $$('[data-rule]');
  const packs = $$('[data-pack]');
  const onDetails = () => {
    const vh = window.innerHeight;
    for (const el of pars) {
      const r = el.getBoundingClientRect();
      if (r.bottom < -200 || r.top > vh + 200) continue;
      el.style.transform = `translateY(${((r.top + r.height / 2 - vh / 2) * -Number(el.dataset.par)).toFixed(1)}px)`;
    }
    for (const el of rules) {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--k', ease((vh * 0.92 - r.top) / (vh * 0.4)).toFixed(3));
    }
    packs.forEach((el, i) => {
      const r = el.parentElement!.getBoundingClientRect();
      const k = 1 - ease((vh - r.top - i * 40) / (vh * 0.55));
      el.style.transform = reduced ? '' : `translateY(${(k * (50 + i * 26)).toFixed(1)}px) rotate(${(k * (i % 2 ? 3 : -3)).toFixed(2)}deg)`;
    });
  };

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      onGrow();
      onVine();
      onDetails();
    });
  };
  const relayout = () => {
    measure();
    buildVine();
    onGrow();
    onDetails();
  };
  let rz = 0;
  new ResizeObserver(() => {
    clearTimeout(rz);
    rz = window.setTimeout(relayout, 120);
  }).observe(page);
  window.addEventListener('resize', () => {
    clearTimeout(rz);
    rz = window.setTimeout(relayout, 120);
  });
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('load', relayout);
  relayout();

  // =====================================================================================
  // Butterflies, bees and a swallow. Each is one top-down painting split down the middle:
  // the two halves are squeezed toward the body to flap. Butterflies and bees steer toward
  // a point that keeps changing (somewhere nearby, the cursor, or an open flower, where
  // they land for a while). Fast scrolling scatters them. The swallow crosses now and then.
  // =====================================================================================
  type Crit = {
    el: HTMLElement;
    kind: 'fly' | 'bee' | 'bird';
    x: number;
    y: number;
    vx: number;
    vy: number;
    h: number;
    tx: number;
    ty: number;
    state: 'roam' | 'cursor' | 'seek' | 'perch' | 'flee' | 'away' | 'cross';
    timer: number;
    target: Element | null;
    ph: number;
    ox: number;
    oy: number;
    dir: number;
    speed: number;
    y0: number;
  };
  const sky = $('[data-crits]');
  const mouse = { x: -1, y: -1, at: -1e9 };
  window.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    mouse.x = e.clientX;
    mouse.y = e.clientY;
    mouse.at = performance.now();
  });

  if (!reduced) {
    const small = window.innerWidth < 860;
    const cast: Crit['kind'][] = small ? ['fly', 'fly', 'bee', 'bee', 'bird'] : ['fly', 'fly', 'fly', 'bee', 'bee', 'bee', 'bird'];
    const sizes = { fly: small ? 40 : 54, bee: small ? 26 : 34, bird: small ? 62 : 92 };
    const crits: Crit[] = cast.map((kind, i) => {
      const el = document.createElement('div');
      el.className = `crit ${kind}`;
      el.style.setProperty('--s', `${sizes[kind] * (kind === 'bird' ? 1 : rnd(0.85, 1.15))}px`);
      el.innerHTML = '<b class="w l"></b><b class="w r"></b><b class="bd"></b>';
      sky.append(el);
      return {
        el,
        kind,
        x: i % 2 ? window.innerWidth + 60 : -60,
        y: rnd(0.2, 0.7) * window.innerHeight,
        vx: 0,
        vy: 0,
        h: 0,
        tx: rnd(0.2, 0.8) * window.innerWidth,
        ty: rnd(0.2, 0.7) * window.innerHeight,
        state: kind === 'bird' ? 'away' : 'roam',
        timer: kind === 'bird' ? 3 : rnd(1, 3),
        target: null,
        ph: rnd(0, 6.28),
        ox: 0,
        oy: 0,
        dir: 1,
        speed: 0,
        y0: 0,
      };
    });

    const flowers = () => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      return $$('[data-flower]').filter((f) => {
        if (f.classList.contains('lf') && !f.classList.contains('open')) return false;
        const r = (f.firstElementChild ?? f).getBoundingClientRect();
        return r.width > 12 && r.top > 70 && r.bottom < h - 20 && r.left > 0 && r.right < w;
      });
    };
    const taken = (f: Element) => crits.some((c) => c.target === f);
    const centre = (f: Element) => {
      const r = (f.firstElementChild ?? f).getBoundingClientRect();
      return [r.left + r.width / 2, r.top + r.height / 2];
    };

    const choose = (c: Crit, now: number) => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      const r = Math.random();
      c.target = null;
      if (now - mouse.at < 2500 && r < 0.38) {
        c.state = 'cursor';
        c.ox = rnd(-70, 70);
        c.oy = rnd(-60, 60);
        c.timer = rnd(1.8, 3.6);
        return;
      }
      if (r < 0.8) {
        const free = flowers().filter((f) => !taken(f));
        if (free.length) {
          c.state = 'seek';
          c.target = free[(Math.random() * free.length) | 0];
          c.timer = 7;
          return;
        }
      }
      c.state = 'roam';
      // without flowers in view they keep mostly to the edges, clear of the text
      const edge = Math.random() < 0.7;
      c.tx = edge ? (Math.random() < 0.5 ? rnd(0.02, 0.14) : rnd(0.86, 0.98)) * w : rnd(0.1, 0.9) * w;
      c.ty = rnd(0.14, 0.86) * h;
      c.timer = rnd(2, 4.5);
    };

    let last = performance.now();
    let lastY = window.scrollY;
    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      const t = now / 1000;
      const w = window.innerWidth;
      const h = window.innerHeight;
      const dy = window.scrollY - lastY;
      lastY = window.scrollY;
      const fast = Math.abs(dy) > 34;

      for (const c of crits) {
        let flap = 1;
        if (c.kind === 'bird') {
          c.timer -= dt;
          if (c.state === 'away') {
            if (fast) c.timer = Math.min(c.timer, 0.25);
            if (c.timer < 0) {
              c.state = 'cross';
              c.dir = Math.random() < 0.5 ? 1 : -1;
              c.x = c.dir > 0 ? -90 : w + 90;
              c.y0 = rnd(0.14, 0.6) * h;
              c.speed = rnd(360, 520) * (w < 860 ? 0.6 : 1);
              c.ph = rnd(0, 6.28);
            }
          } else {
            if (fast) {
              c.speed = Math.min(1100, c.speed * 1.5);
              c.y0 -= Math.sign(dy) * 40;
            }
            c.y0 -= dy * 0.25;
            const px = c.x;
            const py = c.y;
            c.x += c.dir * c.speed * dt;
            c.y = c.y0 + Math.sin((c.x / w) * 4.2 + c.ph) * h * 0.1;
            c.h = Math.atan2(c.y - py, c.x - px);
            const beat = Math.sin(t * 1.7 + c.ph) > -0.2 || c.speed > 600;
            flap = beat ? 0.4 + 0.6 * Math.abs(Math.sin(t * 9)) : 1;
            if (c.x < -120 || c.x > w + 120) {
              c.state = 'away';
              c.timer = rnd(5, 12);
            }
          }
          c.el.style.opacity = c.state === 'away' ? '0' : '1';
        } else {
          const bee = c.kind === 'bee';
          c.timer -= dt;
          if (fast && c.state !== 'flee') {
            c.state = 'flee';
            c.target = null;
            c.timer = rnd(0.9, 1.6);
            const a = Math.atan2(c.y - h / 2, c.x - w / 2) + rnd(-0.6, 0.6);
            c.vx += Math.cos(a) * rnd(600, 1000);
            c.vy += Math.sin(a) * rnd(500, 800) + Math.sign(dy) * 380;
          }
          if (c.state === 'perch' && c.target) {
            const [fx, fy] = centre(c.target);
            const open = !c.target.classList.contains('lf') || c.target.classList.contains('open');
            if (c.timer < 0 || !open || fy < 40 || fy > h + 40) {
              choose(c, now);
              if (c.state === 'seek') c.state = 'roam';
              c.vy -= 120;
            } else {
              c.x += (fx - c.x) * 0.35;
              c.y += (fy - c.y) * 0.35;
              c.vx = c.vy = 0;
              c.h += Math.sin(t * 0.7 + c.ph) * 0.004;
              flap = bee ? 0.9 + 0.1 * Math.sin(t * 40) : 0.42 + 0.58 * Math.abs(Math.sin(t * 1.5 + c.ph));
            }
          } else {
            if (c.timer < 0) choose(c, now);
            let tx = c.tx;
            let ty = c.ty;
            if (c.state === 'cursor') {
              tx = mouse.x + c.ox;
              ty = mouse.y + c.oy;
            } else if (c.state === 'seek' && c.target) {
              [tx, ty] = centre(c.target);
              if (Math.hypot(tx - c.x, ty - c.y) < 16) {
                c.state = 'perch';
                c.timer = rnd(2.5, 6);
              }
            }
            c.y -= dy * 0.3;
            if (c.state !== 'flee') {
              const dx = tx - c.x;
              const dyy = ty - c.y;
              const d = Math.hypot(dx, dyy) || 1;
              const acc = bee ? 900 : 420;
              c.vx += (dx / d) * acc * dt;
              c.vy += (dyy / d) * acc * dt;
              const far = clamp(d / 120, 0.25, 1);
              if (bee) {
                c.vx += Math.cos(t * 5.3 + c.ph) * 520 * dt * far;
                c.vy += Math.sin(t * 6.7 + c.ph * 2) * 520 * dt * far;
              } else {
                c.vx += Math.cos(t * 2.9 + c.ph) * 300 * dt * far;
                c.vy += Math.sin(t * 7.4 + c.ph) * 620 * dt * far;
              }
              const max = (bee ? 250 : 150) * (c.state === 'seek' ? clamp(d / 90, 0.35, 1) : 1);
              const sp = Math.hypot(c.vx, c.vy);
              if (sp > max) {
                c.vx *= mix(1, max / sp, 0.2);
                c.vy *= mix(1, max / sp, 0.2);
              }
            } else {
              c.vx *= 1 - 1.6 * dt;
              c.vy *= 1 - 1.6 * dt;
            }
            c.x += c.vx * dt;
            c.y += c.vy * dt;
            if (c.x < -70) c.vx += 900 * dt;
            if (c.x > w + 70) c.vx -= 900 * dt;
            if (c.y < -70) c.vy += 900 * dt;
            if (c.y > h + 70) c.vy -= 900 * dt;
            c.x = clamp(c.x, -160, w + 160);
            c.y = clamp(c.y, -160, h + 160);
            const want = Math.atan2(c.vy, c.vx);
            let diff = want - c.h;
            while (diff > Math.PI) diff -= Math.PI * 2;
            while (diff < -Math.PI) diff += Math.PI * 2;
            c.h += diff * Math.min(1, dt * (bee ? 9 : 5));
            flap = bee ? 0.5 + 0.5 * Math.abs(Math.sin(t * 61 + c.ph)) : 0.16 + 0.84 * Math.abs(Math.sin(t * (c.state === 'flee' ? 17 : 10.5) + c.ph));
          }
        }
        c.el.style.transform = `translate3d(${c.x.toFixed(1)}px, ${c.y.toFixed(1)}px, 0) rotate(${(c.h + Math.PI / 2).toFixed(3)}rad)`;
        c.el.style.setProperty('--f', flap.toFixed(3));
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // =====================================================================================
  // Services: the index on the left drives one card on the right.
  // =====================================================================================
  {
    const tabs = $$<HTMLButtonElement>('[data-tab]');
    const panels = $$('[data-panel]');
    const cards = $('.v7 .cards');
    const pick = (i: number, focus = false) => {
      tabs.forEach((tb, k) => {
        tb.setAttribute('aria-selected', String(k === i));
        tb.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((pn, k) => pn.classList.toggle('on', k === i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((tb, i) => {
      tb.addEventListener('click', () => {
        pick(i);
        const r = cards.getBoundingClientRect();
        if (r.top > window.innerHeight * 0.7 || r.top < 0) cards.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
      });
      tb.addEventListener('mouseenter', () => window.innerWidth >= 860 && pick(i));
      tb.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        pick((i + step + tabs.length) % tabs.length, true);
      });
    });
  }

  // =====================================================================================
  // Demo panels. Anything with data-at appears at that many milliseconds, data-hit gets a
  // highlight, data-off disappears, data-type is typed out and data-count counts up. A panel
  // plays when it scrolls into view and again from its Replay button.
  // =====================================================================================
  $$('[data-demo]').forEach((root) => {
    let timers: number[] = [];
    let raf = 0;
    let live = 0;
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const typed = $$('[data-type]', root).map((el) => ({ el, text: el.textContent ?? '' }));
    const counts = $$('[data-count]', root);
    const spark = root.querySelector<SVGPathElement>('[data-spark]');
    const liveMs = root.querySelector<HTMLElement>('[data-live-ms]');
    const series = Array.from({ length: 60 }, (_, i) => 1.9 + Math.sin(i / 4) * 0.25 + Math.random() * 0.5);
    const drawSpark = (n = 60) => {
      if (!spark) return;
      spark.setAttribute(
        'd',
        series
          .slice(0, n)
          .map((v, i) => `${i ? 'L' : 'M'}${((i / 59) * 300).toFixed(1)} ${(70 - ((v - 1) / 2.3) * 64).toFixed(1)}`)
          .join(''),
      );
    };
    drawSpark();

    const stop = () => {
      timers.forEach(clearTimeout);
      timers = [];
      cancelAnimationFrame(raf);
      clearInterval(live);
    };
    const play = () => {
      stop();
      root.classList.add('armed');
      $$('[data-at]', root).forEach((el) => {
        el.classList.remove('on');
        later(() => el.classList.add('on'), Number(el.dataset.at));
      });
      $$('[data-hit]', root).forEach((el) => {
        el.classList.remove('hit');
        later(() => el.classList.add('hit'), Number(el.dataset.hit));
      });
      $$('[data-off]', root).forEach((el) => {
        el.classList.remove('off');
        later(() => el.classList.add('off'), Number(el.dataset.off));
      });
      typed.forEach(({ el, text }) => {
        el.textContent = '';
        el.classList.add('typing');
        [...text].forEach((_, i) =>
          later(() => {
            el.textContent = text.slice(0, i + 1);
            if (i === text.length - 1) el.classList.remove('typing');
          }, Number(el.dataset.at) + i * 30),
        );
      });
      const t0 = performance.now();
      const frame = (now: number) => {
        let busy = false;
        counts.forEach((el) => {
          const k = clamp((now - t0 - Number(el.dataset.at)) / Number(el.dataset.dur));
          if (k < 1) busy = true;
          el.textContent = (Number(el.dataset.count) * (1 - Math.pow(1 - k, 3))).toFixed(Number(el.dataset.dec ?? 0));
        });
        if (spark) {
          const k = clamp((now - t0 - 1100) / 1500);
          drawSpark(Math.max(2, Math.round(k * 60)));
          if (k < 1) busy = true;
        }
        if (busy) raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
      // the dashboard keeps ticking after its intro
      if (spark) {
        later(() => {
          live = window.setInterval(() => {
            const next = clamp(series[59] + (Math.random() - 0.5) * 0.5, 1.5, 2.9);
            series.push(next);
            series.shift();
            drawSpark();
            if (liveMs) liveMs.textContent = (2.2 + Math.random() * 0.4).toFixed(1);
          }, 900);
        }, 3200);
      }
    };
    $('[data-replay]', root).addEventListener('click', play);
    if (reduced) return;
    let played = false;
    new IntersectionObserver(
      (entries) => {
        const seen = entries[0].isIntersecting;
        if (seen && !played) {
          played = true;
          play();
        }
        if (!seen && spark) clearInterval(live);
      },
      { threshold: 0.35 },
    ).observe(root);
  });

  // =====================================================================================
  // Contact form: build a mailto link. Nothing is sent from this page.
  // =====================================================================================
  {
    const form = $<HTMLFormElement>('[data-form]');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const topics = data.getAll('topic').join(', ');
      const body = [`Name: ${data.get('name')}`, `Email: ${data.get('email')}`, topics ? `About: ${topics}` : '', '', String(data.get('message') ?? '')]
        .filter((l, i) => l || i === 3)
        .join('\n');
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Project enquiry from ${data.get('name')}`)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
