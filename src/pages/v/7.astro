      padding-right: 10px;
    }
    .v7 .fin {
      padding-bottom: 330px;
    }
    .v7 .fhouse {
      right: 10px;
      bottom: 84px;
      width: 170px;
    }
    .v7 .fpots {
      right: 190px;
      bottom: 78px;
      width: 100px;
    }
    .v7 .fsoil {
      width: 900px;
      margin-left: -450px;
      bottom: -46px;
