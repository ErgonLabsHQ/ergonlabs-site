      flex-wrap: wrap;
      row-gap: 8px;
    }
    .v7 .ptag {
      font-size: 12.5px;
    }
    .v7 .wk li {
      grid-template-columns: 3.6em 1fr;
    }
    .v7 .wk li i {
      grid-column: 2;
      justify-self: start;
    }
