    order: 2;
  }
  .v9 .demo-row.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
  }
  .v9 .demo-copy h3 {
    font-size: clamp(32px, 3.6vw, 52px);
  }
  .v9 .demo-copy h3::before {
    content: '';
    display: block;
    width: 44px;
    height: 10px;
    margin-bottom: 20px;
    background: radial-gradient(circle at 5px 5px, var(--aqua) 0 3px, transparent 3.5px), linear-gradient(var(--aqua), var(--aqua)) 12px 4.5px / 32px 1px no-repeat;
    filter: drop-shadow(0 0 6px var(--aqua));
  }
  .v9 .demo-copy p {
    margin-top: 16px;
    color: var(--mute);
    font-size: 17.5px;
    max-width: 38ch;
  }
  .v9 .demo-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(22px, 3vw, 40px);
    align-items: start;
