    padding: 0;
  }
  .v9 .ask-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .v9 .chip {
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid rgba(233, 247, 243, 0.3);
    font: 500 13px/1.2 var(--sans);
  }
  /* the Approve chip is always visible; its step marks the moment it is pressed */
  .v9.js [data-demo] .chip[data-s] {
    opacity: 1;
    transform: none;
    transition: background 0.3s, color 0.3s, border-color 0.3s, box-shadow 0.3s;
  }
  .v9 .chip.yes.on,
  .v9:not(.js) .chip.yes {
    background: var(--aqua);
    border-color: var(--aqua);
    color: var(--ink);
    box-shadow: 0 0 22px rgba(111, 245, 224, 0.5);
  }

  .v9 .docs {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  .v9 .sonar {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(111, 245, 224, 0.5);
    background: repeating-radial-gradient(circle, transparent 0 24%, rgba(111, 245, 224, 0.2) 24% 25%),
      linear-gradient(rgba(111, 245, 224, 0.18), rgba(111, 245, 224, 0.18)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(rgba(111, 245, 224, 0.18), rgba(111, 245, 224, 0.18)) 0 50% / 100% 1px no-repeat, rgba(111, 245, 224, 0.04);
    overflow: hidden;
  }
  .v9 .sweep {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, rgba(111, 245, 224, 0.5), transparent 22%, transparent);
    animation: v9-sweep 3.2s linear infinite reverse;
  }
  @keyframes v9-sweep {
    to {
      rotate: 360deg;
    }
  }
  .v9 .blip {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--aqua);
    box-shadow: 0 0 12px var(--aqua);
  }
  .v9 .blip.no {
    background: var(--coral);
    box-shadow: 0 0 12px var(--coral);
  }
  .v9 .b1 {
    left: 62%;
    top: 26%;
  }
  .v9 .b2 {
    left: 30%;
    top: 40%;
  }
  .v9 .b3 {
    left: 55%;
    top: 68%;
  }
  .v9 .b4 {
    left: 20%;
    top: 70%;
  }
  .v9 .docs .q {
    font: 500 17px/1.35 var(--sans);
    color: var(--foam);
    margin-bottom: 12px;
  }
  .v9 .src {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    font-size: 12.5px;
  }
  .v9 .src li {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid rgba(233, 247, 243, 0.1);
  }
  .v9 .src b {
    font-weight: 400;
    color: var(--aqua);
  }
  .v9 .src span {
    opacity: 0.65;
  }
  .v9 .src .skip b,
  .v9 .src .skip span {
    color: var(--coral);
    opacity: 0.9;
  }
  .v9 .docs .a {
    font: 400 15.5px/1.55 var(--sans);
    color: var(--foam);
  }
  .v9 .docs cite {
    font: 400 11px/1 var(--mono);
    font-style: normal;
    white-space: nowrap;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid rgba(111, 245, 224, 0.5);
    color: var(--aqua);
    vertical-align: 1px;
  }

  .v9 .evals {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 22px;
    align-items: start;
  }
  .v9 .cells {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 4px;
  }
  .v9 .cells i {
    aspect-ratio: 1;
    border-radius: 3px;
    background: rgba(111, 245, 224, 0.75);
    transition: background 0.25s, box-shadow 0.25s;
  }
  .v9 .cells i.bad {
    background: var(--coral);
    box-shadow: 0 0 10px rgba(255, 143, 163, 0.7);
  }
  .v9.js .cells i:not(.done) {
    background: rgba(233, 247, 243, 0.09);
    box-shadow: none;
  }
  .v9 .stat span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .v9 .stat b {
    display: block;
    font: 500 clamp(34px, 3.6vw, 50px) / 1.05 var(--serif);
    color: var(--foam);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .v9 .stat b span {
    display: inline;
    font: inherit;
    letter-spacing: 0;
    opacity: 1;
  }
  .v9 .stat.dim b {
    font-size: 24px;
    opacity: 0.6;
  }
  .v9 .stat small {
    font-size: 11.5px;
    opacity: 0.6;
  }
  .v9 .stat.dim {
    margin-top: 8px;
  }
  .v9 .fails {
    list-style: none;
    margin: 12px 0;
    padding: 0;
    font-size: 12.5px;
    color: var(--coral);
  }
  .v9 .fails li {
    padding: 3px 0 3px 14px;
    position: relative;
  }
  .v9 .fails li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--coral);
  }
  .v9 .verdict {
    color: var(--aqua);
    padding-top: 10px;
    border-top: 1px dashed rgba(233, 247, 243, 0.16);
  }

  .v9 .dash-nums {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .v9 .spark {
    display: block;
    width: 100%;
    height: 110px;
    margin: 12px 0;
    border-block: 1px solid rgba(233, 247, 243, 0.1);
  }
  .v9 .routes > div {
    display: grid;
    grid-template-columns: 150px 1fr 40px;
    gap: 12px;
    align-items: center;
    padding: 4px 0;
    font-size: 12.5px;
  }
  .v9 .routes i {
    height: 6px;
    border-radius: 3px;
    background: rgba(233, 247, 243, 0.1);
    position: relative;
    overflow: hidden;
  }
  .v9 .routes i::after {
    content: '';
    position: absolute;
    inset: 0;
    width: var(--w);
    background: var(--aqua);
    border-radius: 3px;
    transform-origin: left;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s;
  }
  .v9.js .routes div:not(.on) i::after {
    transform: scaleX(0);
  }
  .v9 .routes b {
    font-weight: 400;
    text-align: right;
  }
  .v9 .note {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed rgba(233, 247, 243, 0.16);
    font-size: 12.5px;
  }

  .v9 .bug-chart {
    display: block;
    width: 100%;
    height: 84px;
    margin-bottom: 10px;
  }
  .v9 .bug-chart line {
    stroke: rgba(233, 247, 243, 0.14);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .v9 .bug-chart path {
    fill: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 700;
    stroke-linejoin: round;
  }
  .v9 .bug-chart .up {
    stroke: var(--coral);
  }
  .v9 .bug-chart .down {
    stroke: var(--aqua);
  }
  .v9.js [data-demo] .bug-chart path {
    opacity: 1;
    transform: none;
    stroke-dashoffset: 700;
    transition: stroke-dashoffset 1.6s ease;
  }
  .v9.js [data-demo] .bug-chart path.on {
    stroke-dashoffset: 0;
  }
  .v9 .bug-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .v9 .bug-steps li {
    display: grid;
    grid-template-columns: 46px 78px 1fr;
    gap: 8px;
    padding: 8px 0;
    border-top: 1px solid rgba(233, 247, 243, 0.1);
    font-size: 12.5px;
  }
  .v9 .bug-steps time {
    opacity: 0.55;
  }
  .v9 .bug-steps b {
    font-weight: 500;
    color: var(--foam);
  }
  .v9 .bug-steps .err b {
    color: var(--coral);
  }
  .v9 .bug-steps .ok b {
    color: var(--aqua);
  }
  .v9 .bug-steps span {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.4;
  }

  .v9 .call {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font: 400 14.5px/1.45 var(--sans);
  }
  .v9 .wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 30px;
    margin-bottom: 4px;
  }
  .v9 .wave i {
    flex: 1;
    max-width: 5px;
    height: 100%;
    border-radius: 3px;
    background: var(--aqua);
    opacity: 0.7;
    transform: scaleY(0.2);
    animation: v9-wave 1.1s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.13s);
  }
  @keyframes v9-wave {
    to {
      transform: scaleY(1);
    }
  }
  .v9 .panel.done .wave i {
    animation-play-state: paused;
  }
  .v9 .call p {
    max-width: 84%;
    padding: 9px 13px;
    border-radius: 14px;
  }
  .v9 .call .them {
    align-self: flex-start;
    background: rgba(233, 247, 243, 0.1);
    border-bottom-left-radius: 3px;
  }
  .v9 .call .us {
    align-self: flex-end;
    background: rgba(111, 245, 224, 0.16);
    border: 1px solid rgba(111, 245, 224, 0.3);
    color: var(--foam);
    border-bottom-right-radius: 3px;
  }
  .v9 .handoff {
    margin-top: 4px;
    padding: 10px 13px;
    border-radius: 10px;
    border: 1px solid rgba(255, 143, 163, 0.5);
    background: rgba(255, 143, 163, 0.08);
  }
  .v9 .handoff b {
    display: block;
    font: 500 11px/1.4 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral);
  }
  .v9 .handoff span {
    font-size: 13.5px;
  }

  /* ---------- process ---------- */
  .v9 .descent {
    display: grid;
    grid-template-columns: clamp(190px, 26vw, 330px) minmax(0, 1fr);
    gap: clamp(20px, 5vw, 80px);
    position: relative;
  }
  .v9 .line {
    position: relative;
  }
  .v9 .line::before {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    border-right: 1px dashed rgba(233, 247, 243, 0.35);
  }
  .v9 .subm {
    position: sticky;
    top: calc(50vh - 90px);
    margin-right: 26px;
    z-index: 1;
  }
  .v9 .subm img {
    display: block;
    width: 100%;
    height: auto;
    scale: -1 1;
    animation: v9-bob 5s ease-in-out infinite alternate;
  }
  @keyframes v9-bob {
    from {
      translate: 0 -7px;
      rotate: -1.5deg;
    }
    to {
      translate: 0 7px;
      rotate: 2deg;
    }
  }
  .v9 .beam {
    position: absolute;
    left: 74%;
    top: 12%;
    width: 60vw;
    height: 340px;
    transform-origin: 0 50%;
    translate: 0 -30%;
    rotate: 6deg;
    background: linear-gradient(90deg, rgba(180, 255, 240, 0.34), rgba(111, 245, 224, 0.08) 45%, transparent 75%);
    clip-path: polygon(0 47%, 100% 0, 100% 100%, 0 53%);
    filter: blur(6px);
    pointer-events: none;
  }
  .v9 .stop {
    position: relative;
    min-height: 58vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 30px 0;
    max-width: 560px;
    transition: opacity 0.6s;
  }
  .v9.js .stop:not(.lit) {
    opacity: 0.42;
  }
  .v9 .knot {
    position: absolute;
    left: calc(clamp(20px, 5vw, 80px) * -1 - 6px);
    top: 50%;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--foam);
    background: #083642;
    transition: background 0.4s, box-shadow 0.4s, border-color 0.4s;
  }
  .v9 .stop.lit .knot {
    background: var(--aqua);
    border-color: var(--aqua);
    box-shadow: 0 0 18px var(--aqua);
  }
  .v9 .when {
    font: 400 13px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral);
  }
  .v9 .stop h3 {
    font-size: clamp(54px, 8vw, 116px);
    font-style: italic;
    font-weight: 400;
    margin: 10px 0 14px;
  }
  .v9 .stop p:last-child {
    font-size: clamp(17px, 1.45vw, 20px);
    color: rgba(233, 247, 243, 0.9);
  }

  /* ---------- engagements ---------- */
  .v9 .plans {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .v9 .plan-card {
    display: flex;
    flex-direction: column;
    padding: 26px 24px 28px;
    border: 1px solid var(--line);
    border-radius: 6px 30px 6px 30px;
    background: rgba(3, 26, 31, 0.6);
    transition: translate 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.3s, box-shadow 0.4s;
  }
  .v9 .plan-card:hover {
    translate: 0 -6px;
    border-color: rgba(111, 245, 224, 0.5);
    box-shadow: 0 20px 60px -20px rgba(111, 245, 224, 0.25);
  }
  .v9 .plan-card.featured {
    border-color: rgba(255, 143, 163, 0.6);
    background: linear-gradient(170deg, rgba(255, 143, 163, 0.13), rgba(3, 26, 31, 0.6) 55%);
  }
  .v9 .plan-card h3 {
    font-size: 50px;
    font-style: italic;
    font-weight: 400;
  }
  .v9 .plan-card .for {
    margin: 10px 0 16px;
    font: 400 12.5px/1.45 var(--mono);
    color: var(--aqua);
    min-height: 2.9em;
  }
  .v9 .plan-card.featured .for {
    color: var(--coral);
  }
  .v9 .plan-card .txt {
    color: rgba(233, 247, 243, 0.9);
    font-size: 16px;
  }
  .v9 .plan-card ul {
    list-style: none;
    margin: auto 0 0;
    padding: 18px 0 0;
    font-size: 14.5px;
    color: var(--mute);
  }
  .v9 .plan-card li {
    padding: 8px 0;
    border-top: 1px solid var(--line);
  }

  /* ---------- house rules ---------- */
  .v9 .jelly-deco {
    position: absolute;
    right: 4vw;
    top: 30px;
    width: clamp(90px, 12vw, 170px);
    height: auto;
    opacity: 0.8;
    pointer-events: none;
    animation: v9-jelly 4.2s ease-in-out infinite;
  }
  @keyframes v9-jelly {
    50% {
      scale: 1.05 0.94;
    }
  }
  .v9 .rule {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 12px clamp(24px, 5vw, 80px);
    align-items: baseline;
    padding: clamp(20px, 2.6vw, 34px) 0;
    border-top: 1px solid var(--line);
  }
  .v9 .rule:last-child {
    border-bottom: 1px solid var(--line);
  }
  .v9 .rule h3 {
    font-size: clamp(28px, 3.3vw, 46px);
    transition: color 0.3s;
  }
  .v9 .rule:hover h3 {
    color: var(--aqua);
  }
  .v9 .rule p {
    color: var(--mute);
    font-size: 17px;
  }

  /* ---------- questions ---------- */
  .v9 .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
  }
  .v9 .faq .head {
    position: sticky;
    top: 110px;
  }
  .v9 .faq .head h2 {
    font-size: clamp(36px, 4vw, 58px);
  }
  .v9 .faq details {
    border-top: 1px solid var(--line);
  }
  .v9 .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }
  .v9 .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 20px 0;
    font: 500 clamp(22px, 2.1vw, 28px) / 1.2 var(--serif);
    cursor: pointer;
    list-style: none;
    transition: color 0.2s;
  }
  .v9 .faq summary::-webkit-details-marker {
    display: none;
  }
  .v9 .faq summary:hover {
    color: var(--aqua);
  }
  .v9 .faq summary i {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgba(233, 247, 243, 0.35);
    position: relative;
    transition: rotate 0.35s, border-color 0.3s, background 0.3s;
  }
  .v9 .faq summary i::before,
  .v9 .faq summary i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1px;
    background: currentColor;
    translate: -50% -50%;
  }
  .v9 .faq summary i::after {
    rotate: 90deg;
  }
  .v9 .faq details[open] summary i {
    rotate: 45deg;
    border-color: var(--aqua);
    color: var(--aqua);
  }
  .v9 .faq details p {
    padding: 0 50px 24px 0;
    color: var(--mute);
    max-width: 62ch;
  }

  /* ---------- contact ---------- */
  .v9 .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
  }
  .v9 .contact h2 {
    font-size: clamp(38px, 4.8vw, 68px);
    margin-top: 16px;
  }
  .v9 .mail {
    display: inline-block;
    margin-top: 22px;
    font: 500 clamp(24px, 2.4vw, 32px) / 1.2 var(--serif);
    font-style: italic;
    color: var(--aqua);
    border-bottom: 1px solid rgba(111, 245, 224, 0.4);
  }
  .v9 .angler {
    position: relative;
    width: min(440px, 100%);
    margin-top: 34px;
  }
  .v9 .angler img {
    display: block;
    width: 100%;
    height: auto;
    animation: v9-bob 7s ease-in-out infinite alternate;
  }
  .v9 .lure {
    position: absolute;
    left: 14%;
    top: 37%;
    width: 300px;
    height: 300px;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(170, 255, 240, 0.6), rgba(111, 245, 224, 0.2) 22%, transparent 62%);
    animation: v9-lure 3.4s ease-in-out infinite;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  @keyframes v9-lure {
    0%,
    100% {
      opacity: 0.55;
      scale: 0.86;
    }
    45% {
      opacity: 1;
      scale: 1.1;
    }
    55% {
      opacity: 0.7;
    }
    62% {
      opacity: 1;
    }
  }
  .v9 .form {
    display: grid;
    gap: 18px;
    padding: clamp(22px, 3vw, 38px);
    border: 1px solid var(--line);
    border-radius: 6px 40px 6px 40px;
    background: rgba(3, 26, 31, 0.72);
    box-shadow: -40px 0 120px -40px rgba(111, 245, 224, 0.16);
  }
  .v9 .form label > span,
  .v9 .form legend {
    display: block;
    font: 400 11.5px/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 9px;
    padding: 0;
  }
  .v9 .form fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .v9 .form input[type='text'],
  .v9 .form input[type='email'],
  .v9 .form textarea {
    width: 100%;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid rgba(233, 247, 243, 0.22);
    background: rgba(233, 247, 243, 0.05);
    color: var(--foam);
    font: 400 16px/1.4 var(--sans);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .v9 .form textarea {
    resize: vertical;
  }
  .v9 .form input:focus,
  .v9 .form textarea:focus {
    outline: none;
    border-color: var(--aqua);
    box-shadow: 0 0 0 3px rgba(111, 245, 224, 0.18);
  }
  .v9 .checks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .v9 .check {
    position: relative;
    cursor: pointer;
  }
  .v9 .check input {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .v9 .form .check span {
    display: block;
    margin: 0;
    padding: 9px 14px;
    border-radius: 999px;
    border: 1px solid rgba(233, 247, 243, 0.25);
    font: 500 14px/1 var(--sans);
    letter-spacing: 0;
    text-transform: none;
    color: var(--foam);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .v9 .form .check input:checked + span {
    background: var(--aqua);
    border-color: var(--aqua);
    color: var(--ink);
  }
  .v9 .form .check input:focus-visible + span {
    outline: 2px solid var(--aqua);
    outline-offset: 2px;
  }
  .v9 .form .btn {
    justify-self: start;
    font-size: 16px;
    padding: 15px 26px;
  }
  .v9 .fine {
    font-size: 13.5px;
    color: var(--mute);
  }

  /* ---------- sea floor ---------- */
  .v9 .floor {
    position: relative;
    padding: 60px 0 0;
    background: linear-gradient(transparent, rgba(3, 19, 23, 0.9) 40%);
  }
  .v9 .floor-grid {
    display: grid;
