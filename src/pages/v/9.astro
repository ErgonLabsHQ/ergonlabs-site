  }
  .v9 .floor-art {
    display: block;
    width: max(100%, 900px);
    height: auto;
    margin: -20px 0 0 50%;
    translate: -50% 0;
    padding-bottom: 0;
  }

  /* ---------- narrow screens ---------- */
  @media (max-width: 980px) {
    .v9 .top nav {
      display: none;
    }
    .v9 .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .v9 {
      font-size: 16.5px;
    }
    .v9 .sky {
      --fx: 0.385;
    }
    .v9 .lead .eyebrow {
      max-width: 230px;
    }
    .v9 .svc,
    .v9 .demo-row,
    .v9 .demo-row.flip,
    .v9 .demo-pair,
    .v9 .faq-grid,
    .v9 .contact-grid,
    .v9 .rule {
      grid-template-columns: minmax(0, 1fr);
    }
    .v9 .demo-row.flip > :first-child {
      order: 0;
    }
    .v9 .svc-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 16px;
    }
    .v9 .svc-tabs button {
      font-size: 18.5px;
      padding: 11px 0;
      min-height: 62px;
    }
    .v9 .svc-tabs button:hover,
    .v9 .svc-tabs button[aria-selected='true'] {
      padding-left: 0;
      color: var(--aqua);
    }
    .v9 .svc-tabs svg {
      display: none;
    }
    .v9 .svc-panels {
      position: static;
      scroll-margin-top: 80px;
    }
    .v9 .svc-panel ul {
      columns: 1;
    }
    .v9 .faq .head {
      position: static;
      margin-bottom: 10px;
    }
    .v9 .whale-band {
      min-height: 78vh;
    }
    .v9 .docs {
      grid-template-columns: 1fr;
    }
    .v9 .sonar {
      width: 120px;
      margin: 0 auto;
    }
    .v9 .evals {
      grid-template-columns: 1fr;
    }
    .v9 .routes > div {
      grid-template-columns: 118px 1fr 34px;
      gap: 8px;
    }
    .v9 .panel .k {
      width: 58px;
    }
    .v9 .panel-station {
      display: none;
    }
    .v9 .bug-steps li {
      grid-template-columns: 42px 1fr;
    }
    .v9 .bug-steps span {
      grid-column: 1 / -1;
    }
    .v9 .descent {
      grid-template-columns: 78px minmax(0, 1fr);
      gap: 22px;
    }
    .v9 .subm {
      margin-right: 6px;
      top: calc(50vh - 30px);
    }
    .v9 .knot {
      left: -28px;
    }
    .v9 .stop {
      min-height: 62vh;
    }
    .v9 .beam {
      height: 220px;
      opacity: 0.7;
    }
    .v9 .floor-grid {
      grid-template-columns: 1fr;
    }
    /* on a phone the floor shows the wreck rather than the empty sand between the two subjects */
    .v9 .floor-art {
      width: 1000px;
      margin-left: calc(100% - 1000px);
      translate: none;
    }
    .v9 .angler {
      width: 78%;
      margin-inline: auto 0;
    }
    .v9 .lure {
      width: 220px;
      height: 220px;
    }
    .v9 .deco-kelp-l {
      left: -90px;
      opacity: 0.4;
    }
    .v9 .deco-kelp-r {
      display: none;
    }
    .v9 .jelly-deco {
      top: -10px;
      opacity: 0.6;
    }
  }
  @media (max-width: 560px) {
    .v9 .plans {
      grid-template-columns: minmax(0, 1fr);
    }
    .v9 .plan-card .for {
      min-height: 0;
    }
    .v9 .top .btn {
      padding: 9px 13px;
      font-size: 13.5px;
    }
    .v9 .logo {
      font-size: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v9 *,
    .v9 *::before,
    .v9 *::after {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const body = document.body;
  body.classList.add('js');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const ease = (v: number) => v * v * (3 - 2 * v);
  const mix = (a: number, b: number, k: number) => a + (b - a) * k;
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)];

  // =====================================================================================
  // Depth. One scroll handler works out how far down we are and moves everything that
  // depends on it: the opening scene, the water colour, the gauge, the whale, parallax.
  // =====================================================================================
  const dive = $('[data-dive]');
  const water = $('[data-water]');
  const sky = $('[data-sky]');
  const glow = $('[data-glow]');
  const rays = $('[data-rays]');
  const lead = $('[data-lead]');
  const beatA = $('[data-beat-a]');
  const beatB = $('[data-beat-b]');
  const manta = $('[data-manta]');
  const kelps = $$('[data-kelp]');
  const cue = $('[data-cue]');
  const depthEl = $('[data-depth]');
  const zoneEl = $('[data-zone]');
  const tape = $('[data-tape]');
  const whaleBand = $('[data-whale-band]');
  const whale = $('[data-whale]');
  const pars = $$('[data-par]');
  const stops = $$('[data-stop]');
  const sub = $('[data-sub]');

  const FLOOR = 3800; // metres at the footer
  let vw = innerWidth;
  let vh = innerHeight;
  let heroScroll = 1;
  let maxScroll = 1;
  let p = 0; // progress through the pinned opening
  let rest = 0; // progress through everything after it
  let waterY = 0; // where the waterline sits in the viewport, in px
  let lastZone = '';

  const depthAt = (y: number) => {
    if (y <= heroScroll) return 60 * clamp((y / heroScroll - 0.1) / 0.9);
    return 60 + (FLOOR - 60) * Math.pow(clamp((y - heroScroll) / Math.max(1, maxScroll - heroScroll)), 1.25);
  };
  const fmt = (m: number) => Math.round(m).toLocaleString('en-GB');

  const stopsRGB: [number, number[]][] = [
    [0, [15, 92, 99]],
    [0.3, [12, 77, 87]],
    [0.55, [8, 54, 66]],
    [0.8, [5, 34, 42]],
    [1, [3, 19, 23]],
  ];
  const waterColour = (k: number) => {
    for (let i = 1; i < stopsRGB.length; i++) {
      const [b, cb] = stopsRGB[i];
      const [a, ca] = stopsRGB[i - 1];
      if (k <= b) {
        const t = (k - a) / (b - a);
        return `rgb(${ca.map((c, j) => Math.round(mix(c, cb[j], t))).join(',')})`;
      }
    }
    return 'rgb(3,19,23)';
  };

  const measure = () => {
    vw = innerWidth;
    vh = innerHeight;
    heroScroll = Math.max(1, dive.offsetHeight - vh);
    maxScroll = Math.max(heroScroll + 1, document.documentElement.scrollHeight - vh);
    // the dive plan in the opening shows how deep each section starts
    $$('[data-depth-of]').forEach((el) => {
      const target = document.querySelector<HTMLElement>(el.dataset.depthOf!);
      if (target) el.textContent = `${fmt(depthAt(target.getBoundingClientRect().top + scrollY))} m`;
    });
  };

  const onScroll = () => {
    const y = scrollY;
    p = clamp(y / heroScroll);
    rest = clamp((y - heroScroll) / (maxScroll - heroScroll));

    // --- opening scene -------------------------------------------------------------
    const under = ease(clamp((p - 0.06) / 0.34)); // the camera going down through the surface
    const skyY = -under * vh * 1.2;
    waterY = vh * 0.68 + skyY;
    if (y < heroScroll + vh) {
      sky.style.transform = `translate3d(0, ${skyY}px, 0)`;
      const leadOut = clamp((p - 0.04) / 0.16);
      lead.style.transform = `translate3d(0, ${skyY * 0.85}px, 0)`;
      lead.style.opacity = String(1 - leadOut);
      lead.style.pointerEvents = leadOut > 0.6 ? 'none' : '';
      cue.style.opacity = p > 0.015 ? '0' : '1';

      const lightIn = ease(clamp((p - 0.1) / 0.16));
      rays.style.opacity = String(lightIn * (1 - ease(clamp((p - 0.5) / 0.26))));
      rays.style.transform = `translate3d(0, ${Math.max(waterY, 0)}px, 0)`;
      glow.style.opacity = String(lightIn * (1 - ease(clamp((p - 0.56) / 0.4))) * 0.9);
      glow.style.transform = `translate3d(0, ${Math.max(waterY, 0)}px, 0)`;

      const aIn = ease(clamp((p - 0.3) / 0.1));
      const aOut = ease(clamp((p - 0.54) / 0.08));
      beatA.style.opacity = String(aIn * (1 - aOut));
      beatA.style.transform = `translate(-50%, calc(-50% + ${(1 - aIn) * 50 - aOut * 60}px))`;
      const bIn = ease(clamp((p - 0.68) / 0.12));
      beatB.style.opacity = String(bIn);
      beatB.style.transform = `translate(-50%, calc(-50% + ${(1 - bIn) * 50}px))`;
      beatB.style.pointerEvents = bIn > 0.6 ? 'auto' : 'none';

      const km = clamp((p - 0.4) / 0.6);
      const mw = manta.offsetWidth;
      manta.style.opacity = String(Math.min(1, km * 8) * 0.92);
      manta.style.transform = `translate3d(${mix(vw + 20, -mw - 20, km)}px, ${vh * (0.1 + 0.16 * Math.sin(km * 4.2)) + (vw < 820 ? vh * 0.5 : 0)}px, 0) rotate(${Math.cos(km * 4.2) * 7}deg)`;
      const kk = ease(clamp((p - 0.48) / 0.36));
      kelps.forEach((k, i) => (k.style.transform = `translateY(${(1 - kk) * 105}%) rotate(${Math.sin(p * 9 + i) * 1.5}deg)`));
    }

    // --- water, header, gauge ---------------------------------------------------------
    water.style.backgroundColor = waterColour(p < 1 ? p * 0.12 : 0.12 + rest * 0.88);
    body.classList.toggle('under', waterY < 78);
    const d = depthAt(y);
    depthEl.textContent = fmt(d);
    tape.style.backgroundPosition = `right 0 top ${-(d * 1.6) % 60}px, right 0 top ${-(d * 1.6) % 60}px`;
    const zone = d < 1 ? 'Surface' : d < 200 ? 'Sunlight zone' : d < 1000 ? 'Twilight zone' : d < FLOOR - 40 ? 'Midnight zone' : 'Sea floor';
    if (zone !== lastZone) zoneEl.textContent = lastZone = zone;

    // --- the whale crosses while its band is on screen -------------------------------------
    const wr = whaleBand.getBoundingClientRect();
    if (wr.bottom > -200 && wr.top < vh + 200) {
      const k = clamp((vh - wr.top) / (vh + wr.height));
      whale.style.transform = `translate3d(${mix(0.62, -0.62, k) * Math.max(vw, 900)}px, ${Math.sin(k * 5) * 26}px, 0) rotate(${Math.sin(k * 5 + 1) * 2.5}deg)`;
    }

    // --- parallax layers ---------------------------------------------------------------
    for (const el of pars) {
      const host = el.parentElement!.getBoundingClientRect();
      if (host.bottom < -400 || host.top > vh + 400) continue;
      el.style.translate = `0 ${(host.top + host.height / 2 - vh / 2) * -Number(el.dataset.par)}px`;
    }

    // --- the stop nearest the submersible is the lit one ---------------------------------
    const sr = sub.getBoundingClientRect();
    const subMid = sr.top + sr.height / 2;
    let best = -1;
    let bestD = Infinity;
    stops.forEach((s, i) => {
      const r = s.getBoundingClientRect();
      const dist = Math.abs(r.top + r.height / 2 - subMid);
      if (dist < bestD) [bestD, best] = [dist, i];
    });
    stops.forEach((s, i) => s.classList.toggle('lit', i === best && bestD < vh * 0.6));
  };

  measure();
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', () => {
    measure();
    onScroll();
  });
  addEventListener('load', () => {
    measure();
    onScroll();
  });
  // fonts and lazy images change the page height, so measure again once things settle
  setTimeout(() => (measure(), onScroll()), 1500);

  // =====================================================================================
  // The living layer: marine snow, bubbles, jellyfish and a school of fish on one fixed
  // canvas. The school is a boids flock that steers away from the cursor and scatters
  // when the page is scrolled fast.
  // =====================================================================================
  const sea = $('[data-sea]') as unknown as HTMLCanvasElement;
  const ctx = sea.getContext('2d')!;
  let sw = 0;
  let sh = 0;
  const sizeSea = () => {
    const dpr = Math.min(devicePixelRatio || 1, innerWidth < 820 ? 1.5 : 2);
    sw = innerWidth;
    sh = innerHeight;
    sea.width = Math.round(sw * dpr);
    sea.height = Math.round(sh * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  };
  sizeSea();
  addEventListener('resize', sizeSea);

  const small = sw < 820;
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  const fish = Array.from({ length: small ? 34 : 78 }, () => {
    const a = rnd(0, Math.PI * 2);
    return { x: rnd(0, sw), y: rnd(sh * 0.74, sh * 0.96), vx: Math.cos(a) * 1.2, vy: Math.sin(a) * 0.4, s: rnd(5, 9.5), ph: rnd(0, 6.28), al: rnd(0.5, 0.95) };
  });
  const snow = Array.from({ length: small ? 46 : 110 }, () => ({ x: rnd(0, sw), y: rnd(0, sh), z: rnd(0.12, 0.7), r: rnd(0.5, 1.7), ph: rnd(0, 6.28) }));
  const bubbles = Array.from({ length: small ? 9 : 18 }, () => ({ x: rnd(0, sw), y: rnd(0, sh), r: rnd(1.5, 5), v: rnd(0.35, 1.1), ph: rnd(0, 6.28) }));
  const jellyImgs = ['/art/v9/jelly-a.webp', '/art/v9/jelly-b.webp'].map((src) => {
    const im = new Image();
    im.src = src;
    return im;
  });
  const lanes = [0.045, 0.94, 0.1, 0.895];
  const jellyX = (lane: number) => (small ? rnd(0.08, 0.92) : lanes[lane % 4] + rnd(-0.012, 0.012)) * sw;
  const jellies = Array.from({ length: small ? 3 : 4 }, (_, i) => ({
    x: jellyX(i),
    y: (0.15 + i * 0.33 + rnd(0, 0.1)) * sh,
    w: small ? rnd(54, 84) : rnd(84, 150),
    img: i % 3 === 1 ? 1 : 0,
    ph: rnd(0, 6.28),
    side: i,
  }));

  const mouse = { x: -9999, y: -9999 };
  addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch') return;
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });
  document.addEventListener('pointerleave', () => (mouse.x = mouse.y = -9999));

  let lastY = scrollY;
  let lastT = 0;
  let panic = 0;

  const swim = (now: number) => {
    const t = now / 1000;
    const dt = clamp((now - lastT) / 16.7, 0.2, 3) || 1;
    lastT = now;
    const dy = scrollY - lastY;
    lastY = scrollY;
    if (Math.abs(dy) > 26) panic = Math.min(1, panic + Math.abs(dy) / 90);
    panic *= Math.pow(0.965, dt);

    ctx.clearRect(0, 0, sw, sh);
    const top = Math.max(waterY, -60); // nothing lives above the waterline
    const deep = p < 1 ? ease(clamp((p - 0.12) / 0.5)) : 1; // 0 = ink at the surface, 1 = pale in the dark

    // marine snow: moves up as we go down, faster for nearer flakes
    for (const s of snow) {
      s.y -= dy * s.z + 0.06 * dt * s.z;
      s.x += Math.sin(t * 0.3 + s.ph) * 0.12;
      if (s.y < -10) s.y += sh + 20;
      if (s.y > sh + 10) s.y -= sh + 20;
      if (s.y < top + 6) continue;
      ctx.globalAlpha = (0.12 + s.z * 0.5) * mix(0.5, 1, deep);
      ctx.fillStyle = '#e9f7f3';
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r * (0.6 + s.z), 0, 6.283);
      ctx.fill();
    }

    // bubbles
    ctx.lineWidth = 1;
    for (const b of bubbles) {
      b.y -= (b.v * dt + dy * 0.85) * 1;
      b.x += Math.sin(t * 1.6 + b.ph) * 0.35;
      if (b.y < top + 4 || b.y < -20) {
        b.y = sh + rnd(10, 160);
        b.x = rnd(0, sw);
      } else if (b.y > sh + 200) b.y = top + 20;
      ctx.globalAlpha = 0.5;
      ctx.strokeStyle = '#e9f7f3';
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r, 0, 6.283);
      ctx.stroke();
      ctx.globalAlpha = 0.6;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(b.x - b.r * 0.35, b.y - b.r * 0.35, b.r * 0.22, 0, 6.283);
      ctx.fill();
    }

    // jellyfish: each pulse squeezes the bell and pushes it up a little
    const jellyAlpha = (p < 1 ? ease(clamp((p - 0.5) / 0.2)) : 1) * (small ? 0.34 : 0.8);
    if (jellyAlpha > 0.01) {
      for (const j of jellies) {
        const im = jellyImgs[j.img];
        const beat = t * 1.25 + j.ph;
        const squeeze = Math.sin(beat);
        j.y -= (0.1 + 0.42 * Math.max(0, Math.sin(beat - 0.9))) * dt + dy * 0.45;
        j.x += Math.sin(t * 0.22 + j.ph) * 0.1;
        const hgt = j.w * 1.5;
        if (j.y < -hgt - 20) {
          j.y = sh + 20;
          j.x = jellyX(j.side);
        } else if (j.y > sh + hgt) j.y = -hgt;
        if (!im.complete || !im.naturalWidth) continue;
        ctx.globalAlpha = jellyAlpha;
        const wx = j.w * (1 + squeeze * 0.07);
        ctx.save();
        ctx.translate(j.x, j.y);
        ctx.rotate(Math.sin(t * 0.3 + j.ph) * 0.08);
        ctx.drawImage(im, -wx / 2, 0, wx, hgt * (1 - squeeze * 0.05));
        ctx.restore();
      }
    }

    // the school
    const n = fish.length;
    const tx = sw * (0.5 + 0.42 * Math.sin(t * 0.11 + 3.5)); // a slow wandering point the school follows
    const ty = Math.max(top + 70, sh * (0.5 + 0.34 * Math.sin(t * 0.17 + 1)));
    const maxV = 1.9 + panic * 5.5;
    for (let i = 0; i < n; i++) {
      const f = fish[i];
      let cx = 0, cy = 0, ax = 0, ay = 0, sx = 0, sy = 0, c = 0;
      for (let k = 0; k < n; k++) {
        if (k === i) continue;
        const o = fish[k];
        const dx = o.x - f.x;
        const dyy = o.y - f.y;
        const d2 = dx * dx + dyy * dyy;
        if (d2 > 6400) continue;
        c++;
        cx += dx;
        cy += dyy;
        ax += o.vx;
        ay += o.vy;
        if (d2 < 520) {
          const d = Math.sqrt(d2) || 1;
          sx -= dx / d;
          sy -= dyy / d;
        }
      }
      if (c) {
        f.vx += ((cx / c) * 0.0009 * (1 - panic) + (ax / c - f.vx) * 0.045 + sx * 0.09) * dt;
        f.vy += ((cy / c) * 0.0009 * (1 - panic) + (ay / c - f.vy) * 0.045 + sy * 0.09) * dt;
      }
      f.vx += (tx - f.x) * 0.00016 * dt;
      f.vy += (ty - f.y) * 0.00022 * dt;
      // the cursor is a predator
      const mx = f.x - mouse.x;
      const my = f.y - mouse.y;
      const md = mx * mx + my * my;
      if (md < 22000) {
        const d = Math.sqrt(md) || 1;
        const force = (1 - md / 22000) * 0.9;
        f.vx += (mx / d) * force * dt;
        f.vy += (my / d) * force * dt;
      }
      if (panic > 0.3 && Math.abs(dy) > 26) {
        const a = rnd(0, 6.283);
        f.vx += Math.cos(a) * 2.6;
        f.vy += Math.sin(a) * 2.6;
      }
      if (f.y < top + 46) f.vy += 0.22 * dt;
      if (f.y > sh - 30 && top > 0) f.vy -= 0.12 * dt;
      const v = Math.hypot(f.vx, f.vy) || 1;
      const lim = v > maxV ? maxV / v : v < 0.75 ? 0.75 / v : 1;
      f.vx *= lim;
      f.vy *= lim;
      f.x += f.vx * dt;
      f.y += f.vy * dt - dy * 0.3;
      if (f.x < -40) f.x = sw + 30;
      if (f.x > sw + 40) f.x = -30;
      if (f.y < top + 10) f.y = top > 0 ? top + 10 : f.y < -60 ? sh + 40 : f.y;
      if (f.y > sh + 60) f.y = top > 0 ? sh - 10 : -40;

      const wig = Math.sin(t * 9 + f.ph) * 0.5;
      ctx.save();
      ctx.translate(f.x, f.y);
      ctx.rotate(Math.atan2(f.vy, f.vx));
      ctx.globalAlpha = f.al * mix(0.82, small ? 0.5 : 0.78, deep);
      ctx.fillStyle = `rgb(${Math.round(mix(8, 190, deep))},${Math.round(mix(38, 240, deep))},${Math.round(mix(43, 228, deep))})`;
      const s = f.s;
      ctx.beginPath();
      ctx.moveTo(s, 0);
      ctx.quadraticCurveTo(0, -s * 0.48, -s * 0.75, wig);
      ctx.lineTo(-s * 1.35, -s * 0.36 + wig * 2.4);
      ctx.lineTo(-s * 1.2, s * 0.4 + wig * 2.4);
      ctx.lineTo(-s * 0.75, wig);
      ctx.quadraticCurveTo(0, s * 0.42, s, 0);
      ctx.fill();
      ctx.restore();
    }
    ctx.globalAlpha = 1;
    if (!reduced) requestAnimationFrame(swim);
  };
  requestAnimationFrame(swim);
  if (reduced) addEventListener('scroll', () => requestAnimationFrame(swim), { passive: true });

  // =====================================================================================
  // Reveals, service tabs, demos, form.
  // =====================================================================================
  const rv = $$('.rv');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
      { rootMargin: '0px 0px -8% 0px' },
    );
    rv.forEach((el) => io.observe(el));
  } else rv.forEach((el) => el.classList.add('in'));

  // services: a tab list on the left, one panel on the right
  const tabs = $$<HTMLButtonElement>('[data-tab]');
  const panels = $$('[data-panel]');
  const pick = (id: string, scroll = false) => {
    tabs.forEach((b) => {
      const on = b.dataset.tab === id;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
    });
    panels.forEach((pn) => (pn.hidden = pn.dataset.panel !== id));
    if (scroll && innerWidth < 820) $('.svc-panels').scrollIntoView({ block: 'nearest', behavior: reduced ? 'auto' : 'smooth' });
  };
  tabs.forEach((b, i) => {
    b.addEventListener('click', () => pick(b.dataset.tab!, true));
    b.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && pick(b.dataset.tab!));
    b.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      pick(next.dataset.tab!);
    });
  });
  if (tabs[0]) pick(tabs[0].dataset.tab!);

  // demos: steps appear one after another when the panel scrolls into view
  $$('[data-demo]').forEach((panel) => {
    const steps = [...panel.querySelectorAll<HTMLElement>('[data-s]')];
    const cells = [...panel.querySelectorAll<HTMLElement>('[data-cells] i')];
    const rate = panel.querySelector<HTMLElement>('[data-rate]');
    let timers: number[] = [];
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const finish = () => {
      steps.forEach((s) => s.classList.add('on'));
      cells.forEach((c) => c.classList.add('done'));
      panel.classList.add('done');
    };
    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      panel.classList.remove('done');
      steps.forEach((s) => s.classList.remove('on'));
      cells.forEach((c) => c.classList.remove('done'));
      if (rate) rate.textContent = '0.0';
      let at = 300;
      for (const s of steps) {
        at += Number(s.dataset.d ?? 650);
        later(() => s.classList.add('on'), at);
        if (s.hasAttribute('data-cells')) {
          // the test set runs case by case and the pass rate follows it
          let pass = 0;
          cells.forEach((c, i) => {
            const ok = !c.classList.contains('bad');
            later(() => {
              c.classList.add('done');
              if (ok) pass++;
              if (rate) rate.textContent = ((pass / (i + 1)) * 100).toFixed(1);
            }, at + 150 + i * 20);
          });
        }
      }
      later(() => panel.classList.add('done'), at + 600);
    };
    if (reduced || !('IntersectionObserver' in window)) return finish();
    const io = new IntersectionObserver(
      (es) => {
        if (es[0].isIntersecting) {
          play();
          io.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(panel);
    panel.querySelector('[data-replay]')?.addEventListener('click', play);
  });

  // the live chart: response time wandering under its budget line
  const spark = document.querySelector<HTMLCanvasElement>('[data-spark]');
  if (spark) {
    const c = spark.getContext('2d')!;
    const pts = Array.from({ length: 60 }, (_, i) => 1.7 + Math.sin(i * 0.5) * 0.18);
    const p95 = $('[data-live="p95"]');
    const cost = $('[data-live="cost"]');
    let visible = false;
    let tick = 0;
    const drawSpark = () => {
      const W = spark.width;
      const H = spark.height;
      c.clearRect(0, 0, W, H);
      const yOf = (v: number) => H - ((v - 0.8) / 2.2) * H;
      c.setLineDash([5, 6]);
      c.strokeStyle = 'rgba(255,143,163,.8)';
      c.lineWidth = 1.5;
      c.beginPath();
      c.moveTo(0, yOf(2.5));
      c.lineTo(W, yOf(2.5));
      c.stroke();
      c.setLineDash([]);
      c.beginPath();
      pts.forEach((v, i) => {
        const x = (i / (pts.length - 1)) * W;
        i ? c.lineTo(x, yOf(v)) : c.moveTo(x, yOf(v));
      });
      c.strokeStyle = '#6ff5e0';
      c.lineWidth = 2.5;
      c.lineJoin = 'round';
      c.stroke();
      c.lineTo(W, H);
      c.lineTo(0, H);
      const g = c.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, 'rgba(111,245,224,.28)');
      g.addColorStop(1, 'rgba(111,245,224,0)');
      c.fillStyle = g;
      c.fill();
      c.fillStyle = '#6ff5e0';
      c.beginPath();
      c.arc(W - 4, yOf(pts[pts.length - 1]), 4, 0, 6.283);
      c.fill();
    };
    drawSpark();
    if (!reduced) {
      new IntersectionObserver((es) => (visible = es[0].isIntersecting)).observe(spark);
      setInterval(() => {
        if (!visible) return;
        tick++;
        const spike = tick % 23 === 0 ? 0.55 : 0; // now and then a slow call, still under budget
        const next = clamp(pts[pts.length - 1] * 0.6 + 1.75 * 0.4 + (Math.random() - 0.5) * 0.3 + spike, 1.2, 2.42);
        pts.push(next);
        pts.shift();
        drawSpark();
        if (tick % 4 === 0) {
          p95.textContent = (Math.max(...pts.slice(-20)) - 0.1).toFixed(1);
          cost.textContent = (0.0118 + Math.random() * 0.0012).toFixed(3);
        }
      }, 260);
    }
  }

  // contact: build a mailto link, nothing leaves the page
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const picked = fd.getAll('topic').join(', ');
    const lines = [String(fd.get('message') || ''), '', `Name: ${fd.get('name')}`, `Email: ${fd.get('email')}`];
    if (picked) lines.push(`About: ${picked}`);
    const subject = `Project enquiry from ${fd.get('name')}`;
    location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
  });
</script>
