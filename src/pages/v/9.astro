    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid rgba(255, 143, 163, 0.5);
    background: rgba(255, 143, 163, 0.08);
    font-family: var(--sans);
    font-size: 15px;
    color: var(--foam);
  }
  .v9 .ask-h {
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
