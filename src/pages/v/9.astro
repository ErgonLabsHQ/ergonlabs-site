  .v9 .cap {
    margin-top: 14px;
    color: var(--mute);
    font-size: 15.5px;
    max-width: 50ch;
  }

  .v9 .panel {
    position: relative;
    border: 1px solid rgba(111, 245, 224, 0.26);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(3, 26, 31, 0.93), rgba(2, 18, 22, 0.93));
    box-shadow: 0 0 0 5px rgba(111, 245, 224, 0.04), 0 30px 80px -30px rgba(0, 0, 0, 0.7), 0 0 70px -10px rgba(111, 245, 224, 0.16);
    font: 400 13.5px/1.5 var(--mono);
    color: #cfe9e1;
  }
  .v9 .panel::before,
  .v9 .panel::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
