---
// Version 13, "Nuvareth Sage": forest green, sage and warm cream; calm consultancy feel. Hero has soft drifting
// colour fields with glass cards that move at different speeds as you scroll (parallax). The demo is an assistant
// answering from company documents with citations. The process is a vertical timeline that fills with scroll.
import Variant from '../../../layouts/Variant.astro';
import Shell from '../../../components/nv/Shell.astro';
import { brand, process } from '../../../nuvareth';
const fonts =
  'https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=DM+Mono:wght@400;500&display=swap';

const answer =
  'Yes. Employees in the Prague office can carry over up to 5 unused days into the next year [1]. Carried-over days must be used by 31 March, after which they lapse [2]. Managers can approve an exception for parental leave [3].';
const sources = [
  { n: 1, t: 'Employee Handbook 2026', p: 'Section 6.3, page 41' },
  { n: 2, t: 'HR Policy: Leave and Absence', p: 'Updated 14 Feb 2026' },
  { n: 3, t: 'Parental Leave Guidelines', p: 'Clause 2.1' },
];
---

<Variant n={13} fonts={fonts} title={`${brand.name} — ${brand.headline}`} icon="/nv-favicon.svg">
  <Shell v={13}>
    <section slot="hero" class="hero" data-hero>
      <div class="orbs" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="nv-wrap grid">
        <div class="copy">
          <p class="nv-label" data-rise style="--d:0">AI engineering firm</p>
          <h1 data-rise style="--d:1">Engineering the Next Era of Intelligence.</h1>
          <p class="sub" data-rise style="--d:2">{brand.intro}</p>
          <div class="actions" data-rise style="--d:3">
            <a class="nv-btn" href="#contact">Book a first call</a>
            <a class="nv-btn ghost" href="#ai">How we build</a>
          </div>
        </div>
        <div class="float" aria-hidden="true">
          <div class="g g1" data-speed="0.12">
            <p class="gk">Answer</p>
            <p>Carry-over is capped at 5 days <span class="cite">1</span></p>
            <p class="gs">Cited from Employee Handbook, p. 41</p>
          </div>
          <div class="g g2" data-speed="-0.08">
            <p class="gk">Routed to a person</p>
            <p>Confidence 0.41, below threshold</p>
          </div>
          <div class="g g3" data-speed="0.22">
            <p class="gk">Cost per task</p>
            <p class="big">$0.004</p>
            <p class="gs">target $0.01 · within budget</p>
          </div>
          <div class="g g4" data-speed="-0.16">
            <p class="gk">Eval suite</p>
            <p class="big">212 / 212</p>
            <p class="gs">cases run on this change</p>
          </div>
        </div>
      </div>
    </section>

    <div slot="demo" class="chat" data-chat>
      <div class="chat-main">
        <div class="msg me">Can I carry over unused holiday into next year?</div>
        <div class="search" data-c="1">
          <span class="spin"></span> Searching 1,284 documents you have access to
        </div>
        <div class="found" data-c="2">
          {sources.map((s) => <span>{s.t}</span>)}
        </div>
        <div class="msg ai" data-c="3">
          <p data-answer data-full={answer}></p>
        </div>
      </div>
      <aside class="chat-src">
        <p class="nv-label">Sources</p>
        <ol>
          {sources.map((s) => (
            <li data-src={s.n}>
              <span class="n">{s.n}</span>
              <span><b>{s.t}</b><small>{s.p}</small></span>
            </li>
          ))}
        </ol>
        <p class="note">Every answer links to the passage it came from. If the documents do not say, the assistant says so.</p>
      </aside>
    </div>

    <section slot="process" class="nv-section tl" id="process" data-tl>
      <div class="nv-wrap tl-in">
        <div class="tl-head">
          <p class="nv-label">Process</p>
          <h2>Four stages, from first call to production.</h2>
          <p class="nv-lede">A predictable path, with something working in your hands from week two.</p>
        </div>
        <ol class="tl-list">
          <span class="tl-rail" aria-hidden="true"><i data-tl-fill></i></span>
          {process.map((p, i) => (
            <li data-tl-item>
              <span class="dot" aria-hidden="true"></span>
              <p class="when">{p.time}</p>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </Shell>
</Variant>

<style is:global>
  .v13 {
    --bg: #f4f1e8;
    --surface: #fbfaf5;
    --fg: #13291f;
    --muted: #55665c;
    --line: rgba(19, 41, 31, 0.12);
    --accent: #1d6b4f;
    --accent-fg: #fff;
    --accent-soft: rgba(29, 107, 79, 0.1);
    --inv-bg: #10251c;
    --inv-fg: #eef1e8;
    --inv-muted: rgba(238, 241, 232, 0.64);
    --inv-line: rgba(238, 241, 232, 0.14);
    --display: 'Manrope', system-ui, sans-serif;
    --body: 'Manrope', system-ui, sans-serif;
    --mono: 'DM Mono', ui-monospace, monospace;
    --h-weight: 700;
    --h-track: -0.035em;
    --radius: 20px;
    --shadow: 0 1px 2px rgba(19, 41, 31, 0.04), 0 18px 40px -24px rgba(19, 41, 31, 0.25);
    --sage: #c9d8c5;
    --clay: #d98e5f;
  }
  .v13 .nv-btn {
    border-radius: 999px;
    background: var(--fg);
  }
  .v13 .nv-btn.ghost {
    background: transparent;
    border-color: var(--line);
  }
  .v13 .nv-ai .nv-label,
  .v13 .nv-contact .nv-label {
    color: #9fd3b5;
  }
  .v13 .nv-services > li:first-child {
    background: var(--fg);
    color: var(--inv-fg);
  }
  .v13 .nv-services > li:first-child p {
    color: var(--inv-muted);
  }
  .v13 .nv-services > li:first-child .nv-num {
    color: #9fd3b5;
  }
  .v13 .nv-services > li:first-child .nv-chips li {
    border-color: var(--inv-line);
  }
  .v13 .nv-chips li {
    background: var(--bg);
    border-color: transparent;
  }
  .v13 .nv-plans > li.featured {
    background: var(--sage);
    border-color: transparent;
    box-shadow: var(--shadow);
  }
  .v13 .nv-badge {
    background: var(--fg);
  }
  .v13 .nv-mark {
    border-radius: 50%;
    background: var(--fg);
  }

  /* hero */
  .v13 .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(130px, 17vh, 180px) 0 clamp(70px, 10vh, 120px);
  }
  .v13 .orbs i {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.75;
    animation: v13-drift 18s ease-in-out infinite alternate;
  }
  .v13 .orbs i:nth-child(1) {
    width: 560px;
    height: 560px;
    right: -80px;
    top: -120px;
    background: #b8d4be;
  }
  .v13 .orbs i:nth-child(2) {
    width: 420px;
    height: 420px;
    right: 22%;
    bottom: -160px;
    background: #efcfb3;
    animation-duration: 22s;
  }
  .v13 .orbs i:nth-child(3) {
    width: 300px;
    height: 300px;
    right: 10%;
    top: 35%;
    background: #9cc7b2;
    animation-duration: 26s;
  }
  @keyframes v13-drift {
    to {
      transform: translate(-60px, 40px) scale(1.08);
    }
  }
  .v13 .hero .grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 40px;
    align-items: center;
  }
  .v13 .hero .copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .v13 .hero h1 {
    font-size: clamp(44px, 5.8vw, 86px);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .v13 .sub {
    font-size: clamp(17px, 1.35vw, 19.5px);
    color: var(--muted);
    max-width: 50ch;
  }
  .v13 .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .v13 .float {
    position: relative;
    height: 480px;
  }
  .v13 .g {
    position: absolute;
    padding: 16px 18px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 20px 50px -24px rgba(19, 41, 31, 0.35);
    font-size: 15px;
    font-weight: 600;
    will-change: transform;
  }
  .v13 .gk {
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .v13 .gs {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted);
    margin-top: 4px;
  }
  .v13 .big {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .v13 .cite {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    vertical-align: 2px;
  }
  .v13 .g1 {
    top: 6%;
    left: 0;
    width: 300px;
  }
  .v13 .g2 {
    top: 2%;
    right: 0;
    width: 200px;
  }
  .v13 .g3 {
    top: 44%;
    right: 4%;
    width: 220px;
  }
  .v13 .g4 {
    top: 58%;
    left: 6%;
    width: 220px;
  }
  .nv-js .v13 [data-rise] {
    opacity: 0;
    transform: translateY(14px);
    animation: v13-rise 0.9s var(--ease) forwards;
    animation-delay: calc(var(--d) * 110ms + 100ms);
  }
  @keyframes v13-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 980px) {
    .v13 .hero .grid {
      grid-template-columns: 1fr;
    }
    .v13 .float {
      height: 380px;
      max-width: 560px;
    }
  }
  @media (max-width: 520px) {
    .v13 .g1 {
      width: 250px;
    }
    .v13 .g2 {
      display: none;
    }
  }

  /* chat demo */
  .v13 .chat {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: 16px;
  }
  .v13 .chat-main,
  .v13 .chat-src {
    border-radius: 22px;
    padding: clamp(18px, 2.4vw, 30px);
  }
  .v13 .chat-main {
    background: var(--surface);
    color: var(--fg);
    display: grid;
    gap: 14px;
    align-content: start;
    min-height: 400px;
  }
  .v13 .msg {
    max-width: 82%;
    padding: 14px 18px;
    border-radius: 18px;
    font-size: 16px;
    line-height: 1.55;
  }
  .v13 .msg.me {
    justify-self: end;
    background: var(--fg);
    color: #fff;
    border-bottom-right-radius: 6px;
  }
  .v13 .msg.ai {
    background: var(--bg);
    border-bottom-left-radius: 6px;
    min-height: 3em;
  }
  .v13 .msg.ai sup {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin: 0 2px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1;
    vertical-align: 3px;
  }
  .v13 .search {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 13px/1.4 var(--mono);
    color: var(--muted);
  }
  .v13 .spin {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--line);
    border-top-color: var(--accent);
    animation: v13-spin 0.8s linear infinite;
  }
  .v13 .chat.searched .spin {
    animation: none;
    border-color: var(--accent);
    background: var(--accent);
  }
  @keyframes v13-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .v13 .found {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .v13 .found span {
    font-size: 13px;
    font-weight: 600;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .nv-js .v13 [data-c] {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
  }
  .nv-js .v13 [data-c].on {
    opacity: 1;
    transform: none;
  }
  .v13 .chat-src {
    border: 1px solid var(--inv-line);
  }
  .v13 .chat-src ol {
    list-style: none;
    margin: 16px 0 20px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .v13 .chat-src li {
    display: flex;
    gap: 12px;
    padding: 12px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid transparent;
    transition: border-color 0.3s, background 0.3s;
  }
  .v13 .chat-src li.hit {
    border-color: rgba(159, 211, 181, 0.6);
    background: rgba(159, 211, 181, 0.08);
  }
  .v13 .chat-src .n {
    flex: none;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #9fd3b5;
    color: var(--fg);
    font-size: 12px;
    font-weight: 700;
  }
  .v13 .chat-src b {
    display: block;
    font-size: 14.5px;
  }
  .v13 .chat-src small {
    color: var(--inv-muted);
    font-size: 12.5px;
  }
  .v13 .note {
    font-size: 14px;
    color: var(--inv-muted);
  }
  @media (max-width: 900px) {
    .v13 .chat {
      grid-template-columns: 1fr;
    }
    .v13 .msg {
      max-width: 100%;
    }
  }

  /* timeline */
  .v13 .tl-in {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
  }
  .v13 .tl-head {
    display: grid;
    gap: 18px;
    position: sticky;
    top: 110px;
  }
  .v13 .tl-head h2 {
    font-size: clamp(34px, 4.4vw, 60px);
  }
  .v13 .tl-list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 48px;
    display: grid;
    gap: clamp(40px, 7vh, 80px);
  }
  .v13 .tl-rail {
    position: absolute;
    left: 11px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--line);
  }
  .v13 .tl-rail i {
    display: block;
    width: 100%;
    height: calc(var(--p, 0) * 100%);
    background: var(--accent);
  }
  .v13 .tl-list li {
    position: relative;
    opacity: 0.4;
    transition: opacity 0.4s;
  }
  .v13 .tl-list li.lit {
    opacity: 1;
  }
  .v13 .dot {
    position: absolute;
    left: -48px;
    top: 4px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
    transition: background 0.3s, border-color 0.3s;
  }
  .v13 .tl-list li.lit .dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 6px var(--accent-soft);
  }
  .v13 .when {
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 8px 0 12px;
  }
  .v13 .tl-list h3 {
    font-size: clamp(30px, 3vw, 44px);
    margin-bottom: 10px;
  }
  .v13 .tl-list p:last-child {
    color: var(--muted);
    max-width: 50ch;
    font-size: 17px;
  }
  @media (max-width: 860px) {
    .v13 .tl-in {
      grid-template-columns: 1fr;
    }
    .v13 .tl-head {
      position: static;
    }
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // hero parallax: cards drift at their own speeds as the page scrolls
  const floats = [...document.querySelectorAll<HTMLElement>('[data-speed]')];
  // timeline fill
  const tl = document.querySelector<HTMLElement>('[data-tl]')!;
  const fill = tl.querySelector<HTMLElement>('[data-tl-fill]')!;
  const items = [...tl.querySelectorAll<HTMLElement>('[data-tl-item]')];
  const list = tl.querySelector<HTMLElement>('.tl-list')!;

  const onScroll = () => {
    const y = scrollY;
    if (!reduced) floats.forEach((f) => (f.style.transform = `translate3d(0, ${-y * Number(f.dataset.speed)}px, 0)`));
    const r = list.getBoundingClientRect();
    const mid = innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
    fill.style.setProperty('--p', String(p));
    items.forEach((it) => it.classList.toggle('lit', it.getBoundingClientRect().top < mid));
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // chat: question, search, sources, then the answer streams in with citations
  const chat = document.querySelector<HTMLElement>('[data-chat]')!;
  const steps = [...chat.querySelectorAll<HTMLElement>('[data-c]')];
  const ans = chat.querySelector<HTMLElement>('[data-answer]')!;
  const full = ans.dataset.full!;
  const srcs = [...chat.querySelectorAll<HTMLElement>('[data-src]')];
  const fmt = (s: string) => s.replace(/\[(\d)\]/g, '<sup>$1</sup>');
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  const run = async () => {
    if (reduced) {
      steps.forEach((s) => s.classList.add('on'));
      chat.classList.add('searched');
      ans.innerHTML = fmt(full);
      return;
    }
    while (true) {
      steps.forEach((s) => s.classList.remove('on'));
      chat.classList.remove('searched');
      srcs.forEach((s) => s.classList.remove('hit'));
      ans.innerHTML = '';
      await wait(700);
      steps[0].classList.add('on');
      await wait(1400);
      chat.classList.add('searched');
      steps[1].classList.add('on');
      await wait(700);
      steps[2].classList.add('on');
      const words = full.split(' ');
      for (let i = 1; i <= words.length; i++) {
        const shown = words.slice(0, i).join(' ');
        ans.innerHTML = fmt(shown);
        const m = words[i - 1].match(/\[(\d)\]/);
        if (m) srcs[Number(m[1]) - 1]?.classList.add('hit');
        await wait(55);
      }
      await wait(5000);
    }
  };
  new IntersectionObserver(
    ([e], obs) => {
      if (e.isIntersecting) {
        obs.disconnect();
        run();
      }
    },
    { threshold: 0.3 },
  ).observe(chat);
</script>
