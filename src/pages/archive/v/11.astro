---
// Version 11, "Nuvareth Midnight": deep navy, electric blue and teal. Hero is a slow network field that reacts to
// the pointer. The demo is a live terminal that types out an agent run with cost and latency counters. The process
// section is pinned and scrolls sideways.
import Variant from '../../../layouts/Variant.astro';
import Shell from '../../../components/nv/Shell.astro';
import { brand, process } from '../../../nuvareth';
const fonts =
  'https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500..700&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap';

const term = [
  { c: 'prompt', t: '$ nuvareth run support-triage --queue=inbound' },
  { c: 'dim', t: 'loading policy v14 · 212 eval cases · budget $0.02/ticket' },
  { c: 'step', t: '→ read     ticket #48211 "Refund for duplicate charge"' },
  { c: 'step', t: '→ tool     billing.find_charges(customer=C-1043)' },
  { c: 'ok', t: '  ✓ 2 identical charges found, 3 minutes apart' },
  { c: 'step', t: '→ check    refund policy §4.2 (duplicates)' },
  { c: 'ok', t: '  ✓ eligible, under auto-approve limit' },
  { c: 'step', t: '→ action   billing.refund(charge=ch_9f2, draft=true)' },
  { c: 'warn', t: '! hold     amount above $500 → routed to a person' },
  { c: 'done', t: '✓ done     reply drafted, trail logged, 1.8s' },
];
---

<Variant n={11} fonts={fonts} title={`${brand.name} — ${brand.headline}`} icon="/nv-favicon.svg">
  <Shell v={11}>
    <section slot="hero" class="hero" data-hero>
      <canvas class="field" data-field aria-hidden="true"></canvas>
      <div class="glow" aria-hidden="true"></div>
      <div class="nv-wrap inner">
        <p class="pill" data-rise style="--d:0">AI engineering firm · {brand.location}</p>
        <h1 data-rise style="--d:1">Engineering the Next Era of <span class="grad">Intelligence</span>.</h1>
        <p class="sub" data-rise style="--d:2">{brand.intro}</p>
        <div class="actions" data-rise style="--d:3">
          <a class="nv-btn" href="#contact">Start a project <span aria-hidden="true">→</span></a>
          <a class="nv-btn ghost" href="#ai">See it in production</a>
        </div>
      </div>
    </section>

    <div slot="demo" class="term-wrap" data-term>
      <div class="term">
        <div class="term-bar">
          <span class="d"></span><span class="d"></span><span class="d"></span>
          <span class="term-title">agent · support-triage</span>
          <span class="live"><i></i>example run</span>
        </div>
        <pre class="term-body" data-term-body aria-label="An example agent run">{term.map((l) => `${l.t}\n`).join('')}</pre>
      </div>
      <aside class="meters">
        <div><span>Cost this ticket</span><b data-meter="cost">$0.000</b></div>
        <div><span>Latency</span><b data-meter="lat">0.0s</b></div>
        <div><span>Eval pass rate</span><b>97.6%</b><small>on 212 cases from your real tickets</small></div>
        <div><span>Escalated to a person</span><b data-meter="esc">0</b></div>
      </aside>
      <script type="application/json" data-term-lines set:html={JSON.stringify(term)} />
    </div>

    <section slot="process" class="hscroll" id="process" data-hs>
      <div class="hs-pin">
        <div class="nv-wrap hs-head">
          <p class="nv-label">Process</p>
          <h2>Four stages, from first call to production.</h2>
          <div class="hs-bar"><i data-hs-bar></i></div>
        </div>
        <ol class="hs-track" data-hs-track>
          {process.map((p, i) => (
            <li>
              <p class="hs-n">{String(i + 1).padStart(2, '0')} <span>{p.time}</span></p>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </Shell>
</Variant>

<style is:global>
  .v11 {
    --bg: #070b18;
    --surface: #0d1326;
    --fg: #e7eaf5;
    --muted: #8b93ad;
    --line: rgba(231, 234, 245, 0.1);
    --accent: #4f6bff;
    --accent-fg: #fff;
    --accent-soft: rgba(79, 107, 255, 0.16);
    --inv-bg: #0a1022;
    --inv-fg: #e7eaf5;
    --inv-muted: #8b93ad;
    --inv-line: rgba(231, 234, 245, 0.12);
    --display: 'Inter Tight', system-ui, sans-serif;
    --body: 'Inter', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --h-weight: 600;
    --h-track: -0.035em;
    --radius: 16px;
    --shadow: 0 0 0 1px rgba(255, 255, 255, 0.02), 0 20px 50px -30px rgba(0, 0, 0, 0.8);
    --teal: #2ad4c0;
  }
  .v11 .nv-label {
    color: #8fa0ff;
  }
  .v11 .nv-services > li {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.01));
    transition: border-color 0.3s, transform 0.3s var(--ease);
  }
  .v11 .nv-services > li:hover {
    border-color: rgba(143, 160, 255, 0.45);
    transform: translateY(-3px);
  }
  .v11 .nv-ai {
    border-block: 1px solid var(--line);
    background: radial-gradient(60% 50% at 50% 0%, rgba(79, 107, 255, 0.14), transparent 70%), var(--inv-bg);
  }
  .v11 .nv-contact {
    background: radial-gradient(50% 80% at 85% 50%, rgba(42, 212, 192, 0.12), transparent 70%),
      radial-gradient(50% 80% at 10% 30%, rgba(79, 107, 255, 0.18), transparent 70%), #0a1022;
  }
  .v11 .nv-mark {
    background: linear-gradient(135deg, #5b74ff, #2ad4c0);
  }
  .v11 .nv-btn {
    box-shadow: 0 10px 30px -10px rgba(79, 107, 255, 0.7);
  }
  .v11 .nv-btn.ghost {
    box-shadow: none;
    border-color: rgba(231, 234, 245, 0.25);
  }

  /* hero */
  .v11 .hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
  }
  .v11 .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .v11 .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(55% 55% at 78% 35%, rgba(79, 107, 255, 0.3), transparent 70%),
      radial-gradient(35% 40% at 92% 85%, rgba(42, 212, 192, 0.16), transparent 70%),
      linear-gradient(90deg, #070b18 0%, rgba(7, 11, 24, 0.85) 38%, rgba(7, 11, 24, 0) 75%);
  }
  .v11 .hero .inner {
    position: relative;
  }
  .v11 .pill {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    font: 500 12px/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .v11 .hero h1 {
    font-size: clamp(44px, 6.6vw, 100px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 13ch;
    margin-bottom: 28px;
  }
  .v11 .grad {
    background: linear-gradient(100deg, #9aa9ff 0%, #5b74ff 45%, #2ad4c0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .v11 .sub {
    font-size: clamp(17px, 1.4vw, 20px);
    color: var(--muted);
    max-width: 54ch;
    margin-bottom: 36px;
  }
  .v11 .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .nv-js .v11 [data-rise] {
    opacity: 0;
    transform: translateY(14px);
    animation: v11-rise 0.9s var(--ease) forwards;
    animation-delay: calc(var(--d) * 110ms + 100ms);
  }
  @keyframes v11-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* terminal demo */
  .v11 .term-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.5fr);
    gap: 16px;
  }
  .v11 .term {
    border: 1px solid rgba(143, 160, 255, 0.22);
    border-radius: 16px;
    background: #050813;
    overflow: hidden;
    box-shadow: 0 40px 100px -40px rgba(79, 107, 255, 0.45);
  }
  .v11 .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font: 12px/1 var(--mono);
    color: var(--muted);
  }
  .v11 .term-bar .d {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
  }
  .v11 .term-title {
    margin-left: 10px;
  }
  .v11 .live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--teal);
  }
  .v11 .live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    animation: v11-pulse 1.6s ease-in-out infinite;
  }
  @keyframes v11-pulse {
    50% {
      opacity: 0.3;
    }
  }
  .v11 .term-body {
    margin: 0;
    padding: 20px 22px 26px;
    min-height: 340px;
    font: clamp(12px, 1vw, 14px) / 1.75 var(--mono);
    color: #c9d0ea;
    white-space: pre-wrap;
    overflow-x: auto;
  }
  .v11 .term-body .prompt {
    color: #fff;
  }
  .v11 .term-body .dim {
    color: #5f6886;
  }
  .v11 .term-body .ok {
    color: #5fe0b5;
  }
  .v11 .term-body .warn {
    color: #ffc266;
  }
  .v11 .term-body .done {
    color: #9aa9ff;
  }
  .v11 .term-body .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: #9aa9ff;
    animation: v11-pulse 1s steps(1) infinite;
  }
  .v11 .meters {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .v11 .meters div {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.02);
  }
  .v11 .meters span {
    display: block;
    font: 500 11px/1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .v11 .meters b {
    font: 600 26px/1 var(--display);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .v11 .meters small {
    display: block;
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .v11 .term-wrap {
      grid-template-columns: 1fr;
    }
    .v11 .meters {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* pinned horizontal process */
  .v11 .hscroll {
    position: relative;
    height: 320vh;
  }
  .v11 .hs-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 5vh, 56px);
  }
  .v11 .hs-head {
    display: grid;
    gap: 16px;
  }
  .v11 .hs-head h2 {
    font-size: clamp(32px, 4.4vw, 60px);
    max-width: 18ch;
  }
  .v11 .hs-bar {
    height: 2px;
    background: var(--line);
    max-width: 420px;
  }
  .v11 .hs-bar i {
    display: block;
    height: 100%;
    width: calc(var(--p, 0) * 100%);
    background: linear-gradient(90deg, #5b74ff, var(--teal));
  }
  .v11 .hs-track {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
    padding-left: max(var(--gutter), calc((100vw - 1240px) / 2 + var(--gutter)));
    display: flex;
    gap: 20px;
    will-change: transform;
  }
  .v11 .hs-track li {
    flex: none;
    width: min(460px, 82vw);
    padding: 30px 30px 34px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: linear-gradient(160deg, rgba(79, 107, 255, 0.12), rgba(255, 255, 255, 0.01) 60%);
  }
  .v11 .hs-n {
    display: flex;
    justify-content: space-between;
    font: 500 13px/1 var(--mono);
    color: #8fa0ff;
    margin-bottom: clamp(40px, 8vh, 90px);
  }
  .v11 .hs-n span {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 12px;
  }
  .v11 .hs-track h3 {
    font-size: clamp(34px, 3.6vw, 52px);
    margin-bottom: 14px;
  }
  .v11 .hs-track p:last-child {
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .v11 .hscroll {
      height: auto;
    }
    .v11 .hs-pin {
      position: static;
      height: auto;
      padding: 100px 0;
    }
    .v11 .hs-track {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- network field --------------------------------------------------------
  {
    const hero = document.querySelector<HTMLElement>('[data-hero]')!;
    const canvas = document.querySelector<HTMLCanvasElement>('[data-field]')!;
    const ctx = canvas.getContext('2d')!;
    type N = { x: number; y: number; vx: number; vy: number; r: number };
    let nodes: N[] = [];
    let W = 0;
    let H = 0;
    const pointer = { x: -9999, y: -9999 };
    const LINK = 140;
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(110, (W * H) / 14000));
      nodes = Array.from({ length: count }, () => ({
        x: W * (0.25 + 0.75 * Math.pow(Math.random(), 0.7)),
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        r: Math.random() * 1.4 + 0.6,
      }));
    };
    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      for (const n of nodes) {
        if (!reduced) {
          n.x += n.vx;
          n.y += n.vy;
          if (n.x < 0 || n.x > W) n.vx *= -1;
          if (n.y < 0 || n.y > H) n.vy *= -1;
        }
      }
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < LINK) {
            ctx.strokeStyle = `rgba(120,140,255,${0.17 * (1 - d / LINK)})`;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
        const dp = Math.hypot(a.x - pointer.x, a.y - pointer.y);
        if (dp < LINK * 1.4) {
          ctx.strokeStyle = `rgba(42,212,192,${0.4 * (1 - dp / (LINK * 1.4))})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(pointer.x, pointer.y);
          ctx.stroke();
        }
      }
      ctx.fillStyle = 'rgba(200,210,255,0.75)';
      for (const n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };
    let visible = true;
    let raf = 0;
    const frame = () => {
      draw();
      if (visible && !reduced) raf = requestAnimationFrame(frame);
    };
    resize();
    addEventListener('resize', () => {
      resize();
      if (reduced) draw();
    });
    hero.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      pointer.x = e.clientX - r.left;
      pointer.y = e.clientY - r.top;
    });
    hero.addEventListener('pointerleave', () => (pointer.x = pointer.y = -9999));
    new IntersectionObserver(([e]) => {
      const was = visible;
      visible = e.isIntersecting;
      if (visible && !was && !reduced) raf = requestAnimationFrame(frame);
      if (!visible) cancelAnimationFrame(raf);
    }).observe(hero);
    frame();
  }

  // ---- typing terminal ------------------------------------------------------
  {
    const wrap = document.querySelector<HTMLElement>('[data-term]')!;
    const body = wrap.querySelector<HTMLElement>('[data-term-body]')!;
    const lines: { c: string; t: string }[] = JSON.parse(wrap.querySelector('[data-term-lines]')!.textContent!);
    const cost = wrap.querySelector<HTMLElement>('[data-meter="cost"]')!;
    const lat = wrap.querySelector<HTMLElement>('[data-meter="lat"]')!;
    const esc = wrap.querySelector<HTMLElement>('[data-meter="esc"]')!;
    const esc_ = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    let running = false;
    let timer = 0;

    const render = (done: number, partial: string) => {
      let html = '';
      for (let i = 0; i < done; i++) html += `<span class="${lines[i].c}">${esc_(lines[i].t)}</span>\n`;
      if (done < lines.length) html += `<span class="${lines[done].c}">${esc_(partial)}</span><span class="cursor"></span>`;
      body.innerHTML = html;
      const f = done / lines.length;
      cost.textContent = `$${(0.0134 * f).toFixed(4)}`;
      lat.textContent = `${(1.8 * f).toFixed(1)}s`;
      esc.textContent = done > 8 ? '1' : '0';
    };

    const play = () => {
      let line = 0;
      let ch = 0;
      const tick = () => {
        if (line >= lines.length) {
          render(lines.length, '');
          timer = window.setTimeout(play, 4500);
          return;
        }
        const t = lines[line].t;
        // the prompt is typed; output lines appear in larger chunks, like a real process
        ch += lines[line].c === 'prompt' ? 1 : 6;
        if (ch >= t.length) {
          line++;
          ch = 0;
          render(line, '');
          timer = window.setTimeout(tick, line === 1 ? 400 : 260);
        } else {
          render(line, t.slice(0, ch));
          timer = window.setTimeout(tick, lines[line].c === 'prompt' ? 28 : 16);
        }
      };
      tick();
    };

    if (reduced) render(lines.length, '');
    else
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !running) {
          running = true;
          play();
        } else if (!e.isIntersecting && running) {
          running = false;
          clearTimeout(timer);
        }
      }, { threshold: 0.35 }).observe(wrap);
  }

  // ---- pinned horizontal process ---------------------------------------------
  {
    const sec = document.querySelector<HTMLElement>('[data-hs]')!;
    const track = sec.querySelector<HTMLElement>('[data-hs-track]')!;
    const bar = sec.querySelector<HTMLElement>('[data-hs-bar]')!;
    const update = () => {
      if (reduced) return;
      const total = sec.offsetHeight - innerHeight;
      const p = Math.min(1, Math.max(0, -sec.getBoundingClientRect().top / total));
      const max = Math.max(0, track.scrollWidth - innerWidth);
      track.style.transform = `translate3d(${-p * max}px,0,0)`;
      bar.style.setProperty('--p', String(p));
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
