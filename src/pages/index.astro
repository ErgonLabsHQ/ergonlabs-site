---
// The live Ergon Labs homepage: Blueprint layout in the Sage palette, with Sage's process timeline and engagements.
// Earlier designs are kept under /archive.
import Site from '../layouts/Site.astro';
import Shell from '../components/nv/Shell.astro';
import Hero from '../components/site/Hero.astro';
import Manifesto from '../components/site/Manifesto.astro';
import ArchDemo from '../components/site/ArchDemo.astro';
import Timeline from '../components/site/Timeline.astro';

const extra = [{ label: 'Founders', href: '/founders' }];
---

<Site>
  <Shell home="/" extra={extra} icons blueprint>
    <Hero slot="hero" />
    <Manifesto slot="after-services" />
    <ArchDemo slot="demo" />
    <Timeline slot="process" />
  </Shell>
</Site>
