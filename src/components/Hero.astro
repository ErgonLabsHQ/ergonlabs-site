---
import { site, process } from '../site';
const cta = site.bookingUrl || '#contact';
const headline = 'We build software that keeps working after launch.';
---

<section class="hero" id="top" data-hero>
  <span class="anchor" id="process"></span>
  <div class="pin">
    <canvas class="scene" data-scene aria-hidden="true"></canvas>

    <div class="wrap overlay">
      <div class="intro" data-intro>
        <h1>{headline}</h1>
        <p>
          {site.name} is a small studio of senior engineers and AI specialists, with more than ten years of production
          software behind us. Web and mobile apps, AI agents, games, and the plumbing in between.
        </p>
        <div class="actions">
          <a class="btn" href={cta}>Start a project</a>
          <a class="btn quiet" href="#services">See what we do</a>
        </div>
      </div>

      <ol class="cards" data-cards>
        {process.map((p, i) => (
          <li class="card panel" data-card>
            <p class="step">
              Step {String(i + 1).padStart(2, '0')} / {String(process.length).padStart(2, '0')}
              <span>{p.time}</span>
            </p>
            <h2>{p.title}</h2>
            <p class="text">{p.text}</p>
            <div class="bar"><i></i></div>
          </li>
        ))}
      </ol>
    </div>

    <ol class="rail" data-rail aria-hidden="true">
      {process.map((p) => <li>{p.title}</li>)}
    </ol>
    <p class="hint" data-hint aria-hidden="true">Scroll to build the bridge <span>↓</span></p>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }
  /* the long scroll track only exists when the script can drive the scene */
  :global(.js) .hero {
    height: 480vh;
  }
  .anchor {
    position: absolute;
    top: 17%;
  }
  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #bfe0ff;
    border-bottom: 2px solid var(--ink);
  }
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
  .overlay {
    position: relative;
    height: 100%;
  }
  .intro {
    position: absolute;
    top: clamp(92px, 13vh, 132px);
    left: var(--gutter);
    width: min(640px, 100% - 2 * var(--gutter));
    will-change: opacity, transform;
  }
  h1 {
    font-size: clamp(40px, min(6.3vw, 11vh), 104px);
    margin-bottom: clamp(16px, 2.4vh, 28px);
  }
  .intro p {
    font-size: clamp(16.5px, 1.35vw, 19px);
    max-width: 50ch;
    margin-bottom: clamp(18px, 3vh, 30px);
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card {
    position: absolute;
    top: clamp(92px, 13vh, 132px);
    left: var(--gutter);
    width: min(440px, 100% - 2 * var(--gutter) - 6px);
    padding: 22px 24px 24px;
    opacity: 0;
    transform: translateY(26px) rotate(-1.2deg);
    pointer-events: none;
    transition: opacity 0.35s var(--ease), transform 0.45s var(--ease);
  }
  .card.on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .card.past {
    transform: translateY(-26px) rotate(1.2deg);
  }
  .step {
    font-family: var(--pixel);
    font-size: 11.5px;
    text-transform: uppercase;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--blue);
    margin-bottom: 14px;
  }
  .step span {
    color: var(--ink);
    background: var(--sun);
    padding: 1px 7px 2px;
  }
  .card h2 {
    font-size: clamp(40px, 4.4vw, 60px);
    margin-bottom: 10px;
  }
  .text {
    font-size: 16.5px;
    color: var(--muted);
  }
  .bar {
    margin-top: 18px;
    height: 8px;
    border: 2px solid var(--ink);
    background: var(--paper);
  }
  .bar i {
    display: block;
    height: 100%;
    width: calc(var(--p, 0) * 100%);
    background: var(--blue);
  }
  .rail {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    list-style: none;
    margin: 0;
    padding: 5px;
    display: flex;
    gap: 4px;
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--ink);
    font-family: var(--pixel);
    font-size: 11px;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .rail.show {
    opacity: 1;
  }
  .rail li {
    padding: 5px 10px 6px;
    border-radius: 7px;
    transition: background 0.2s, color 0.2s;
  }
  .rail li.done {
    background: var(--mint);
  }
  .rail li.on {
    background: var(--ink);
    color: var(--paper);
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    font-family: var(--pixel);
    font-size: 11.5px;
    text-transform: uppercase;
    white-space: nowrap;
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 6px 12px 7px;
    border-radius: 10px;
    transition: opacity 0.3s;
  }
  .hint span {
    display: inline-block;
    animation: nudge 1s steps(2) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }
  :global(html:not(.js)) .hint,
  :global(html:not(.js)) .cards,
  :global(html:not(.js)) .rail {
    display: none;
  }
  @media (max-width: 700px) {
    .card {
      padding: 16px 18px 18px;
    }
    .text {
      font-size: 15.5px;
    }
  }
</style>

<script>
  // A pixel-art valley drawn on a small canvas and scaled up. Scrolling through the pinned
  // hero builds a bridge across it in four stages that match the process steps.
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-scene]')!;
  const ctx = canvas.getContext('2d')!;
  const intro = document.querySelector<HTMLElement>('[data-intro]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const rail = document.querySelector<HTMLElement>('[data-rail]')!;
  const hint = document.querySelector<HTMLElement>('[data-hint]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const INK = '#171a2e';
  const BLUE = '#2d5bff';
  const SUN = '#ffcf3a';
  const MINT = '#8fdcb8';
  const CORAL = '#ff6b4a';
  const STEEL = '#565b80';
  const SKY = ['#bfe0ff', '#c9e5ff', '#d5ebff', '#e2f1ff', '#eff5f6', '#faf2e0', '#ffe9c4'];

  let W = 0;
  let H = 0;
  let progress = 0; // 0..1 through the pinned scroll
  let mouse = 0; // -1..1, horizontal
  let mouseTarget = 0;

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const ease = (v: number) => v * v * (3 - 2 * v);
  const px = (x: number, y: number, w: number, h: number, c: string) => {
    if (w <= 0 || h <= 0) return;
    ctx.fillStyle = c;
    ctx.fillRect(Math.round(x), Math.round(y), Math.round(w), Math.round(h));
  };
  const pingpong = (v: number, len: number) => {
    const m = v % (len * 2);
    return m < len ? m : len * 2 - m;
  };

  const resize = () => {
    const scale = canvas.clientWidth < 700 ? 3 : canvas.clientWidth > 1900 ? 5 : 4;
    W = Math.ceil(canvas.clientWidth / scale);
    H = Math.ceil(canvas.clientHeight / scale);
    canvas.width = W;
    canvas.height = H;
  };

  const person = (x: number, y: number, hat: string, shirt: string, phase: number) => {
    px(x, y - 6, 3, 1, hat);
    px(x, y - 5, 3, 2, '#f2c9a0');
    px(x, y - 3, 3, 2, shirt);
    if (Math.floor(phase) % 2) px(x + 1, y - 1, 1, 1, INK);
    else {
      px(x, y - 1, 1, 1, INK);
      px(x + 2, y - 1, 1, 1, INK);
    }
  };

  const tree = (x: number, g: number) => {
    px(x, g - 3, 1, 3, '#8f5a38');
    px(x - 2, g - 8, 5, 5, '#3f9e60');
    px(x - 1, g - 10, 3, 2, '#3f9e60');
    px(x - 1, g - 7, 2, 1, '#6fd08c');
  };

  const draw = (t: number) => {
    const k = Math.max(0.6, H / 225);
    const wide = W / H > 1.2;
    const horizon = Math.round(H * 0.52);
    const deck = Math.round(H * (wide ? 0.72 : 0.76));
    const G = deck - 2; // ground and bridge surface
    const xl = Math.round(W * (wide ? 0.47 : 0.2));
    const xr = Math.round(W * (wide ? 0.85 : 0.8));
    const span = xr - xl;
    const rw = W - xr;
    const floor = H - Math.max(5, Math.round(H * 0.06));
    const t1 = xl + Math.round(span * 0.27);
    const t2 = xl + Math.round(span * 0.73);
    const towerTop = G - Math.round(Math.max(18, H * 0.17));

    // build progress and its four stages
    const b = clamp((progress - 0.1) / 0.8);
    const a = clamp(b / 0.25);
    const p2 = clamp((b - 0.25) / 0.25);
    const p3 = clamp((b - 0.5) / 0.3);
    const p4 = clamp((b - 0.8) / 0.2);
    const lit = p4 > 0.3;

    // sky, sun, clouds
    SKY.forEach((c, i) => px(0, Math.floor((i * horizon) / SKY.length), W, Math.ceil(horizon / SKY.length) + 1, c));
    px(0, horizon, W, H - horizon, SKY[SKY.length - 1]);
    const sr = Math.max(6, Math.round(H * 0.06));
    const sx = Math.round(W * (wide ? 0.66 : 0.78) + mouse * 2);
    // on a tall screen the text fills the sky, so the sun sits low and peeks over the mountains
    const sy = Math.round(H * (wide ? 0.2 : 0.555));
    for (let dy = -sr; dy <= sr; dy++) {
      const half = Math.round(Math.sqrt(sr * sr - dy * dy));
      px(sx - half, sy + dy, half * 2, 1, SUN);
    }
    [
      [0.08, 0.1, 1],
      [0.38, 0.27, 0.7],
      [0.62, 0.09, 0.9],
      [0.9, 0.31, 0.6],
    ].forEach(([fx, fy, s], i) => {
      const w = Math.round(24 * s * k);
      const x = ((fx * W + t * (1.5 + i * 0.6)) % (W + 60)) - 30 + mouse * (3 + i);
      const y = fy * H;
      px(x, y + 3 * k, w, 4 * k, '#ffffff');
      px(x + w * 0.22, y, w * 0.5, 4 * k, '#ffffff');
      px(x + 1, y + 7 * k - 1, w - 2, 1, '#dfeafa');
    });

    // far mountains and near hills
    for (let x = 0; x < W; x++) {
      const u = (x + mouse * 2) / k;
      const m1 = horizon - k * (18 + 13 * Math.sin(u * 0.035 + 1.3) + 7 * Math.sin(u * 0.09 + 0.4));
      px(x, m1, 1, H - m1, '#b6cbeb');
      if (horizon - m1 > 30 * k) px(x, m1, 1, 3 * k, '#f4f8ff');
      const v = (x + mouse * 4) / k;
      const m2 = horizon + 5 * k - k * (9 * Math.sin(v * 0.028 + 2.2) + 5 * Math.sin(v * 0.075));
      px(x, m2, 1, H - m2, '#a3d9b6');
    }

    // canyon, river
    px(0, deck, W, H - deck, '#74b89e');
    px(0, deck + (floor - deck) * 0.45, W, H, '#5fa390');
    px(0, floor, W, H - floor, BLUE);
    for (let i = 0; i < W / 7; i++) {
      px((i * 37 + Math.floor(t * 6)) % W, floor + 1 + (i % 3), 3, 1, '#9db6ff');
    }

    // cliffs
    for (let y = deck; y < H; y++) {
      const d = y - deck;
      const jag = (y * 7) % 5 < 2 ? 1 : 0;
      const le = xl - Math.round(d * 0.16) - jag;
      const re = xr + Math.round(d * 0.16) + jag;
      const band = ['#d9a273', '#cb8f60', '#bb7d50'][Math.floor(d / (5 * k)) % 3];
      px(0, y, le, 1, band);
      px(re, y, W - re, 1, band);
      px(le - 1, y, 1, 1, '#8f5a38');
      px(re, y, 1, 1, '#8f5a38');
    }
    px(0, G, xl, 2, '#5fc27e');
    px(0, deck, xl, 1, '#3f9e60');
    px(xr, G, rw, 2, '#5fc27e');
    px(xr, deck, rw, 1, '#3f9e60');

    // stage 1: survey flags and the blueprint
    if (a > 0.05) {
      px(xl - 3, G - 7, 1, 7, INK);
      px(xl - 2, G - 7, 3, 2, CORAL);
      px(xr + 2, G - 7, 1, 7, INK);
      px(xr + 3, G - 7, 3, 2, CORAL);
    }
    if (b < 0.55) {
      for (let x = xl; x < xl + span * ease(a); x++) if ((x - xl) % 5 < 3) px(x, G, 1, 1, BLUE);
      const g = clamp((a - 0.45) / 0.55);
      if (g > 0 && p2 < 0.8) {
        for (let y = floor; y > floor - (floor - towerTop) * g; y--) {
          if (y % 4 < 2) {
            px(t1, y, 1, 1, BLUE);
            px(t1 + 4, y, 1, 1, BLUE);
            px(t2, y, 1, 1, BLUE);
            px(t2 + 4, y, 1, 1, BLUE);
          }
        }
      }
    }

    // stage 2: towers rise, then a rope walkway (the thin working slice)
    if (p2 > 0) {
      const top = floor - (floor - towerTop) * ease(clamp(p2 / 0.7));
      for (const tx of [t1, t2]) {
        px(tx, top, 5, floor - top, INK);
        px(tx + 1, top + 1, 3, floor - top - 1, '#3b4170');
        for (let y = Math.round(top) + 4; y < floor; y += 7) px(tx, y, 5, 1, SUN);
        px(tx - 1, top, 7, 2, INK);
      }
    }
    const rope = clamp((p2 - 0.7) / 0.3);
    const ropeY = (x: number) => G + Math.round(4 * Math.sin((Math.PI * (x - xl)) / span));
    if (rope > 0 && p3 < 0.35) {
      for (let x = xl; x < xl + span * rope; x++) {
        px(x, ropeY(x), 1, 1, CORAL);
        if (x % 3 === 0) px(x, ropeY(x) - 4, 1, 1, '#8f5a38');
      }
    }

    // stage 3: deck from both sides, cables, crane
    const half = (span / 2) * ease(p3);
    if (p3 > 0) {
      for (const [x0, len] of [
        [xl, half],
        [xr - half, half],
      ]) {
        px(x0, G, len, 3, INK);
        px(x0, G + 1, len, 1, SUN);
        px(x0, G + 5, len, 1, INK);
        for (let x = Math.round(x0); x < x0 + len; x++) if (x % 4 === 0) px(x, G + 3, 1, 2, INK);
      }
      const cableY = (x: number) => {
        const c1 = t1 + 2;
        const c2 = t2 + 2;
        if (x < c1) return G - 1 + ((towerTop - (G - 1)) * (x - (xl - 8))) / (c1 - (xl - 8));
        if (x > c2) return G - 1 + ((towerTop - (G - 1)) * (xr + 8 - x)) / (xr + 8 - c2);
        const u = (x - c1) / (c2 - c1);
        return towerTop + (G - 6 - towerTop) * (1 - Math.pow(2 * u - 1, 2));
      };
      for (let x = xl - 8; x <= xr + 8; x++) {
        const built = x <= xl + half || x >= xr - half;
        if (!built) continue;
        const cy = Math.round(cableY(x));
        px(x, cy, 1, 1, CORAL);
        if (x % 5 === 0 && x > xl && x < xr && cy < G - 2) px(x, cy + 1, 1, G - cy - 1, STEEL);
      }
    }

    // stage 4: the train runs behind the houses once the bridge is open
    if (p4 > 0.45) {
      const x0 = ((t * 24) % (W + 80)) - 50;
      [BLUE, CORAL, MINT].forEach((c, i) => {
        const cx = x0 + i * 9;
        px(cx, G - 5, 8, 4, c);
        px(cx + 1, G - 4, 2, 1, '#ffffff');
        px(cx + 5, G - 4, 2, 1, '#ffffff');
        px(cx + 1, G - 1, 2, 1, INK);
        px(cx + 5, G - 1, 2, 1, INK);
        if (i === 2) px(cx + 6, G - 7, 1, 2, INK);
      });
    }

    // trees, studio hut, town
    const leftTrees = wide ? [0.05, 0.13, 0.26, 0.6, 0.7] : [0.3];
    leftTrees.forEach((f) => tree(Math.round(xl * f), G));
    [0.07, 0.93].forEach((f) => tree(Math.round(xr + rw * f), G));

    const hx = xl - (wide ? 34 : 19);
    px(hx, G - 9, 13, 9, '#fffdf7');
    px(hx - 1, G - 12, 15, 3, CORAL);
    px(hx + 1, G - 14, 11, 2, CORAL);
    px(hx + 2, G - 5, 3, 5, INK);
    px(hx + 7, G - 7, 4, 3, lit ? SUN : '#9fb4e8');
    px(hx + 10, G - 17 - (Math.floor(t * 2) % 5), 1, 1, '#ffffff');

    const houses: [number, number, number, string][] =
      rw > 44
        ? [
            [0.2, 9, 16, '#fffdf7'],
            [0.42, 11, 25, '#dfe6ff'],
            [0.66, 9, 13, '#ffe3a6'],
          ]
        : [[0.3, 9, 18, '#dfe6ff']];
    houses.forEach(([f, w, h, c]) => {
      const x = Math.round(xr + rw * f);
      px(x, G - h, w, h, c);
      px(x, G - h, w, 1, INK);
      for (let wy = G - h + 3; wy < G - 3; wy += 4)
        for (let wx = x + 2; wx < x + w - 2; wx += 3) px(wx, wy, 1, 2, lit ? SUN : '#8d97c4');
    });

    if (b > 0.42 && b < 0.84) {
      const mx0 = xl - 10;
      px(mx0, G - 32, 2, 32, INK);
      for (let y = G - 28; y < G; y += 4) px(mx0, y, 2, 1, SUN);
      px(mx0 - 6, G - 32, 36, 2, INK);
      px(mx0 - 7, G - 31, 4, 4, STEEL);
      const tr = mx0 + 9 + Math.round(9 * (1 + Math.sin(t * 0.9)));
      const len = 8 + Math.round(4 * (1 + Math.sin(t * 1.7)));
      px(tr, G - 30, 1, len, INK);
      px(tr - 2, G - 30 + len, 5, 2, SUN);
    }

    if (p4 > 0) {
      for (let x = xl + 6; x < xr - 4; x += 14) {
        px(x, G - 5, 1, 5, INK);
        px(x - 1, G - 7, 3, 2, p4 > 0.35 ? SUN : STEEL);
      }
    }
    if (p4 > 0.15) {
      for (const tx of [t1, t2]) {
        px(tx + 2, towerTop - 7, 1, 7, INK);
        px(tx + 3, towerTop - 7 + (Math.sin(t * 4 + tx) > 0 ? 0 : 1), 4, 3, CORAL);
      }
    }
    if (p4 > 0.6) {
      for (let i = 0; i < 7; i++) {
        if (Math.sin(t * 3 + i * 1.7) > 0.3) px(xr + rw * (0.15 + 0.11 * i), G - 32 - ((i * 5) % 13), 1, 1, SUN);
      }
    }

    // people
    const walk = (from: number, to: number, speed: number, offset: number) =>
      to - from < 6 ? null : from + pingpong(t * speed + offset, to - from - 3);
    const w1 = walk(xl - (wide ? 18 : 14), xl - 3, 3, 4);
    if (w1 !== null) person(Math.round(w1), G, SUN, BLUE, t * 4);
    const w2 = walk(xr + 3, xr + Math.min(rw - 4, 22), 2.5, 9);
    if (w2 !== null) person(Math.round(w2), G, '#ffffff', CORAL, t * 4 + 1);
    if (rope >= 1 && p3 < 0.35) {
      const x = Math.round(xl + pingpong(t * 5, span - 3));
      person(x, ropeY(x + 1), SUN, CORAL, t * 5);
    }
    if (p3 > 0) {
      const w3 = walk(xl, xl + half, 4, 0);
      if (w3 !== null) person(Math.round(w3), G, SUN, BLUE, t * 5);
      const w4 = walk(xr - half, xr, 4, 5);
      if (w4 !== null) person(Math.round(w4), G, SUN, MINT, t * 5 + 1);
    }
  };

  // ---- scroll drives the overlay; the scene reads `progress` each frame ----------
  const steps = cards.length;
  const railItems = [...rail.children] as HTMLElement[];
  const update = () => {
    const total = hero.offsetHeight - window.innerHeight;
    progress = total > 0 ? clamp(-hero.getBoundingClientRect().top / total) : 0;

    const out = clamp((progress - 0.03) / 0.07);
    intro.style.opacity = String(1 - out);
    intro.style.transform = `translateY(${-out * 30}px)`;
    intro.style.pointerEvents = out > 0.6 ? 'none' : '';
    hint.style.opacity = progress > 0.015 ? '0' : '1';

    const b = clamp((progress - 0.1) / 0.8);
    const showing = progress > 0.11;
    const bounds = [0, 0.25, 0.5, 0.8, 1];
    let index = 0;
    for (let i = 0; i < steps; i++) if (b >= bounds[i]) index = i;
    cards.forEach((card, i) => {
      card.classList.toggle('on', showing && i === index);
      card.classList.toggle('past', showing && i < index);
      card.style.setProperty('--p', String(clamp((b - bounds[i]) / (bounds[i + 1] - bounds[i]))));
    });
    rail.classList.toggle('show', showing);
    railItems.forEach((li, i) => {
      li.classList.toggle('on', i === index);
      li.classList.toggle('done', i < index);
    });
  };

  let visible = true;
  let raf = 0;
  const frame = (now: number) => {
    mouse += (mouseTarget - mouse) * 0.05;
    draw(reduced ? 12 : now / 1000);
    if (visible && !reduced) raf = requestAnimationFrame(frame);
  };
  const redraw = () => {
    update();
    if (reduced) frame(0);
  };

  resize();
  update();
  window.addEventListener('scroll', redraw, { passive: true });
  window.addEventListener('resize', () => {
    resize();
    redraw();
  });
  window.addEventListener('pointermove', (e) => {
    mouseTarget = (e.clientX / window.innerWidth) * 2 - 1;
  });
  new IntersectionObserver(([e]) => {
    const was = visible;
    visible = e.isIntersecting;
    if (visible && !was && !reduced) raf = requestAnimationFrame(frame);
    if (!visible) cancelAnimationFrame(raf);
  }).observe(hero);
  frame(performance.now());
</script>
