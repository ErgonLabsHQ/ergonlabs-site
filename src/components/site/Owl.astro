---
// The Ergon Labs owl. Flat colours (no gradient ids) so several can sit on one page.
// The eyelids and pupils carry classes that Logo.astro animates; on its own the owl is static.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<svg class={`el-owl ${cls}`} viewBox="0 0 64 80" aria-hidden="true">
  <!-- ear tufts -->
  <path d="M12 22 L13 3 L24 13 Z" fill="#5c3f26"></path>
  <path d="M52 22 L51 3 L40 13 Z" fill="#5c3f26"></path>
  <!-- body and head -->
  <ellipse cx="32" cy="52" rx="21" ry="24" fill="#6e4c2e"></ellipse>
  <ellipse cx="32" cy="28" rx="22" ry="19" fill="#7d5735"></ellipse>
  <!-- wings -->
  <path d="M11 44 C8 56 11 68 19 74 C17 64 17 54 19 44 Z" fill="#5c3f26"></path>
  <path d="M53 44 C56 56 53 68 45 74 C47 64 47 54 45 44 Z" fill="#5c3f26"></path>
  <!-- belly with chevron feathers -->
  <ellipse cx="32" cy="57" rx="13" ry="16" fill="#e6d2b0"></ellipse>
  <g fill="none" stroke="#6e4c2e" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
    <path d="M24 50l2 2 2-2M30 50l2 2 2-2M36 50l2 2 2-2"></path>
    <path d="M23.5 56l2 2 2-2M29.5 56l2 2 2-2M35.5 56l2 2 2-2M41 56l-0.5 0.5"></path>
    <path d="M26 62l2 2 2-2M33 62l2 2 2-2"></path>
  </g>
  <!-- eyes -->
  <circle cx="22.5" cy="28" r="9" fill="#f4e9d6"></circle>
  <circle cx="41.5" cy="28" r="9" fill="#f4e9d6"></circle>
  <g class="el-pupils">
    <circle cx="22.5" cy="28" r="5.6" fill="#f2a21b"></circle>
    <circle cx="41.5" cy="28" r="5.6" fill="#f2a21b"></circle>
    <circle cx="22.5" cy="28" r="2.9" fill="#1a1208"></circle>
    <circle cx="41.5" cy="28" r="2.9" fill="#1a1208"></circle>
    <circle cx="23.8" cy="26.6" r="1.1" fill="#fff"></circle>
    <circle cx="42.8" cy="26.6" r="1.1" fill="#fff"></circle>
  </g>
  <!-- eyelids (closed by the blink animation) -->
  <ellipse class="el-lid" cx="22.5" cy="28" rx="9.4" ry="9.4" fill="#7d5735"></ellipse>
  <ellipse class="el-lid" cx="41.5" cy="28" rx="9.4" ry="9.4" fill="#7d5735"></ellipse>
  <!-- brows and beak -->
  <path d="M13.5 18.5 Q22 16.5 30 21.5M50.5 18.5 Q42 16.5 34 21.5" fill="none" stroke="#3f2a17" stroke-width="2.2" stroke-linecap="round"></path>
  <path d="M29.5 33 L34.5 33 L32 39 Z" fill="#3a2a1a"></path>
  <!-- feet -->
  <g fill="none" stroke="#e8a62a" stroke-width="1.8" stroke-linecap="round">
    <path d="M25 74v4M23 74.5l-1.5 3.5M27 74.5l1.5 3.5"></path>
    <path d="M39 74v4M37 74.5l-1.5 3.5M41 74.5l1.5 3.5"></path>
  </g>
</svg>
