---
// Nuvareth logo, concept 5 "Blueprint": the N drafted on a construction grid inside crop marks,
// with the accent node at the top right. Colours follow the surrounding text (--fg) and --accent.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg class="nv-logo-mark" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
  <path d="M6 14V6h8M50 6h8v8M58 50v8h-8M14 58H6v-8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"></path>
  <g fill="currentColor" opacity="0.35">
    <circle cx="32" cy="16" r="2.2"></circle><circle cx="16" cy="32" r="2.2"></circle><circle cx="32" cy="32" r="2.2"></circle>
    <circle cx="48" cy="32" r="2.2"></circle><circle cx="32" cy="48" r="2.2"></circle>
  </g>
  <path d="M16 48V16l32 32V16" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
  <circle cx="48" cy="16" r="5" fill="var(--accent, #1d6b4f)"></circle>
</svg>
