---
// A short statement whose words light up as it scrolls past.
const text =
  'Production AI is an engineering discipline. It has to handle real data, real load and real budgets, and its answers have to be verifiable. We engineer for those conditions from day one: tested against your real cases, measured in production, and built so your own team can own it.';
---

<section class="manifesto" data-mf>
  <div class="nv-wrap">
    <p class="nv-label">Our view</p>
    <p class="mf-text">{text.split(' ').map((w) => <span>{w} </span>)}</p>
  </div>
</section>

<style>
  .manifesto {
    padding: clamp(80px, 12vw, 160px) 0;
    border-top: 1px solid var(--line);
  }
  .mf-text {
    margin-top: 24px;
    font: 500 clamp(26px, 3.4vw, 48px) / 1.25 var(--display);
    letter-spacing: -0.02em;
    max-width: 30ch;
  }
  .mf-text span {
    color: rgba(19, 41, 31, 0.18);
    transition: color 0.3s;
  }
  .mf-text span:global(.on) {
    color: var(--fg);
  }
</style>

<script>
  const words = [...document.querySelectorAll<HTMLElement>('[data-mf] .mf-text span')];
  const text = document.querySelector<HTMLElement>('[data-mf] .mf-text');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const light = () => {
    if (!text) return;
    if (reduced) {
      words.forEach((w) => w.classList.add('on'));
      return;
    }
    const r = text.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight * 0.75 - r.top) / (r.height + innerHeight * 0.25)));
    const n = Math.round(p * words.length);
    words.forEach((w, i) => w.classList.toggle('on', i < n));
  };
  addEventListener('scroll', light, { passive: true });
  light();
</script>
