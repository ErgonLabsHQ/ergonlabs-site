---
// Hero: headline that rises in word by word (the right side is left open for the owl and moon behind),
// and a ticker of capabilities underneath.
import { brand, services } from '../../nuvareth';
const words = ['Engineering', 'the', 'Next', 'Era', 'of', 'Intelligence.'];
const ticker = [...new Set(services.flatMap((s) => s.items.slice(0, 3)))].slice(0, 18);
---

<section class="hero">
  <div class="nv-wrap grid">
    <div class="copy">
      <p class="nv-label rise" style="--w:0">Ergon Labs / AI engineering firm</p>
      <h1>
        {words.map((w, i) => <span class:list={['wd', { grad: i > 3 }]} style={`--w:${i + 1}`}>{w}</span>)}
      </h1>
      <p class="sub rise" style="--w:7">{brand.intro}</p>
      <div class="actions rise" style="--w:8">
        <a class="nv-btn" href="#contact">Start a project <span aria-hidden="true">→</span></a>
        <a class="nv-btn ghost" href="/founders">Meet the founders</a>
      </div>
    </div>
  </div>
  <div class="ticker" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <div class="row">
          {ticker.map((t) => (
            <span>{t}</span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(130px, 18vh, 190px) 0 0;
  }
  .wd {
    display: inline-block;
    margin-right: 0.24em;
  }
  .wd,
  .rise {
    opacity: 0;
    transform: translateY(0.5em);
    filter: blur(8px);
    animation: rise 0.9s var(--ease) forwards;
    animation-delay: calc(0.1s + var(--w) * 0.08s);
  }
  .wd.grad {
    animation: rise 0.9s var(--ease) forwards calc(0.1s + var(--w) * 0.08s), grad-sweep 7s ease-in-out 1.5s infinite;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  .ticker {
    margin-top: clamp(60px, 9vh, 100px);
    border-block: 1px solid var(--line);
    padding: 18px 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    background: rgba(10, 12, 17, 0.4);
  }
  .track {
    display: flex;
    width: max-content;
    animation: tick 50s linear infinite;
  }
  .ticker:hover .track {
    animation-play-state: paused;
  }
  .row {
    display: flex;
    gap: 44px;
    padding-right: 44px;
  }
  .row span {
    display: inline-flex;
    align-items: center;
    gap: 44px;
    white-space: nowrap;
    font: 500 15px/1 var(--display);
    color: #aeb4c1;
  }
  .row span::after {
    content: '';
    width: 1px;
    height: 14px;
    background: var(--line-strong);
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 0.38fr);
    min-height: min(64vh, 620px);
    gap: clamp(30px, 5vw, 70px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(40px, 5.4vw, 84px);
    line-height: 1;
  }
  .sub {
    font-size: clamp(17px, 1.35vw, 19px);
    color: var(--muted);
    max-width: 52ch;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wd,
    .rise {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none;
    }
    .track {
      animation: none;
    }
  }
</style>
