---
// Blueprint hero in the Sage palette: copy on the left, a production schematic that draws itself in on the right.
import { brand } from '../../nuvareth';
---

<section class="hero">
  <div class="nv-wrap grid">
    <div class="copy">
      <p class="nv-label">Nuvareth / AI engineering firm</p>
      <h1>Engineering the Next Era of Intelligence.</h1>
      <p class="sub">{brand.intro}</p>
      <div class="actions">
        <a class="nv-btn" href="#contact">Start a project</a>
        <a class="nv-btn ghost" href="/founders">Meet the founders</a>
      </div>
    </div>
    <figure class="bp" aria-hidden="true">
      <svg viewBox="0 0 520 460">
        <g class="draw">
          <rect x="40" y="40" width="440" height="380" rx="2" class="frame"></rect>
          <rect x="80" y="80" width="150" height="70" class="b" pathLength="1" style="--d:0"></rect>
          <rect x="290" y="80" width="150" height="70" class="b" pathLength="1" style="--d:1"></rect>
          <rect x="185" y="200" width="150" height="80" class="b hi" pathLength="1" style="--d:2"></rect>
          <rect x="80" y="330" width="150" height="60" class="b" pathLength="1" style="--d:3"></rect>
          <rect x="290" y="330" width="150" height="60" class="b" pathLength="1" style="--d:4"></rect>
          <path d="M155 150V175H260V200" class="w" pathLength="1"></path>
          <path d="M365 150V175H260" class="w" pathLength="1"></path>
          <path d="M260 280V305H155V330" class="w" pathLength="1"></path>
          <path d="M260 305H365V330" class="w" pathLength="1"></path>
          <path d="M40 440H480M40 434V446M480 434V446" class="dim" pathLength="1"></path>
          <path d="M500 40V420M494 40H506M494 420H506" class="dim" pathLength="1"></path>
        </g>
        <g class="labels">
          <text x="155" y="120">DATA</text>
          <text x="155" y="136" class="s">your sources</text>
          <text x="365" y="120">MODELS</text>
          <text x="365" y="136" class="s">open + hosted</text>
          <text x="260" y="236" class="hl">AGENT</text>
          <text x="260" y="254" class="s">tools · limits</text>
          <text x="155" y="364">EVALS</text>
          <text x="365" y="364">MONITORING</text>
          <text x="260" y="456" class="s">PRODUCTION SYSTEM · REV 14</text>
        </g>
      </svg>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: clamp(120px, 16vh, 170px) 0 clamp(60px, 9vh, 100px);
    border-bottom: 1px solid var(--fg);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(30px, 5vw, 70px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(42px, 5.6vw, 84px);
    line-height: 1.02;
  }
  .sub {
    font-size: clamp(17px, 1.35vw, 19px);
    color: var(--muted);
    max-width: 52ch;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .bp {
    margin: 0;
    border-radius: 6px;
    padding: 10px;
    background-color: var(--panel);
    background-image: linear-gradient(rgba(201, 216, 197, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 216, 197, 0.08) 1px, transparent 1px);
    background-size: 20px 20px;
    box-shadow: 0 30px 60px -30px rgba(19, 41, 31, 0.6);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .draw * {
    fill: none;
    stroke: var(--sage);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.4s var(--ease) forwards;
    animation-delay: calc(var(--d, 0) * 0.15s);
  }
  .draw .frame {
    stroke-dasharray: 3 5;
    stroke-dashoffset: 0;
    animation: none;
    opacity: 0.4;
  }
  .draw .w {
    animation-delay: 0.8s;
    stroke: var(--mint);
  }
  .draw .hi {
    stroke: var(--mint);
    stroke-width: 2;
  }
  .draw .dim {
    animation-delay: 1.1s;
    opacity: 0.6;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .labels text {
    fill: #eef1e8;
    font: 500 13px var(--mono);
    letter-spacing: 0.1em;
    text-anchor: middle;
    opacity: 0;
    animation: fade 0.6s ease forwards 1.2s;
  }
  .labels .s {
    fill: #9bb3a4;
    font-size: 10.5px;
    letter-spacing: 0.04em;
  }
  .labels .hl {
    fill: var(--mint);
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .bp {
      max-width: 560px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .draw * {
      stroke-dashoffset: 0;
    }
    .labels text {
      opacity: 1;
    }
  }
</style>
