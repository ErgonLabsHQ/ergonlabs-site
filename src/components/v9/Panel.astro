---
// One instrument panel: the frame around an animated demo. Steps inside carry data-s and are
// revealed in order by the player in 9.astro.
interface Props {
  title: string;
  station: string;
}
const { title, station } = Astro.props;
---

<div class="panel" data-demo>
  <div class="panel-bar">
    <i class="panel-ping" aria-hidden="true"></i>
    <span class="panel-title">{title}</span>
    <span class="panel-station">{station}</span>
    <span class="panel-ex">Example</span>
    <button type="button" class="panel-replay" data-replay aria-label={`Replay: ${title}`}>Replay</button>
  </div>
  <div class="panel-body">
    <slot />
  </div>
</div>
