---
// Custom cursor (after kargul.studio), in two parts:
// 1. The pointer itself: a crisp black arrow with a white outline, and a white pointing hand over anything
//    clickable. Drawn here as small SVGs and set with CSS `cursor: url()`, so the operating system draws it with
//    zero lag.
// 2. A small square that trails it, drawn white with mix-blend-mode: difference (so it inverts whatever is
//    underneath). It eases after the pointer with frame-rate independent smoothing and grows into a full square
//    over links and buttons, shrinks a little on press and hides over text fields. Its animation loop runs only
//    while it is catching up, and only `transform` changes per frame (GPU composited).
// Only on devices with a fine pointer; touch devices and reduced motion keep the plain pointer.
// 3. A short synthesized click sound when a link or button is pressed with the mouse (script at the end).

const svg = (body: string, w: number, h: number) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' width='${w}' height='${h}' viewBox='0 0 ${w} ${h}'>${body}</svg>`,
  )}")`;

const arrowPath = 'M3 2.5V21l4.6-4.3 3.4 7.7 3.3-1.5-3.3-7.4h6.4Z';
const arrow = svg(
  `<path d='${arrowPath}' transform='translate(1 1.4)' fill='rgba(0,0,0,0.22)'/>` +
    `<path d='${arrowPath}' fill='#141414' stroke='#fff' stroke-width='1.6' stroke-linejoin='round'/>`,
  24,
  28,
);

const handPath =
  'M10 13.5V4a2 2 0 0 1 4 0v8a1.75 1.75 0 0 1 3.5 0v.8a1.75 1.75 0 0 1 3.5 0v.9a1.75 1.75 0 0 1 3.5 0V20c0 3.6-2.6 6.2-6.2 6.2h-3.6c-2.5 0-4.1-1.2-5.5-3.3l-3.6-5.6a1.75 1.75 0 0 1 2.8-2.1Z';
const hand = svg(
  `<path d='${handPath}' transform='translate(1 1.4)' fill='rgba(0,0,0,0.22)'/>` +
    `<path d='${handPath}' fill='#fff' stroke='#141414' stroke-width='1.5' stroke-linejoin='round'/>` +
    `<path d='M14 16v4.6M17.5 16v4.6M21 16.4v4.2' stroke='#141414' stroke-width='1.3' stroke-linecap='round'/>`,
  28,
  28,
);
const css = `@media (hover: hover) and (pointer: fine) {
  html { cursor: ${arrow} 4 3, auto; }
  a[href], button:not(:disabled), [role='button'], label, summary, select { cursor: ${hand} 12 2, pointer; }
  input:not([type='checkbox'], [type='radio'], [type='submit'], [type='button']), textarea { cursor: text; }
}`;
---

<Fragment set:html={`<style>${css}</style>`} />

<div class="cur" aria-hidden="true" data-cur><i></i></div>

<style is:global>
  .cur {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2147483647;
    pointer-events: none;
    mix-blend-mode: difference;
    will-change: transform;
    display: none;
  }
  .cur i {
    display: block;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    background: #fff;
    scale: 0;
    opacity: 0;
    transition:
      scale 0.5s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .cur[data-s='dot'] i {
    scale: 0.2;
    opacity: 1;
  }
  .cur[data-s='hover'] i {
    scale: 1;
    opacity: 1;
  }
  .cur.down[data-s='dot'] i {
    scale: 0.14;
  }
  .cur.down[data-s='hover'] i {
    scale: 0.8;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cur {
      display: block;
    }
  }
</style>

<script>
  const cur = document.querySelector<HTMLElement>('[data-cur]');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (cur && fine && !reduced) {
    const HOT = "a[href], button:not(:disabled), [role='button'], label, summary";
    const HIDE = "input:not([type='button'],[type='submit'],[type='checkbox'],[type='radio']), textarea, select, [contenteditable='true'], iframe";
    let tx = 0,
      ty = 0,
      x = 0,
      y = 0,
      seen = false,
      raf = 0,
      last = 0,
      state = '';

    const put = () => (cur.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`);
    const setState = (s: string) => {
      if (s !== state) cur.dataset.s = state = s;
    };
    const stateFor = (el: Element | null) => {
      if (!(el instanceof Element)) return 'dot';
      if (el.closest(HIDE)) return 'hidden';
      return el.closest(HOT) ? 'hover' : 'dot';
    };
    const tick = (now: number) => {
      const dt = last ? Math.min((now - last) / 1000, 0.05) : 1 / 60;
      last = now;
      const k = 1 - Math.exp(-7 * dt); // same follow rate as kargul.studio
      x += (tx - x) * k;
      y += (ty - y) * k;
      if (Math.abs(tx - x) < 0.05 && Math.abs(ty - y) < 0.05) {
        x = tx;
        y = ty;
        put();
        raf = 0;
        last = 0;
        return;
      }
      put();
      raf = requestAnimationFrame(tick);
    };

    document.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        tx = e.clientX;
        ty = e.clientY;
        if (!seen) {
          x = tx;
          y = ty;
          put();
          seen = true;
        }
        if (!raf) raf = requestAnimationFrame(tick);
        setState(stateFor(e.target as Element));
      },
      { passive: true },
    );
    // content moves under a resting pointer while scrolling
    let sq = false;
    addEventListener(
      'scroll',
      () => {
        if (!seen || sq) return;
        sq = true;
        requestAnimationFrame(() => {
          sq = false;
          setState(stateFor(document.elementFromPoint(tx, ty)));
        });
      },
      { passive: true },
    );
    document.addEventListener('pointerdown', (e) => e.pointerType === 'mouse' && cur.classList.add('down'), { passive: true });
    document.addEventListener('pointerup', () => cur.classList.remove('down'), { passive: true });
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget) {
        seen = false;
        setState('hidden');
      }
    });
    addEventListener('blur', () => {
      seen = false;
      setState('hidden');
    });
  }
</script>

<script>
  // Click sound (after kargul.studio): a very short, quiet synthesized "tick" when a mouse presses a link or button
  // (the testimonial arrows included). A falling sine chirp plus a tiny high-passed noise burst, about 60 ms.
  // No audio file; the AudioContext is created on the first click (browsers only allow audio after a gesture).
  if (matchMedia('(hover: hover) and (pointer: fine)').matches && 'AudioContext' in window) {
    const HOT = "a[href], button:not(:disabled), [role='button']:not([aria-disabled='true']), summary";
    let ac: AudioContext | null = null;
    let noise: AudioBuffer | null = null;
    const tick = () => {
      ac ??= new AudioContext();
      if (ac.state === 'suspended') ac.resume();
      const t = ac.currentTime;
      const osc = ac.createOscillator();
      const g = ac.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(1150, t);
      osc.frequency.exponentialRampToValueAtTime(540, t + 0.04);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.04, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.06);
      osc.connect(g).connect(ac.destination);
      osc.start(t);
      osc.stop(t + 0.07);
      if (!noise) {
        const n = Math.round(0.012 * ac.sampleRate);
        noise = ac.createBuffer(1, n, ac.sampleRate);
        const d = noise.getChannelData(0);
        for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * Math.exp(-i / (n / 6));
      }
      const src = ac.createBufferSource();
      const hp = ac.createBiquadFilter();
      const ng = ac.createGain();
      src.buffer = noise;
      hp.type = 'highpass';
      hp.frequency.value = 2800;
      ng.gain.value = 0.045;
      src.connect(hp).connect(ng).connect(ac.destination);
      src.start(t);
    };
    document.addEventListener(
      'pointerdown',
      (e) => {
        if (e.pointerType === 'mouse' && e.button === 0 && (e.target as Element)?.closest?.(HOT)) tick();
      },
      { passive: true },
    );
  }
</script>
