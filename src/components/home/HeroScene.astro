---
// Hero illustration: an isometric plinth with an exploded stack of layers hovering above it, in front of a slowly
// turning wireframe globe. Floating planes with square handles are linked to the plinth by flowing dashed lines.
// The stack leans toward the cursor; scrolling pulls the layers and planes apart (--p, set by script).
import { plane, corners, box, grid, cyl, arc, line } from './iso';

const g = grid(300, 30);
const plinth = box(-70, -70, 0, 140, 140, 44);
const R = 165;
const SY = -240; // globe centre y
const lats = [-0.66, -0.33, 0, 0.33, 0.66].map((t) => ({ cy: SY + t * R, rx: R * Math.sqrt(1 - t * t) }));
const meridians = [0, 1, 2, 3, 4, 5];

const gridIn = (x: number, y: number, z: number, w: number, d: number, n: number) => {
  let s = '';
  for (let i = 1; i < n; i++) s += line([[x + (w / n) * i, y, z], [x + (w / n) * i, y + d, z]]) + line([[x, y + (d / n) * i, z], [x + w, y + (d / n) * i, z]]);
  return s;
};
type Float = { d: string; k: string; handles?: [number, number][]; lift: number; link?: string };
const floats: Float[] = [
  { d: plane(-300, 40, 70, 90, 90), k: 'ghost', handles: corners(-300, 40, 70, 90, 90), lift: 60, link: arc([-255, 85, 70], [-70, 20, 44], 60) },
  { d: plane(40, -310, 110, 70, 70), k: 'white', handles: corners(40, -310, 110, 70, 70), lift: 90, link: arc([75, -275, 110], [20, -70, 44], 40) },
  { d: plane(150, 120, 40, 110, 60), k: 'ghost', handles: corners(150, 120, 40, 110, 60), lift: 40, link: arc([205, 150, 40], [70, 30, 44], 50) },
];
const can = cyl(-150, 150, 0, 30, 60);
const bars = [
  [150, -150, 30],
  [176, -150, 54],
  [202, -150, 40],
  [228, -150, 76],
].map(([x, y, h]) => box(x, y, 0, 18, 18, h));
const layers = [64, 120, 176].map((z, i) => ({
  z,
  d: plane(-60, -60, z, 120, 120),
  k: i === 2 ? 'white' : 'ghost',
  cells: gridIn(-60, -60, z, 120, 120, 4),
  chips: i === 1 ? [plane(-30, 0, z, 30, 30)] : [],
  h: corners(-60, -60, z, 120, 120),
}));
const posts = [[-60, -60], [60, -60], [60, 60], [-60, 60]].map(([x, y]) => line([[x, y, 44], [x, y, 176]])).join('');
---

<div class="hs" data-hs aria-hidden="true">
  <svg viewBox="-600 -420 1200 690" class="hs-svg">
    <defs>
      <radialGradient id="hs-fade" cx="50%" cy="55%" r="50%">
        <stop offset="0.35" stop-color="#fff"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </radialGradient>
      <mask id="hs-mask"><rect x="-600" y="-420" width="1200" height="690" fill="url(#hs-fade)"></rect></mask>
      <radialGradient id="hs-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#f5a524" stop-opacity="0.14"></stop>
        <stop offset="1" stop-color="#f5a524" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <path class="hs-grid" d={g} mask="url(#hs-mask)"></path>

    <!-- wireframe globe -->
    <g class="hs-moon">
      <circle cx="0" cy={SY} r={R + 70} fill="url(#hs-glow)" class="hs-halo"></circle>
      <circle cx="0" cy={SY} r={R} class="sp-o"></circle>
      {lats.map((l) => <ellipse cx="0" cy={l.cy} rx={l.rx.toFixed(1)} ry={(l.rx * 0.16).toFixed(1)} class="sp-l" />)}
      {meridians.map((m) => (
        <ellipse cx="0" cy={SY} rx={R} ry={R} class="sp-m">
          <animate attributeName="rx" values={`${R};0;${R}`} keyTimes="0;0.5;1" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1" dur="28s" begin={`-${(m * 28) / 12}s`} repeatCount="indefinite" />
        </ellipse>
      ))}
      <path class="sp-orbit" d={`M${-R - 110} ${SY + 40}A${R + 110} ${60} 0 1 0 ${R + 110} ${SY + 40}A${R + 110} 60 0 1 0 ${-R - 110} ${SY + 40}`} id="hs-orbit"></path>
      <rect class="sp-sat" x="-4" y="-4" width="8" height="8">
        <animateMotion dur="16s" repeatCount="indefinite" rotate="0"><mpath href="#hs-orbit"></mpath></animateMotion>
      </rect>
    </g>

    <!-- props on the floor -->
    <g class="hs-props">
      <g class="hs-can">
        <path d={can.side + can.front} class="ln"></path>
        <ellipse cx={can.top.cx} cy={can.top.cy} rx={can.top.rx} ry={can.top.ry} class="face"></ellipse>
      </g>
      {bars.map((b, i) => (
        <g class="hs-bar" style={`--i:${i}`}>
          <path d={b.right} class="r"></path>
          <path d={b.left} class="l"></path>
          <path d={b.top} class:list={[i === 3 ? 'amber' : 'face']}></path>
        </g>
      ))}
    </g>

    <!-- links and floating planes (behind the plinth) -->
    {floats.map((f, i) => (
      <g class="hs-float" style={`--lift:${f.lift};--i:${i}`}>
        {f.link && <path d={f.link} class="flow"></path>}
        <g class="bob" style={`--b:${i * 1.3}s`}>
          <path d={f.d} class={f.k}></path>
          {f.k === 'ghost' && <path d={i === 0 ? gridIn(-300, 40, 70, 90, 90, 3) : gridIn(150, 120, 40, 110, 60, 4)} class="ln"></path>}
          {f.handles?.map(([x, y]) => <rect class="hd" x={(x - 3).toFixed(1)} y={(y - 3).toFixed(1)} width="6" height="6" />)}
        </g>
      </g>
    ))}

    <!-- plinth -->
    <g class="hs-plinth">
      <path d={plinth.right} class="r"></path>
      <path d={plinth.left} class="l"></path>
      <path d={plinth.top} class="face"></path>
      {corners(-70, -70, 44, 140, 140).map(([x, y]) => <rect class="hd" x={(x - 3).toFixed(1)} y={(y - 3).toFixed(1)} width="6" height="6" />)}
    </g>

    <!-- the core: an exploded stack of layers above the plinth, leaning toward the cursor -->
    <g class="hs-core">
      {layers.map((l, i) => (
        <g class="hs-layer" style={`--i:${i};--z:${l.z}`}>
          <g class="bob" style={`--b:${i * 0.6}s`}>
            <path d={l.d} class={l.k}></path>
            <path d={l.cells} class={l.k === 'white' ? 'ink' : 'ln'}></path>
            {l.chips.map((c) => <path d={c} class="amber"></path>)}
            {l.h.map(([x, y]) => <rect class="hd" x={(x - 3).toFixed(1)} y={(y - 3).toFixed(1)} width="6" height="6" />)}
          </g>
        </g>
      ))}
      <path d={posts} class="dash"></path>
    </g>
  </svg>
</div>

<style>
  .hs {
    position: relative;
    width: min(1200px, 100%);
    margin: 0 auto;
    --p: 0;
  }
  .hs-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .hs :is(path, ellipse, circle, rect) {
    vector-effect: non-scaling-stroke;
  }
  .hs-grid {
    fill: none;
    stroke: rgba(255, 255, 255, 0.07);
    stroke-width: 1;
  }
  .sp-o,
  .sp-l,
  .sp-m {
    fill: none;
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1;
  }
  .sp-o {
    fill: #1b1b1b;
    stroke: rgba(255, 255, 255, 0.38);
  }
  .sp-l {
    stroke: rgba(255, 255, 255, 0.12);
  }
  .sp-orbit {
    fill: none;
    stroke: rgba(255, 255, 255, 0.22);
    stroke-dasharray: 3 6;
  }
  .sp-sat {
    fill: var(--amber);
    filter: drop-shadow(0 0 6px rgba(245, 165, 36, 0.9));
  }
  .hs-halo {
    transform-origin: 0 -240px;
    animation: hs-pulse 7s ease-in-out infinite;
  }
  @keyframes hs-pulse {
    50% {
      transform: scale(1.1);
      opacity: 0.6;
    }
  }
  .hs .ln {
    fill: none;
    stroke: rgba(255, 255, 255, 0.35);
  }
  .hs .face {
    fill: #262626;
    stroke: rgba(255, 255, 255, 0.55);
  }
  .hs .r {
    fill: #1f1f1f;
    stroke: rgba(255, 255, 255, 0.45);
  }
  .hs .l {
    fill: #171717;
    stroke: rgba(255, 255, 255, 0.45);
  }
  .hs .ghost {
    fill: rgba(255, 255, 255, 0.03);
    stroke: rgba(255, 255, 255, 0.45);
  }
  .hs .white {
    fill: #ededed;
    stroke: #fff;
  }
  .hs .amber {
    fill: var(--amber);
    stroke: #ffd690;
  }
  .hs .hd {
    fill: #1a1a1a;
    stroke: rgba(255, 255, 255, 0.8);
  }
  .hs .flow {
    fill: none;
    stroke: rgba(255, 255, 255, 0.3);
    stroke-dasharray: 4 6;
    animation: flow 1.4s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -20;
    }
  }
  .hs-float {
    transform: translateY(calc(var(--p) * var(--lift) * -1px));
  }
  .hs-float .bob,
  .hs-can {
    animation: bob 6s ease-in-out infinite;
    animation-delay: var(--b, 0s);
  }
  @keyframes bob {
    50% {
      transform: translateY(-8px);
    }
  }
  .hs-bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: bar 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.2s);
  }
  @keyframes bar {
    50% {
      transform: scaleY(0.82);
    }
  }
  .hs-moon {
    transform: translateY(calc(var(--p) * 50px));
  }

  .hs .ink {
    fill: none;
    stroke: rgba(0, 0, 0, 0.25);
  }
  .hs .dash {
    fill: none;
    stroke: rgba(255, 255, 255, 0.25);
    stroke-dasharray: 3 5;
  }
  .hs-core {
    transform: translate(var(--mx, 0px), var(--my, 0px));
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hs-layer {
    transform: translate(calc(var(--mx, 0px) * var(--i) * 0.6), calc(var(--my, 0px) * var(--i) * 0.6 - var(--p) * var(--i) * 40px));
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hs-layer .bob {
    animation: bob 6s ease-in-out infinite var(--b);
  }

  /* entrance: the floor fades in, the plinth rises, the layers land, the planes drop in */
  .hs-grid,
  .hs-moon,
  .hs-props,
  .hs-plinth,
  .hs-layer > *,
  .hs-core > .dash,
  .hs-float > * {
    opacity: 0;
    animation: hs-in 1.2s var(--ease) forwards;
  }
  .hs-grid {
    animation-delay: 0.5s;
  }
  .hs-moon {
    animation-delay: 0.7s;
  }
  .hs-plinth {
    animation-delay: 0.9s;
  }
  .hs-props {
    animation-delay: 1.1s;
  }
  .hs-core > .dash {
    animation-delay: 1.1s;
  }
  .hs-layer > * {
    animation-name: hs-land;
    animation-delay: calc(1.1s + var(--i) * 0.18s);
  }
  .hs-layer .bob {
    animation: hs-land 1.2s var(--ease) forwards calc(1.1s + var(--i) * 0.18s), bob 6s ease-in-out infinite var(--b);
  }
  .hs-float > * {
    animation-delay: calc(1.4s + var(--i) * 0.15s);
  }
  .hs-float .bob {
    animation: hs-in 1.2s var(--ease) forwards calc(1.4s + var(--i) * 0.15s), bob 6s ease-in-out infinite var(--b);
  }
  @keyframes hs-in {
    from {
      opacity: 0;
      transform: translateY(-24px);
    }
    to {
      opacity: 1;
    }
  }
  @keyframes hs-land {
    from {
      opacity: 0;
      transform: translateY(-60px);
    }
    70% {
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs *,
    .hs-float .bob {
      animation: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  const hs = document.querySelector<HTMLElement>('[data-hs]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hs && !reduced) {
    // the layer stack leans toward the cursor
    addEventListener(
      'pointermove',
      (e) => {
        const r = hs.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) / innerWidth;
        const dy = (e.clientY - (r.top + r.height * 0.4)) / innerHeight;
        hs.style.setProperty('--mx', `${(dx * 24).toFixed(1)}px`);
        hs.style.setProperty('--my', `${(dy * 16).toFixed(1)}px`);
      },
      { passive: true },
    );
    // scrolling pulls the floating planes and layers up and apart (exploded view)
    const onScroll = () => {
      const r = hs.getBoundingClientRect();
      const p = Math.max(0, Math.min(1, 1 - (r.bottom - innerHeight * 0.2) / r.height));
      hs.style.setProperty('--p', p.toFixed(3));
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
