---
// Site footer shared by the homepage and /founders: contact details, link columns, and the giant outlined
// ERGON wordmark, which draws itself in when it scrolls into view; then the owl lands on the N.
import OwlMark from './OwlMark.astro';
import { brand, nvNav } from '../../nuvareth';

const onHome = Astro.url.pathname === '/';
// the "AI in production" section was replaced by testimonials
const links = nvNav.flatMap((n) => (n.href === '#ai' ? [{ label: 'Testimonials', href: '#testimonials' }] : [n]));
const nav = [...links.map((n) => ({ ...n, href: onHome ? n.href : `/${n.href}` })), { label: 'Founders', href: '/founders' }];
const year = new Date().getFullYear();
---

<footer class="foot dk">
  <div class="wrap foot-in">
    <div class="foot-talk">
      <a class="brand" href="/" aria-label={brand.name}><OwlMark /><span>{brand.name}</span></a>
      <h2>Let's talk.</h2>
      <p>Email us directly or find us online.</p>
      <div class="mail-row">
        <a class="mail" href={`mailto:${brand.email}`}>{brand.email}</a>
        <button class="copy" type="button" data-copy={brand.email} aria-label="Copy email address"><span data-copy-label>Copy</span></button>
      </div>
    </div>
    <div class="foot-cols">
      <div>
        <p class="foot-h">Pages</p>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
      <div>
        <p class="foot-h">Contact</p>
        <a href={`mailto:${brand.email}`}>Email</a>
        {brand.socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </div>
    </div>
  </div>
  <div class="wrap foot-base">
    <span>© {year} {brand.name}. All rights reserved.</span>
  </div>
  <svg class="giant" viewBox="0 -120 1000 330" aria-hidden="true" data-giant>
    <g class="giant-owl"><OwlMark x={842} y={-104} width={112} height={140} /></g>
    <text x="500" y="190" text-anchor="middle" textLength="990" lengthAdjust="spacingAndGlyphs">ERGON</text>
  </svg>
</footer>
