---
// Hero illustration: an isometric field of square pillars drawn on a canvas, in the light theme's greys. Slow
// waves roll across it, the pillars under the cursor rise into a hill (the cursor's position is projected back
// onto the grid), the tallest crests turn charcoal, a few tiles flash dark now and then, and the field rises
// from the centre outwards on load. Edges fade into the page.
// Performance: 17 x 17 pillars, colours precomputed into lookup tables (no per-pillar string building), device
// pixel ratio capped at 1.5, and the loop stops while the hero is offscreen. One still frame for reduced motion.
---

<div class="hf" aria-hidden="true">
  <canvas data-hf></canvas>
</div>

<style>
  .hf {
    position: relative;
    width: min(1180px, 100%);
    margin: 0 auto;
    aspect-ratio: 2.15 / 1;
    max-height: 560px;
  }
  .hf canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (max-width: 700px) {
    .hf {
      aspect-ratio: 1.25 / 1;
    }
  }
</style>

<script>
  const cv = document.querySelector<HTMLCanvasElement>('[data-hf]');
  if (cv) {
    const ctx = cv.getContext('2d', { alpha: true })!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = 17;
    const C = Math.cos(Math.PI / 6);
    const S = 0.5;
    const G = 0.16; // gap inside each cell
    let W = 0,
      H = 0,
      cell = 0,
      ox = 0,
      oy = 0,
      dpr = 1;

    // colour lookup tables, 0..LV-1 from flat to crest
    const LV = 48;
    const lerp = (a: number, b: number, t: number) => Math.round(a + (b - a) * t);
    const rgb = (v: number) => `rgb(${v},${v},${v})`;
    const TOP = Array.from({ length: LV }, (_, k) => rgb(lerp(250, 35, (k / (LV - 1)) ** 2)));
    const EDGE = Array.from({ length: LV }, (_, k) => `rgba(35,35,35,${(0.22 + (k / (LV - 1)) * 0.5).toFixed(3)})`);
    const RIGHT = '#e4e4e4';
    const LEFT = '#d7d7d7';
    const SPARK = '#232323';

    // static per-cell data in back-to-front draw order: centre distance, edge fade, flashing cells
    let seed = 3;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const sparkAt = new Map<number, { p: number; d: number }>();
    for (let k = 0; k < 7; k++) sparkAt.set(Math.floor(rnd() * N) * N + Math.floor(rnd() * N), { p: rnd() * 9, d: 5 + rnd() * 6 });
    const cells: { i: number; j: number; d: number; fade: number; spark: number }[] = [];
    for (let s = 0; s <= 2 * (N - 1); s++) {
      for (let i = Math.max(0, s - N + 1); i <= Math.min(N - 1, s); i++) {
        const j = s - i;
        const d = Math.hypot(i - N / 2 + 0.5, j - N / 2 + 0.5);
        const fade = Math.max(0, Math.min(1, (1.08 - d / (N / 2)) / 0.45));
        if (fade > 0.01) cells.push({ i, j, d, fade, spark: sparkAt.has(i * N + j) ? i * N + j : -1 });
      }
    }

    let mi = -99,
      mj = -99,
      ti = -99,
      tj = -99,
      hover = 0,
      hoverT = 0;

    const resize = () => {
      const r = cv.getBoundingClientRect();
      dpr = Math.min(1.5, devicePixelRatio || 1);
      W = r.width;
      H = r.height;
      cv.width = Math.round(W * dpr);
      cv.height = Math.round(H * dpr);
      cell = Math.min((W / (2 * N * C)) * 1.02, (H * 0.92) / (N * S * 2 + 3.2));
      ox = W / 2;
      oy = H * 0.5 - N * cell * S + cell * 2.4;
    };

    addEventListener(
      'pointermove',
      (e) => {
        const r = cv.getBoundingClientRect();
        const px = (e.clientX - r.left - ox) / (C * cell);
        const py = (e.clientY - r.top - oy + cell * 0.8) / (S * cell);
        ti = (px + py) / 2 - 0.5;
        tj = (py - px) / 2 - 0.5;
        hoverT = ti > -3 && tj > -3 && ti < N + 3 && tj < N + 3 ? 1 : 0;
      },
      { passive: true },
    );

    const t0 = performance.now();
    let running = true;
    let raf = 0;

    const frame = (now: number) => {
      const t = ((now - t0) / 1000) * 1.15;
      const intro = reduced ? 1 : Math.min(1, (now - t0) / 1800);
      mi += (ti - mi) * 0.14;
      mj += (tj - mj) * 0.14;
      hover += (hoverT - hover) * 0.06;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.lineWidth = 1;
      ctx.lineJoin = 'round';
      const cs = C * cell;
      const ss = S * cell;

      // floor grid
      ctx.globalAlpha = intro;
      ctx.strokeStyle = 'rgba(0,0,0,0.06)';
      ctx.beginPath();
      for (let k = -4; k <= N + 4; k++) {
        ctx.moveTo(ox + (k + 4) * cs, oy + (k - 4) * ss);
        ctx.lineTo(ox + (k - N - 4) * cs, oy + (k + N + 4) * ss);
        ctx.moveTo(ox + (-4 - k) * cs, oy + (k - 4) * ss);
        ctx.lineTo(ox + (N + 4 - k) * cs, oy + (k + N + 4) * ss);
      }
      ctx.stroke();

      for (const c of cells) {
        const { i, j, d } = c;
        const cx = i - N / 2 + 0.5;
        const cy = j - N / 2 + 0.5;
        let h =
          0.55 * Math.sin(cx * 0.5 + t * 0.9) * Math.cos(cy * 0.44 - t * 0.7) +
          0.45 * Math.sin(d * 0.9 - t * 1.6) * Math.max(0, 1 - d / (N * 0.75));
        h = 1.05 + h * 1.25;
        if (hover > 0.01) h += hover * 3.4 * Math.exp(-((i - mi) ** 2 + (j - mj) ** 2) / 5);
        const k = Math.max(0, Math.min(1, intro * 1.6 - d / (N * 0.6)));
        h = Math.max(0.15, h) * (k * k * (3 - 2 * k));
        if (h <= 0.01) continue;

        const lv = Math.max(0, Math.min(LV - 1, Math.round(((h - 1.5) / 1.9) * (LV - 1))));
        let top = TOP[lv];
        let edge = EDGE[lv];
        if (c.spark >= 0) {
          const sp = sparkAt.get(c.spark)!;
          if (((t + sp.p) % sp.d) / sp.d < 0.2) {
            top = SPARK;
            edge = EDGE[LV - 1];
          }
        }

        // pillar corners on screen (world x/y in cells, z = height in px)
        const x0 = i + G,
          x1 = i + 1 - G,
          y0 = j + G,
          y1 = j + 1 - G;
        const z = h * cell;
        const Ax = ox + (x0 - y0) * cs,
          Ay = oy + (x0 + y0) * ss;
        const Bx = ox + (x1 - y0) * cs,
          By = oy + (x1 + y0) * ss;
        const Cx = ox + (x1 - y1) * cs,
          Cy = oy + (x1 + y1) * ss;
        const Dx = ox + (x0 - y1) * cs,
          Dy = oy + (x0 + y1) * ss;

        ctx.globalAlpha = c.fade * intro;
        ctx.strokeStyle = edge;
        ctx.beginPath();
        ctx.moveTo(Bx, By - z);
        ctx.lineTo(Cx, Cy - z);
        ctx.lineTo(Cx, Cy);
        ctx.lineTo(Bx, By);
        ctx.closePath();
        ctx.fillStyle = RIGHT;
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(Dx, Dy - z);
        ctx.lineTo(Cx, Cy - z);
        ctx.lineTo(Cx, Cy);
        ctx.lineTo(Dx, Dy);
        ctx.closePath();
        ctx.fillStyle = LEFT;
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(Ax, Ay - z);
        ctx.lineTo(Bx, By - z);
        ctx.lineTo(Cx, Cy - z);
        ctx.lineTo(Dx, Dy - z);
        ctx.closePath();
        ctx.fillStyle = top;
        ctx.fill();
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      if (running && !reduced) raf = requestAnimationFrame(frame);
    };

    resize();
    new ResizeObserver(() => {
      resize();
      if (reduced) frame(t0 + 10000);
    }).observe(cv);

    if (reduced) {
      frame(t0 + 10000);
    } else {
      new IntersectionObserver(([e]) => {
        const was = running;
        running = e.isIntersecting;
        if (running && !was) raf = requestAnimationFrame(frame);
        if (!running) cancelAnimationFrame(raf);
      }).observe(cv);
      raf = requestAnimationFrame(frame);
    }
  }
</script>
