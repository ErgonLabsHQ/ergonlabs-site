---
// Hero illustration: an isometric field of square pillars drawn on a canvas, in the light theme's greys. Slow
// waves roll across it, the pillars under the cursor rise into a hill (the cursor's position is projected back
// onto the grid), the tallest crests turn charcoal, a few tiles flash dark now and then, and the field rises
// from the centre outwards on load. Edges fade into the page.
// Performance: each pillar variant (height step x flashing) is drawn once into a small cached canvas and copied
// with drawImage each frame; the floor grid is drawn once per size. Device pixel ratio capped at 1.25, and the
// loop stops while the hero is offscreen. One still frame for reduced motion.
---

<div class="hf" aria-hidden="true">
  <canvas data-hf></canvas>
</div>

<style>
  .hf {
    position: relative;
    width: min(1180px, 100%);
    margin: 0 auto;
    aspect-ratio: 2.15 / 1;
    max-height: 560px;
  }
  .hf canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (max-width: 700px) {
    .hf {
      aspect-ratio: 1.25 / 1;
    }
  }
</style>

<script>
  const cv = document.querySelector<HTMLCanvasElement>('[data-hf]');
  if (cv) {
    const ctx = cv.getContext('2d', { alpha: true })!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = 17;
    const C = Math.cos(Math.PI / 6);
    const S = 0.5;
    const G = 0.16; // gap inside each cell
    let W = 0,
      H = 0,
      cell = 0,
      ox = 0,
      oy = 0,
      dpr = 1;

    // colour lookup tables, 0..LV-1 from flat to crest
    const LV = 48;
    const lerp = (a: number, b: number, t: number) => Math.round(a + (b - a) * t);
    const rgb = (v: number) => `rgb(${v},${v},${v})`;
    const TOP = Array.from({ length: LV }, (_, k) => rgb(lerp(250, 35, (k / (LV - 1)) ** 2)));
    const EDGE = Array.from({ length: LV }, (_, k) => `rgba(35,35,35,${(0.22 + (k / (LV - 1)) * 0.5).toFixed(3)})`);
    const RIGHT = '#e4e4e4';
    const LEFT = '#d7d7d7';
    const SPARK = '#232323';

    // static per-cell data in back-to-front draw order: centre distance, edge fade, flashing cells
    let seed = 3;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const sparkAt = new Map<number, { p: number; d: number }>();
    for (let k = 0; k < 7; k++) sparkAt.set(Math.floor(rnd() * N) * N + Math.floor(rnd() * N), { p: rnd() * 9, d: 5 + rnd() * 6 });
    const cells: { i: number; j: number; d: number; fade: number; spark: number }[] = [];
    for (let s = 0; s <= 2 * (N - 1); s++) {
      for (let i = Math.max(0, s - N + 1); i <= Math.min(N - 1, s); i++) {
        const j = s - i;
        const d = Math.hypot(i - N / 2 + 0.5, j - N / 2 + 0.5);
        const fade = Math.max(0, Math.min(1, (1.08 - d / (N / 2)) / 0.45));
        if (fade > 0.01) cells.push({ i, j, d, fade, spark: sparkAt.has(i * N + j) ? i * N + j : -1 });
      }
    }

    let mi = -99,
      mj = -99,
      ti = -99,
      tj = -99,
      hover = 0,
      hoverT = 0;

    // canvas position in page coordinates, so pointer moves never have to measure the layout
    let pageL = 0,
      pageT = 0;
    const resize = () => {
      const r = cv.getBoundingClientRect();
      pageL = r.left + scrollX;
      pageT = r.top + scrollY;
      dpr = Math.min(1.25, devicePixelRatio || 1);
      W = r.width;
      H = r.height;
      cv.width = Math.round(W * dpr);
      cv.height = Math.round(H * dpr);
      cell = Math.min((W / (2 * N * C)) * 1.02, (H * 0.92) / (N * S * 2 + 3.2));
      ox = W / 2;
      oy = H * 0.5 - N * cell * S + cell * 2.4;
      prerender();
    };

    addEventListener(
      'pointermove',
      (e) => {
        const px = (e.clientX - (pageL - scrollX) - ox) / (C * cell);
        const py = (e.clientY - (pageT - scrollY) - oy + cell * 0.8) / (S * cell);
        ti = (px + py) / 2 - 0.5;
        tj = (py - px) / 2 - 0.5;
        hoverT = ti > -3 && tj > -3 && ti < N + 3 && tj < N + 3 ? 1 : 0;
      },
      { passive: true },
    );

    // Pre-drawn pillars. Every pillar has the same footprint, so its look depends only on its height (quantised to
    // 1/HQ of a cell, about a pixel) and whether it is flashing. Each variant is drawn once into a small canvas and
    // then copied with drawImage, instead of filling and stroking three shapes per pillar on every frame.
    const HQ = 32;
    type Sprite = { img: HTMLCanvasElement; ax: number; ay: number };
    let sprites = new Map<number, Sprite>();
    let floor: HTMLCanvasElement | null = null;
    const sprite = (q: number, spark: boolean): Sprite => {
      const key = q * 2 + (spark ? 1 : 0);
      const hit = sprites.get(key);
      if (hit) return hit;
      const h = q / HQ;
      const cs = C * cell * dpr,
        ss = S * cell * dpr,
        z = h * cell * dpr,
        pad = 2;
      const hw = (1 - 2 * G) * cs;
      const minY = 2 * G * ss - z,
        maxY = 2 * (1 - G) * ss;
      const img = document.createElement('canvas');
      img.width = Math.ceil(hw * 2 + pad * 2);
      img.height = Math.ceil(maxY - minY + pad * 2);
      const g = img.getContext('2d')!;
      const ax = hw + pad,
        ay = -minY + pad; // where the cell origin sits inside the sprite
      g.translate(ax, ay);
      g.lineWidth = dpr;
      g.lineJoin = 'round';
      const lv = Math.max(0, Math.min(LV - 1, Math.round(((h - 1.5) / 1.9) * (LV - 1))));
      g.strokeStyle = spark ? EDGE[LV - 1] : EDGE[lv];
      const A = [0, 2 * G * ss],
        B = [hw, ss],
        Cc = [0, 2 * (1 - G) * ss],
        D = [-hw, ss];
      const face = (pts: number[][], fill: string) => {
        g.beginPath();
        g.moveTo(pts[0][0], pts[0][1]);
        for (let n = 1; n < pts.length; n++) g.lineTo(pts[n][0], pts[n][1]);
        g.closePath();
        g.fillStyle = fill;
        g.fill();
        g.stroke();
      };
      face([[B[0], B[1] - z], [Cc[0], Cc[1] - z], Cc, B], RIGHT);
      face([[D[0], D[1] - z], [Cc[0], Cc[1] - z], Cc, D], LEFT);
      face([[A[0], A[1] - z], [B[0], B[1] - z], [Cc[0], Cc[1] - z], [D[0], D[1] - z]], spark ? SPARK : TOP[lv]);
      const out = { img, ax: Math.round(ax), ay: Math.round(ay) };
      sprites.set(key, out);
      return out;
    };
    const prerender = () => {
      sprites = new Map();
      floor = document.createElement('canvas');
      floor.width = cv.width;
      floor.height = cv.height;
      const g = floor.getContext('2d')!;
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.lineWidth = 1;
      g.strokeStyle = 'rgba(0,0,0,0.06)';
      const cs = C * cell,
        ss = S * cell;
      g.beginPath();
      for (let k = -4; k <= N + 4; k++) {
        g.moveTo(ox + (k + 4) * cs, oy + (k - 4) * ss);
        g.lineTo(ox + (k - N - 4) * cs, oy + (k + N + 4) * ss);
        g.moveTo(ox + (-4 - k) * cs, oy + (k - 4) * ss);
        g.lineTo(ox + (N + 4 - k) * cs, oy + (k + N + 4) * ss);
      }
      g.stroke();
    };

    const t0 = performance.now();
    let running = true;
    let raf = 0;
    let last = t0;
    // frame-rate independent easing: the same feel at 60 Hz and 120 Hz
    const ease = (k: number, dt: number) => 1 - Math.pow(1 - k, dt * 60);

    const frame = (now: number) => {
      const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
      last = now;
      const t = ((now - t0) / 1000) * 1.15;
      const intro = reduced ? 1 : Math.min(1, (now - t0) / 1800);
      mi += (ti - mi) * ease(0.14, dt);
      mj += (tj - mj) * ease(0.14, dt);
      hover += (hoverT - hover) * ease(0.06, dt);

      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, cv.width, cv.height);
      const cs = C * cell;
      const ss = S * cell;

      // floor grid: drawn once per size, copied each frame
      if (floor) {
        ctx.globalAlpha = intro;
        ctx.drawImage(floor, 0, 0);
      }

      for (const c of cells) {
        const { i, j, d } = c;
        const cx = i - N / 2 + 0.5;
        const cy = j - N / 2 + 0.5;
        let h =
          0.55 * Math.sin(cx * 0.5 + t * 0.9) * Math.cos(cy * 0.44 - t * 0.7) +
          0.45 * Math.sin(d * 0.9 - t * 1.6) * Math.max(0, 1 - d / (N * 0.75));
        h = 1.05 + h * 1.25;
        if (hover > 0.01) h += hover * 3.4 * Math.exp(-((i - mi) ** 2 + (j - mj) ** 2) / 5);
        const k = Math.max(0, Math.min(1, intro * 1.6 - d / (N * 0.6)));
        h = Math.max(0.15, h) * (k * k * (3 - 2 * k));
        if (h <= 0.01) continue;

        let spark = false;
        if (c.spark >= 0) {
          const sp = sparkAt.get(c.spark)!;
          spark = ((t + sp.p) % sp.d) / sp.d < 0.2;
        }
        const q = Math.round(h * HQ);
        const spr = sprite(q, spark);
        ctx.globalAlpha = c.fade * intro;
        ctx.drawImage(spr.img, Math.round((ox + (i - j) * cs) * dpr) - spr.ax, Math.round((oy + (i + j) * ss) * dpr) - spr.ay);
      }
      ctx.globalAlpha = 1;
      if (running && !reduced) raf = requestAnimationFrame(frame);
    };

    resize();
    addEventListener('load', resize);
    new ResizeObserver(() => {
      resize();
      if (reduced) frame(t0 + 10000);
    }).observe(cv);

    if (reduced) {
      frame(t0 + 10000);
    } else {
      new IntersectionObserver(([e]) => {
        const was = running;
        running = e.isIntersecting;
        if (running && !was) {
          last = performance.now();
          raf = requestAnimationFrame(frame);
        }
        if (!running) cancelAnimationFrame(raf);
      }).observe(cv);
      raf = requestAnimationFrame(frame);
    }
  }
</script>
