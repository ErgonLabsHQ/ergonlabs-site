---
// Hero illustration: an isometric field of square pillars drawn on a canvas in hairlines. Slow waves roll across
// it, the pillars under the cursor rise into a hill (the cursor's position is projected back onto the grid), a few
// tiles pulse amber like work in flight, and the field rises from the centre outwards on load. Edges fade into
// the page. It pauses offscreen and draws one still frame when motion is reduced.
---

<div class="hf" aria-hidden="true">
  <canvas data-hf></canvas>
</div>

<style>
  .hf {
    position: relative;
    width: min(1280px, 100%);
    margin: 0 auto;
    aspect-ratio: 2.15 / 1;
    max-height: 600px;
  }
  .hf canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (max-width: 700px) {
    .hf {
      aspect-ratio: 1.25 / 1;
    }
  }
</style>

<script>
  const cv = document.querySelector<HTMLCanvasElement>('[data-hf]');
  if (cv) {
    const ctx = cv.getContext('2d')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = 21; // grid is N x N
    const C = Math.cos(Math.PI / 6);
    const S = 0.5;
    let W = 0,
      H = 0,
      cell = 0,
      ox = 0,
      oy = 0,
      dpr = 1;

    // a few tiles that light up amber now and then
    let seed = 3;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const sparks = Array.from({ length: 9 }, () => ({ i: Math.floor(rnd() * N), j: Math.floor(rnd() * N), p: rnd() * 9, d: 6 + rnd() * 6 }));

    // pointer, projected onto the grid (smoothed)
    let mi = -99,
      mj = -99,
      ti = -99,
      tj = -99,
      hover = 0,
      hoverT = 0;

    const resize = () => {
      const r = cv.getBoundingClientRect();
      dpr = Math.min(2, devicePixelRatio || 1);
      W = r.width;
      H = r.height;
      cv.width = Math.round(W * dpr);
      cv.height = Math.round(H * dpr);
      // fit the diamond: width = 2 * N * cell * C
      cell = Math.min(W / (2 * N * C) * 1.02, (H * 0.92) / (N * S * 2 + 3.2));
      ox = W / 2;
      oy = H * 0.5 - N * cell * S + cell * 2.4;
    };

    const proj = (x: number, y: number, z: number) => [ox + (x - y) * C * cell, oy + (x + y) * S * cell - z * cell];

    addEventListener(
      'pointermove',
      (e) => {
        const r = cv.getBoundingClientRect();
        const px = (e.clientX - r.left - ox) / (C * cell);
        const py = (e.clientY - r.top - oy + cell * 0.8) / (S * cell);
        // x - y = px, x + y = py
        ti = (px + py) / 2 - 0.5;
        tj = (py - px) / 2 - 0.5;
        hoverT = ti > -3 && tj > -3 && ti < N + 3 && tj < N + 3 ? 1 : 0;
      },
      { passive: true },
    );

    const height = (i: number, j: number, t: number, intro: number) => {
      const cx = i - N / 2 + 0.5;
      const cy = j - N / 2 + 0.5;
      const d = Math.hypot(cx, cy);
      // two slow interfering waves plus a ripple from the centre
      let h =
        0.55 * Math.sin(cx * 0.42 + t * 0.9) * Math.cos(cy * 0.36 - t * 0.7) +
        0.45 * Math.sin(d * 0.75 - t * 1.6) * Math.max(0, 1 - d / (N * 0.75));
      h = 1.05 + h * 1.25;
      // the hill under the cursor
      const md = (i - mi) ** 2 + (j - mj) ** 2;
      h += hover * 3.4 * Math.exp(-md / 6);
      // rise from the centre on load
      const k = Math.max(0, Math.min(1, intro * 1.6 - d / (N * 0.6)));
      return Math.max(0.15, h) * (k * k * (3 - 2 * k));
    };

    const fadeAt = (i: number, j: number) => {
      const d = Math.hypot(i - N / 2 + 0.5, j - N / 2 + 0.5) / (N / 2);
      return Math.max(0, Math.min(1, (1.08 - d) / 0.45));
    };

    const pillar = (i: number, j: number, h: number, a: number, top: string, edge: string) => {
      const g = 0.16; // gap inside the cell
      const x0 = i + g,
        y0 = j + g,
        x1 = i + 1 - g,
        y1 = j + 1 - g;
      const A = proj(x0, y0, h),
        B = proj(x1, y0, h),
        Cc = proj(x1, y1, h),
        D = proj(x0, y1, h);
      const B0 = proj(x1, y0, 0),
        C0 = proj(x1, y1, 0),
        D0 = proj(x0, y1, 0);
      ctx.globalAlpha = a;
      ctx.strokeStyle = edge;
      // right face
      ctx.beginPath();
      ctx.moveTo(B[0], B[1]);
      ctx.lineTo(Cc[0], Cc[1]);
      ctx.lineTo(C0[0], C0[1]);
      ctx.lineTo(B0[0], B0[1]);
      ctx.closePath();
      ctx.fillStyle = '#1f1f1f';
      ctx.fill();
      ctx.stroke();
      // left face
      ctx.beginPath();
      ctx.moveTo(D[0], D[1]);
      ctx.lineTo(Cc[0], Cc[1]);
      ctx.lineTo(C0[0], C0[1]);
      ctx.lineTo(D0[0], D0[1]);
      ctx.closePath();
      ctx.fillStyle = '#171717';
      ctx.fill();
      ctx.stroke();
      // top
      ctx.beginPath();
      ctx.moveTo(A[0], A[1]);
      ctx.lineTo(B[0], B[1]);
      ctx.lineTo(Cc[0], Cc[1]);
      ctx.lineTo(D[0], D[1]);
      ctx.closePath();
      ctx.fillStyle = top;
      ctx.fill();
      ctx.stroke();
    };

    const mix = (a: number, b: number, t: number) => Math.round(a + (b - a) * t);
    let t0 = performance.now();
    let running = true;

    const frame = (now: number) => {
      const t = (now - t0) / 1000;
      const intro = reduced ? 1 : Math.min(1, t / 2.2);
      mi += (ti - mi) * 0.12;
      mj += (tj - mj) * 0.12;
      hover += (hoverT - hover) * 0.05;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.lineWidth = 1;
      ctx.lineJoin = 'round';

      // floor grid
      ctx.globalAlpha = 0.5 * intro;
      ctx.strokeStyle = 'rgba(255,255,255,0.06)';
      ctx.beginPath();
      for (let k = -4; k <= N + 4; k++) {
        let [a, b] = proj(k, -4, 0);
        let [c, d] = proj(k, N + 4, 0);
        ctx.moveTo(a, b);
        ctx.lineTo(c, d);
        [a, b] = proj(-4, k, 0);
        [c, d] = proj(N + 4, k, 0);
        ctx.moveTo(a, b);
        ctx.lineTo(c, d);
      }
      ctx.stroke();

      // pillars, back to front
      for (let s = 0; s <= 2 * (N - 1); s++) {
        for (let i = Math.max(0, s - N + 1); i <= Math.min(N - 1, s); i++) {
          const j = s - i;
          const a = fadeAt(i, j);
          if (a <= 0.01) continue;
          const h = height(i, j, t, intro);
          if (h <= 0.01) continue;
          // brighter tops on the crests
          const lift = Math.max(0, Math.min(1, (h - 1.5) / 1.9));
          let top = `rgb(${mix(42, 236, lift * lift)},${mix(42, 236, lift * lift)},${mix(42, 236, lift * lift)})`;
          let edge = `rgba(255,255,255,${(0.28 + lift * 0.5).toFixed(3)})`;
          for (const sp of sparks) {
            if (sp.i === i && sp.j === j) {
              const ph = ((t + sp.p) % sp.d) / sp.d;
              const glow = ph < 0.25 ? Math.sin((ph / 0.25) * Math.PI) : 0;
              if (glow > 0) {
                top = `rgb(${mix(42, 245, glow)},${mix(42, 165, glow)},${mix(42, 36, glow)})`;
                edge = `rgba(255,214,144,${(0.3 + glow * 0.6).toFixed(3)})`;
              }
            }
          }
          pillar(i, j, h, a * intro, top, edge);
        }
      }
      ctx.globalAlpha = 1;
      if (running && !reduced) requestAnimationFrame(frame);
    };

    resize();
    new ResizeObserver(() => {
      resize();
      if (reduced) frame(t0 + 10000);
    }).observe(cv);

    if (reduced) {
      frame(t0 + 10000);
    } else {
      new IntersectionObserver(([e]) => {
        const was = running;
        running = e.isIntersecting;
        if (running && !was) requestAnimationFrame(frame);
      }).observe(cv);
      requestAnimationFrame(frame);
    }
  }
</script>
