---
// Homepage behaviour: nav state and mobile menu, scroll reveals, word-split headings, isometric scenes that
// assemble on entry, card hover tilt, the "Our view" words lighting up with scroll, the process rail, the
// architecture demo data, the giant footer wordmark drawing itself, ambient stars, copy-email and the form.
---

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.documentElement.classList.add('js');

  // nav
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  burger?.addEventListener('click', () => {
    const open = nav!.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('[data-sheet] a').forEach((a) =>
    a.addEventListener('click', () => {
      nav?.classList.remove('open');
      burger?.setAttribute('aria-expanded', 'false');
    }),
  );

  // split headings into words that rise in
  document.querySelectorAll<HTMLElement>('[data-split]').forEach((h) => {
    const text = h.textContent ?? '';
    h.setAttribute('aria-label', text);
    h.innerHTML = text
      .split(' ')
      .map((w, i) => `<span class="sw" aria-hidden="true"><span style="--w:${i}">${w}</span></span>`)
      .join(' ');
  });

  // reveals
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('[data-r], [data-split], [data-iso], [data-giant]').forEach((el) => io.observe(el));

  // card tilt toward the cursor
  if (!reduced && matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((c) => {
      c.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty('--rx', `${(((e.clientY - r.top) / r.height - 0.5) * -3).toFixed(2)}deg`);
        c.style.setProperty('--ry', `${(((e.clientX - r.left) / r.width - 0.5) * 3).toFixed(2)}deg`);
        c.style.setProperty('--gx', `${e.clientX - r.left}px`);
        c.style.setProperty('--gy', `${e.clientY - r.top}px`);
      });
      c.addEventListener('pointerleave', () => {
        c.style.setProperty('--rx', '0deg');
        c.style.setProperty('--ry', '0deg');
      });
    });
  }

  // scroll-driven: "Our view" words and the process rail
  const mfText = document.querySelector<HTMLElement>('[data-mf-text]');
  const mfWords = mfText ? [...mfText.querySelectorAll('span')] : [];
  const tl = document.querySelector<HTMLElement>('[data-tl]');
  const tlFill = document.querySelector<HTMLElement>('[data-tl-fill]');
  const tlItems = [...document.querySelectorAll<HTMLElement>('[data-tl-item]')];
  const onScroll = () => {
    nav?.classList.toggle('scrolled', scrollY > 24);
    if (mfText) {
      const r = mfText.getBoundingClientRect();
      const p = Math.max(0, Math.min(1, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35)));
      const n = reduced ? mfWords.length : Math.round(p * mfWords.length);
      mfWords.forEach((w, i) => w.classList.toggle('lit', i < n));
    }
    if (tl && tlFill) {
      const r = tl.getBoundingClientRect();
      const p = reduced ? 1 : Math.max(0, Math.min(1, (innerHeight * 0.7 - r.top) / (r.height * 0.8)));
      tlFill.style.setProperty("--p", p.toFixed(3));
      tlItems.forEach((it, i) => it.classList.toggle('on', p >= i / tlItems.length + 0.02));
    }
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ambient stars in the hero and contact sections
  document.querySelectorAll<HTMLElement>('[data-stars]').forEach((box) => {
    let seed = box.classList.contains('dim') ? 11 : 7;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    let html = '';
    for (let i = 0; i < 60; i++) {
      html += `<i style="left:${(rnd() * 100).toFixed(2)}%;top:${(rnd() * 100).toFixed(2)}%;--s:${(1 + rnd() * 1.5).toFixed(1)}px;animation-delay:${(rnd() * 6).toFixed(1)}s;animation-duration:${(3 + rnd() * 5).toFixed(1)}s"></i>`;
    }
    for (let i = 0; i < 10; i++) {
      html += `<b style="left:${(rnd() * 100).toFixed(2)}%;top:${(30 + rnd() * 70).toFixed(2)}%;--dx:${((rnd() - 0.5) * 220).toFixed(0)}px;--dy:${(-60 - rnd() * 140).toFixed(0)}px;animation-delay:${(rnd() * -20).toFixed(1)}s;animation-duration:${(14 + rnd() * 16).toFixed(1)}s"></b>`;
    }
    box.innerHTML = html;
  });

  // architecture demo (illustrative values)
  const arch = document.querySelector<HTMLElement>('[data-arch]');
  if (arch) {
    const m = (k: string) => arch.querySelector<HTMLElement>(`[data-m="${k}"]`)!;
    const bar = (k: string) => arch.querySelector<HTMLElement>(`[data-bar="${k}"]`)!;
    const log = arch.querySelector<HTMLElement>('[data-log]')!;
    const intents = ['refund request', 'order status', 'address change', 'invoice copy', 'plan change', 'warranty claim'];
    let reqId = 48210;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const tick = () => {
      const lat = rand(1.2, 1.7);
      const cost = rand(0.0052, 0.0071);
      const cache = rand(33, 44);
      const esc = rand(2.6, 3.6);
      m('lat').textContent = `${lat.toFixed(2)}s`;
      m('cost').textContent = `$${cost.toFixed(4)}`;
      m('cache').textContent = `${cache.toFixed(0)}%`;
      m('esc').textContent = `${esc.toFixed(1)}%`;
      bar('lat').style.setProperty('--w', `${(lat / 2) * 100}%`);
      bar('cost').style.setProperty('--w', `${(cost / 0.01) * 100}%`);
      bar('cache').style.setProperty('--w', `${cache}%`);
      bar('esc').style.setProperty('--w', `${esc * 10}%`);
      const human = Math.random() < 0.15;
      const li = document.createElement('li');
      li.innerHTML = `#${++reqId} ${intents[reqId % intents.length]} · ${lat.toFixed(1)}s · ${human ? '<b class="h">to a person</b>' : '<b>resolved</b>'}`;
      log.prepend(li);
      while (log.children.length > 6) log.lastElementChild?.remove();
    };
    for (let i = 0; i < 6; i++) tick();
    if (!reduced) {
      let t = 0;
      new IntersectionObserver(([e]) => {
        clearInterval(t);
        if (e.isIntersecting) t = window.setInterval(tick, 1400);
      }).observe(arch);
    }
  }

  // copy email
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const label = b.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      setTimeout(() => label && (label.textContent = 'Copy'), 1800);
    }),
  );

  // contact form opens the mail app with the message filled in
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const needs = d.getAll('need').join(', ') || 'Not specified';
    const body = `Name: ${d.get('name')}\nEmail: ${d.get('email')}\nAbout: ${needs}\n\n${d.get('message')}`;
    window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Project enquiry from ${d.get('name')}`)}&body=${encodeURIComponent(body)}`;
  });
</script>
