---
// Button with the kargul-style hover: a small filler word in the label ("a", "the", "our", ...) collapses away
// and an arrow slides in at the end, so "Start a project" becomes "Start project →". Labels without a filler
// word just gain the arrow. Renders an <a> when href is given, otherwise a <button>.
interface Props {
  label: string;
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm' | 'block';
  arrow?: string;
  type?: 'button' | 'submit';
  target?: string;
  rel?: string;
  class?: string;
  /** the word that collapses on hover, when it should not be the first filler word (e.g. "free") */
  drop?: string;
}
const { label, href, variant = 'primary', size = 'md', arrow = '→', type = 'button', target, rel, class: cls = '', drop } = Astro.props;
const fillers = new Set(['a', 'an', 'the', 'our', 'your', 'my', 'this']);
const words = label.split(' ');
// drop the first filler word that is not the first or last word
const dropAt = drop
  ? words.findIndex((w) => w.toLowerCase() === drop.toLowerCase())
  : words.findIndex((w, i) => i > 0 && i < words.length - 1 && fillers.has(w.toLowerCase()));
const classes = ['btn', variant === 'secondary' && 'btn-dark', size === 'sm' && 'btn-sm', size === 'block' && 'btn-block', cls];
const Tag = href ? 'a' : 'button';
---

<Tag class:list={classes} href={href} type={href ? undefined : type} target={target} rel={rel} aria-label={label}>
  <span class="lbl" aria-hidden="true">
    {words.map((w, i) => <span class:list={['w', { drop: i === dropAt }]}>{w}</span>)}
    <span class="arr">{arrow}</span>
  </span>
</Tag>
