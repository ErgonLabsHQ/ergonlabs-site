---
// "How we work" illustration for /founders: two plinths, engineering and AI research, feed one Ergon Labs block,
// which runs out along a runway to production. Square packets travel the dashed links; the pieces assemble on
// scroll like the homepage scenes.
import { P, plane, corners, box, grid, arc, line } from './iso';

const solid = (x: number, y: number, z: number, w: number, d: number, h: number) => box(x, y, z, w, d, h);
const eng = { x: -263, y: 83 };
const res = { x: -123, y: 223 };
const engB = solid(eng.x, eng.y, 0, 60, 60, 30);
const resB = solid(res.x, res.y, 0, 60, 60, 30);
const core = solid(-35, -35, 0, 70, 70, 50);
const linkA = arc([eng.x + 30, eng.y + 30, 30], [0, 0, 50], 50);
const linkB = arc([res.x + 30, res.y + 30, 30], [0, 0, 50], 30);
const run = plane(60, -20, 0, 250, 40);
let ticks = '';
for (let x = 90; x < 310; x += 30) ticks += line([[x, -20, 0], [x, 20, 0]]);
const runLine = line([[35, 0, 25], [60, 0, 0], [310, 0, 0]]);
const endB = solid(300, -18, 0, 36, 36, 36);
const lbl = (x: number, y: number, z: number, dy = 26) => {
  const [sx, sy] = P(x, y, z);
  return { x: +sx.toFixed(1), y: +(sy + dy).toFixed(1) };
};
const lEng = lbl(eng.x + 60, eng.y + 60, 0, 22);
const lRes = lbl(res.x + 60, res.y + 60, 0, 22);
const lCore = lbl(35, 35, 0, 24);
const floor = grid(320, 32);
---

<svg class="iso flow-scene" viewBox="-420 -150 760 360" aria-hidden="true" data-iso>
  <g class="iso-floor"><path d={floor}></path></g>
  <text x="-40" y="-118" class="lbl mid">FIRST CALL → PRODUCTION</text>
  <path d="M-280 -108H200M-280 -114v12M200 -114v12" class="ln"></path>

  <g class="as" style="--i:0">
    <path d={engB.right} class="r"></path><path d={engB.left} class="l"></path><path d={engB.top} class="top"></path>
    {corners(eng.x, eng.y, 30, 60, 60).map(([x, y]) => <rect class="hd" x={(x - 2.5).toFixed(1)} y={(y - 2.5).toFixed(1)} width="5" height="5" />)}
    <text x={lEng.x} y={lEng.y} class="lbl mid">ENGINEERING</text>
  </g>
  <g class="as" style="--i:1">
    <path d={resB.right} class="r"></path><path d={resB.left} class="l"></path><path d={resB.top} class="top"></path>
    {corners(res.x, res.y, 30, 60, 60).map(([x, y]) => <rect class="hd" x={(x - 2.5).toFixed(1)} y={(y - 2.5).toFixed(1)} width="5" height="5" />)}
    <text x={lRes.x} y={lRes.y} class="lbl mid">AI RESEARCH</text>
  </g>
  <g class="as" style="--i:2">
    <path d={linkA} class="flow" id="fl-a"></path>
    <path d={linkB} class="flow" id="fl-b"></path>
    <rect class="pk" x="-3.5" y="-3.5" width="7" height="7"><animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#fl-a"></mpath></animateMotion></rect>
    <rect class="pk" x="-3.5" y="-3.5" width="7" height="7"><animateMotion dur="2.6s" begin="1.3s" repeatCount="indefinite"><mpath href="#fl-b"></mpath></animateMotion></rect>
  </g>
  <g class="as" style="--i:3">
    <path d={run} class="ghost"></path>
    <path d={ticks} class="ln"></path>
    <path d={runLine} class="flow" id="fl-run"></path>
    <rect class="pk" x="-3.5" y="-3.5" width="7" height="7"><animateMotion dur="3.2s" repeatCount="indefinite"><mpath href="#fl-run"></mpath></animateMotion></rect>
    {corners(60, -20, 0, 250, 40).map(([x, y]) => <rect class="hd" x={(x - 2.5).toFixed(1)} y={(y - 2.5).toFixed(1)} width="5" height="5" />)}
  </g>
  <g class="as" style="--i:4">
    <path d={endB.right} class="r"></path><path d={endB.left} class="l"></path><path d={endB.top} class="amber"></path>
  </g>
  <g class="as" style="--i:5">
    <g class="bob" style="--b:0s">
      <path d={core.right} class="r"></path><path d={core.left} class="l"></path><path d={core.top} class="white"></path>
      {corners(-35, -35, 50, 70, 70).map(([x, y]) => <rect class="hd" x={(x - 2.5).toFixed(1)} y={(y - 2.5).toFixed(1)} width="5" height="5" />)}
    </g>
    <text x={lCore.x} y={lCore.y} class="lbl mid">ERGON LABS</text>
  </g>
</svg>

<style>
  .flow-scene {
    height: auto;
  }
  .flow-scene .lbl {
    fill: #8a8a8a;
    font: 600 11px var(--mono);
    letter-spacing: 0.12em;
  }
  .flow-scene .mid {
    text-anchor: middle;
  }
  .flow-scene .pk {
    fill: var(--amber);
    filter: drop-shadow(0 0 5px rgba(245, 165, 36, 0.8));
  }
</style>
