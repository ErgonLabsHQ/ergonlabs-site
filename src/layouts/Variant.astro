---
// Shell for the design variations under /v/. Each variation brings its own fonts and styles.
import { site } from '../site';

interface Props {
  n: number;
  fonts: string;
}
const { n, fonts } = Astro.props;
const variants = [
  { n: 1, name: 'Assemble' },
  { n: 2, name: 'Terrain' },
  { n: 3, name: 'Gallery' },
  { n: 4, name: 'Stack' },
  { n: 5, name: 'Flight' },
  { n: 6, name: 'Observatory' },
  { n: 7, name: 'Garden' },
  { n: 8, name: 'Print shop' },
  { n: 9, name: 'Deep sea' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} · variation {n}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="stylesheet" />
  </head>
  <body class={`v${n}`}>
    <slot />
    <nav class="switch" aria-label="Design variations">
      <span>Variation</span>
      {variants.map((v) => (
        <a href={`/v/${v.n}`} class:list={{ on: v.n === n }}>
          {v.n} {v.name}
        </a>
      ))}
      <a href="/">Current</a>
    </nav>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  h1,
  h2,
  h3,
  p {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .switch {
    position: fixed;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 5px;
    border-radius: 999px;
    background: rgba(20, 20, 22, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    font: 500 13px/1 system-ui, sans-serif;
    white-space: nowrap;
    max-width: calc(100vw - 16px);
    overflow-x: auto;
  }
  .switch span {
    padding: 0 8px 0 10px;
    opacity: 0.6;
  }
  .switch a {
    padding: 8px 11px;
    border-radius: 999px;
  }
  .switch a:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .switch a.on {
    background: #fff;
    color: #111;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
